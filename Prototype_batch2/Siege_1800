local function draw_end(win)
  cls(0)
  rect(0, 0, 240, 136, win and 10 or 1)
  for i = 1, 30 do
    rect((i * 41) % 240, (i * 27) % 136, 2, 2, win and 15 or 4)
  end
  center_text(win and "THE FORT STANDS" or "THE LINE BREAKS", 34, win and 15 or 7, 2)
  center_text(GAME.reason, 58, win and 10 or 15, 1)
  center_text("WAVES HELD: " .. GAME.wave, 72, 15, 1)
  center_text("PRESS Z TO BEGIN AGAIN", 96, 10, 1)
end

function reset_game()
  math.randomseed(1800)
  GAME.state = CFG.start_title and "title" or "play"
  GAME.phase = "day"
  GAME.wave = 0
  GAME.cursor = 1
  GAME.build = 1
  GAME.msg = ""
  GAME.msg_t = 0
  GAME.reason = ""
  GAME.shake = 0
  GAME.t = 0
  GAME.reticle_x = 180
  GAME.reticle_y = 68
  GAME.field_cd = 0
  GAME.rally_cd = 0
  WORLD.wall = CFG.wall_max
  WORLD.morale = CFG.morale_max
  WORLD.wood = 20
  WORLD.powder = 20
  WORLD.men = 12
  WORLD.food = 15
  WORLD.slots = {
    { kind = 0, cool = 0 },
    { kind = 0, cool = 0 },
    { kind = 0, cool = 0 },
  }
  WORLD.enemies = {}
  WORLD.projectiles = {}
  WORLD.tracers = {}
  WORLD.fx = {}
  msg("BUILD YOUR DEFENSES")
end

function TIC()
  GAME.t = GAME.t + 1
  if GAME.msg_t > 0 then GAME.msg_t = GAME.msg_t - 1 end
  if GAME.state == "title" then
    if btnp(INPUT.fire) or btnp(INPUT.start) then
      reset_game()
      GAME.state = "play"
    end
    draw_title()
  elseif GAME.state == "play" then
    if GAME.phase == "day" then update_day() else update_battle() end
    draw_game()
  elseif GAME.state == "lose" or GAME.state == "win" then
    if btnp(INPUT.fire) then
      reset_game()
      GAME.state = "play"
    end
    draw_end(GAME.state == "win")
  end
end

reset_game()
