    rect(0, 118, 240, 18, 0)
    line(0, 118, 239, 118, 5)
    print(GAME.msg, 4, 124, 7)
  end
end

local function draw_game()
  cls(0)
  if GAME.phase == "day" then draw_day() else draw_battle() end
  draw_hud()
end

