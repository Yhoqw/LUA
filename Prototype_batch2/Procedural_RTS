function reset_game()
  math.randomseed(9001)
  GAME.state = CFG.start_title and "title" or "play"
  GAME.t = 0
  GAME.msg = ""
  GAME.msg_t = 0
  GAME.reason = ""
  GAME.cursor_x, GAME.cursor_y = 15, 7
  GAME.sel_kind, GAME.sel_i = nil, nil
  GAME.build_choice, GAME.train_choice = nil, 1
  WORLD.gold = CFG.gold_start
  WORLD.ai_gold = CFG.gold_start
  WORLD.units = {}
  WORLD.buildings = {}
  WORLD.projectiles = {}
  WORLD.seen = {}
  for y = 1, CFG.map_h do
    WORLD.seen[y] = {}
    for x = 1, CFG.map_w do WORLD.seen[y][x] = false end
  end
  gen_map()
  add_building("base", "player", 3, 7)
  add_building("base", "enemy", 27, 7)
  add_building("barracks", "enemy", 25, 8)
  add_building("tower", "enemy", 25, 6)
  add_unit("worker", "player", 4, 7)
  add_unit("worker", "player", 5, 7)
  add_unit("soldier", "player", 4, 8)
  add_unit("soldier", "player", 5, 8)
  add_unit("worker", "enemy", 26, 7)
  add_unit("worker", "enemy", 25, 7)
  add_unit("soldier", "enemy", 26, 8)
  add_unit("soldier", "enemy", 25, 8)
  update_vision()
  msg("SELECT A UNIT WITH Z")
end

function TIC()
  GAME.t = GAME.t + 1
  if GAME.msg_t > 0 then GAME.msg_t = GAME.msg_t - 1 end
  if GAME.state == "title" then
    if btnp(INPUT.select) or btnp(INPUT.act) then
      reset_game()
      GAME.state = "play"
    end
    draw_title()
  elseif GAME.state == "play" then
    update_play()
    draw_game()
  elseif GAME.state == "win" or GAME.state == "lose" then
    if btnp(INPUT.select) then
      reset_game()
      GAME.state = "play"
    end
    draw_end(GAME.state == "win")
  end
end

reset_game()
