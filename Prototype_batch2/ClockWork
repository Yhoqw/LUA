local function atan2(y, x)
  if x > 0 then return math.atan(y / x) end
  if x < 0 then return math.atan(y / x) + (y >= 0 and math.pi or -math.pi) end
  return y >= 0 and math.pi / 2 or -math.pi / 2
end

local function clamp(v, a, b)
  if v < a then return a end
  if v > b then return b end
  return v
end

local function text_w(s, scale)
  return #s * 6 * (scale or 1)
end

local function center_text(s, y, col, scale)
  print(s, math.floor((CFG.sw - text_w(s, scale)) / 2), y, col, scale)
end

local function msg(s)
  GAME.msg = s
  GAME.msg_t = 120
end

local function solid(tx, ty)
  if tx < 0 or ty < 0 or tx >= 30 or ty >= 17 then return true end
  return string.sub(WORLD.map[ty + 1], tx + 1, tx + 1) == "#"
end

local function move_body(b, dx, dy)
  b.x = b.x + dx
  if dx ~= 0 then
    local tx = dx > 0 and math.floor((b.x + b.w - 1) / CFG.ts) or math.floor(b.x / CFG.ts)
    if solid(tx, math.floor(b.y / CFG.ts)) or solid(tx, math.floor((b.y + b.h - 1) / CFG.ts)) then
      b.x = b.x - dx
    end
  end
  b.y = b.y + dy
  if dy ~= 0 then
    local ty = dy > 0 and math.floor((b.y + b.h - 1) / CFG.ts) or math.floor(b.y / CFG.ts)
    if solid(math.floor(b.x / CFG.ts), ty) or solid(math.floor((b.x + b.w - 1) / CFG.ts), ty) then
      b.y = b.y - dy
    end
  end
end

local function dist2(ax, ay, bx, by)
  local dx, dy = ax - bx, ay - by
  return dx * dx + dy * dy
end

local function spawn_fx(x, y, col, n)
  for i = 1, (n or 4) do
    WORLD.fx[#WORLD.fx + 1] = {
      x = x, y = y,
      vx = (math.random() - 0.5) * 2.0,
      vy = (math.random() - 0.5) * 2.0,
      life = 14 + math.random(12),
      col = col,
    }
  end
end

local function update_fx()
  for i = #WORLD.fx, 1, -1 do
    local f = WORLD.fx[i]
    f.x = f.x + f.vx
    f.y = f.y + f.vy
    f.vx = f.vx * 0.96
    f.vy = f.vy * 0.96
    f.life = f.life - 1
    if f.life <= 0 then table.remove(WORLD.fx, i) end
  end
end

local function draw_fx()
  for i = 1, #WORLD.fx do
    local f = WORLD.fx[i]
    rect(math.floor(f.x), math.floor(f.y), 1, 1, f.col)
  end
end

local function add_enemy(kind, x, y)
  local d = ENEMY_TYPES[kind]
  WORLD.enemies[#WORLD.enemies + 1] = {
    kind = kind, x = x, y = y, w = 8, h = 8,
    hp = d.hp, max_hp = d.hp, speed = d.speed,
    col = d.col, contact = d.contact, shot_cd = d.shot_cd or 999,
    cool = 0, hurt = 0, vx = 0, vy = 0,
  }
end

local function load_room(n)
  WORLD.room = n
  WORLD.map = ROOMS[n].map
  WORLD.enemies = {}
  WORLD.items = {}
  WORLD.projectiles = {}
  WORLD.fx = {}
  for y = 1, 17 do
    local row = WORLD.map[y]
    for x = 1, 30 do
      local ch = string.sub(row, x, x)
      local px, py = (x - 1) * CFG.ts, (y - 1) * CFG.ts
      if ch == "P" then
        WORLD.player.x = px + 1
        WORLD.player.y = py + 1
      elseif ch == "N" then
        WORLD.items[#WORLD.items + 1] = { kind = "npc", x = px, y = py }
      elseif ch == "S" then
        WORLD.items[#WORLD.items + 1] = { kind = "spring", x = px, y = py }
      elseif ch == "D" then
        WORLD.items[#WORLD.items + 1] = { kind = "door", x = px, y = py }
      elseif ch == "E" then
        add_enemy("drone", px, py)
      elseif ch == "H" then
        add_enemy("hound", px, py)
      elseif ch == "G" then
        add_enemy("golem", px, py)
      elseif ch == "B" then
        add_enemy("boss", px, py)
      end
    end
  end
  GAME.room_name = ROOMS[n].name
end

local function player_center()
  return WORLD.player.x + 4, WORLD.player.y + 4
end

local function damage_player(n)
  local p = WORLD.player
  if p.inv > 0 then return end
  p.hp = p.hp - n
  p.inv = CFG.invuln
  GAME.shake = 8
  spawn_fx(p.x + 4, p.y + 4, 2, 6)
  if p.hp <= 0 then
    p.hp = 0
    GAME.state = "dead"
    GAME.reason = "THE GEARS STOP"
  end
end

local function hurt_enemy(e, n, fx, fy)
  e.hp = e.hp - n
  e.hurt = 8
  spawn_fx(e.x + 4, e.y + 4, 4, 5)
  if e.hp <= 0 then
    spawn_fx(e.x + 4, e.y + 4, e.col, 10)
    if e.kind == "boss" then
      GAME.state = "win"
      GAME.reason = "THE CLOCK TOWER TURNS AGAIN"
    end
    return true
  end
  return false
end

local function fire_gear()
  local p = WORLD.player
  local gear = GEARS[GAME.gear]
  if p.cool > 0 or p.stun > 0 then return end
  if WORLD.pressure < gear.pressure then
    msg("NOT ENOUGH PRESSURE")
    return
  end
  WORLD.pressure = WORLD.pressure - gear.pressure
  WORLD.heat = clamp(WORLD.heat + gear.heat, 0, CFG.heat_max)
  p.cool = gear.rate
  local cx, cy = player_center()
  if gear.kind == "shot" then
    local speed = 3.2
    WORLD.projectiles[#WORLD.projectiles + 1] = {
      x = cx, y = cy, vx = p.fx * speed, vy = p.fy * speed,
      life = 80, damage = gear.damage, friendly = true, col = gear.col,
    }
    spawn_fx(cx, cy, gear.col, 3)
  else
    for i = #WORLD.enemies, 1, -1 do
      local e = WORLD.enemies[i]
      local dx, dy = e.x + 4 - cx, e.y + 4 - cy
      local d2 = dx * dx + dy * dy
      local dot = dx * p.fx + dy * p.fy
      if d2 <= gear.range * gear.range and dot >= 0 then
        if hurt_enemy(e, gear.damage, cx, cy) then table.remove(WORLD.enemies, i) end
      end
    end
    WORLD.slash = { x = cx, y = cy, fx = p.fx, fy = p.fy, life = 8, col = gear.col, range = gear.range }
    spawn_fx(cx + p.fx * 8, cy + p.fy * 8, gear.col, 4)
  end
end

local function vent_heat()
  if WORLD.heat <= 0 then
    msg("NOTHING TO VENT")
    return
  end
  WORLD.heat = math.max(0, WORLD.heat - CFG.vent_heat)
  WORLD.pressure = math.max(0, WORLD.pressure - CFG.vent_cost)
  local cx, cy = player_center()
  spawn_fx(cx, cy - 4, 7, 8)
  msg("STEAM VENTED")
end

local function interact()
  local cx, cy = player_center()
  local best, bd = nil, 24 * 24
  for i = 1, #WORLD.items do
    local it = WORLD.items[i]
    local d = dist2(cx, cy, it.x + 4, it.y + 4)
    if d < bd then best, bd = i, d end
  end
  if best then
    local it = WORLD.items[best]
    if it.kind == "npc" then
      if GAME.quest == 0 then
        GAME.quest = 1
        msg("FIND THE MAINSPRING IN THE GEARWORKS")
      elseif GAME.has_spring then
        msg("THE TOWER IS ABOVE THE GEARWORKS")
      else
        msg("THE MAINSPRING IS BELOW THE CITY")
      end
      return
    elseif it.kind == "spring" then
      GAME.has_spring = true
      table.remove(WORLD.items, best)
      msg("MAINSPRING FOUND. THE TOWER AWAITS")
      return
    elseif it.kind == "door" then
      if WORLD.room == 1 and GAME.quest >= 1 then
        load_room(2)
        msg("THE GEARWORKS")
      elseif WORLD.room == 2 and GAME.has_spring then
        load_room(3)
        msg("THE CLOCK TOWER")
      elseif WORLD.room == 2 then
        msg("THE DOOR NEEDS THE MAINSPRING")
      end
      return
    end
  end
  vent_heat()
end

local function update_player()
  local p = WORLD.player
  local dx, dy = 0, 0
  if btn(INPUT.left) then dx = -CFG.player_speed end
  if btn(INPUT.right) then dx = CFG.player_speed end
  if btn(INPUT.up) then dy = -CFG.player_speed end
  if btn(INPUT.down) then dy = CFG.player_speed end
  if dx ~= 0 or dy ~= 0 then
    local len = math.sqrt(dx * dx + dy * dy)
    dx, dy = dx / len, dy / len
    p.fx, p.fy = dx, dy
  end
  move_body(p, dx * CFG.player_speed, dy * CFG.player_speed)
  p.cool = math.max(0, p.cool - 1)
  p.inv = math.max(0, p.inv - 1)
  p.stun = math.max(0, p.stun - 1)
  WORLD.pressure = clamp(WORLD.pressure + CFG.pressure_regen, 0, CFG.pressure_max)
  WORLD.heat = clamp(WORLD.heat - CFG.heat_cool, 0, CFG.heat_max)
  if btnp(INPUT.attack) then fire_gear() end
  if btnp(INPUT.interact) then interact() end
  if btnp(INPUT.gear) then
    GAME.gear = (GAME.gear % #GEARS) + 1
    msg(GEARS[GAME.gear].name)
  end
  if WORLD.heat >= CFG.heat_max and p.stun <= 0 then
    p.stun = CFG.overheat_stun
    WORLD.pressure = 0
    WORLD.heat = 50
    msg("OVERHEAT. VENT WITH X")
    spawn_fx(p.x + 4, p.y + 4, 2, 12)
  end
end

local function update_enemies()
  local p = WORLD.player
  local cx, cy = player_center()
  for i = #WORLD.enemies, 1, -1 do
    local e = WORLD.enemies[i]
    e.cool = math.max(0, e.cool - 1)
    e.hurt = math.max(0, e.hurt - 1)
    local dx, dy = cx - (e.x + 4), cy - (e.y + 4)
    local d = math.sqrt(dx * dx + dy * dy)
    if e.kind == "drone" then
      if d < ENEMY_TYPES.drone.range and d > 1 then
        move_body(e, dx / d * e.speed, dy / d * e.speed)
      end
    elseif e.kind == "hound" then
      if d < ENEMY_TYPES.hound.range and d > 1 then
        if math.abs(dx) > math.abs(dy) then
          move_body(e, (dx > 0 and 1 or -1) * e.speed, 0)
        else
          move_body(e, 0, (dy > 0 and 1 or -1) * e.speed)
        end
      end
    elseif e.kind == "golem" then
      if d < ENEMY_TYPES.golem.range and e.cool <= 0 then
        e.cool = ENEMY_TYPES.golem.shot_cd
        local sx, sy = e.x + 4, e.y + 4
        local vx, vy = cx - sx, cy - sy
        local l = math.max(1, math.sqrt(vx * vx + vy * vy))
        WORLD.projectiles[#WORLD.projectiles + 1] = {
          x = sx, y = sy, vx = vx / l * 1.7, vy = vy / l * 1.7,
          life = 120, damage = 1, friendly = false, col = 10,
        }
      end
    elseif e.kind == "boss" then
      if e.cool <= 0 then
        e.cool = ENEMY_TYPES.boss.shot_cd
        for k = -1, 1 do
          local a = atan2(cy - (e.y + 4), cx - (e.x + 4)) + k * 0.35
          WORLD.projectiles[#WORLD.projectiles + 1] = {
            x = e.x + 4, y = e.y + 4,
            vx = math.cos(a) * 1.8, vy = math.sin(a) * 1.8,
            life = 140, damage = 1, friendly = false, col = 4,
          }
        end
      end
    end
    if p.inv <= 0 and math.abs(p.x - e.x) < 8 and math.abs(p.y - e.y) < 8 then
      damage_player(e.contact)
    end
  end
end

local function update_projectiles()
  local p = WORLD.player
  for i = #WORLD.projectiles, 1, -1 do
    local b = WORLD.projectiles[i]
    b.x = b.x + b.vx
    b.y = b.y + b.vy
    b.life = b.life - 1
    local hit = false
    if solid(math.floor(b.x / CFG.ts), math.floor(b.y / CFG.ts)) then hit = true end
    if not hit and b.friendly then
      for j = #WORLD.enemies, 1, -1 do
        local e = WORLD.enemies[j]
        if math.abs(b.x - (e.x + 4)) < 6 and math.abs(b.y - (e.y + 4)) < 6 then
          if hurt_enemy(e, b.damage, b.x, b.y) then table.remove(WORLD.enemies, j) end
          hit = true
          break
        end
      end
    elseif not hit then
      if p.inv <= 0 and math.abs(b.x - (p.x + 4)) < 6 and math.abs(b.y - (p.y + 4)) < 6 then
        damage_player(b.damage)
        hit = true
      end
    end
    if hit or b.life <= 0 then table.remove(WORLD.projectiles, i) end
  end
end

local function draw_map()
  for y = 0, 16 do
    for x = 0, 29 do
      local px, py = x * CFG.ts, y * CFG.ts
      local ch = string.sub(WORLD.map[y + 1], x + 1, x + 1)
      if ch == "#" then
        rect(px, py, 8, 8, 10)
        rect(px + 1, py + 1, 6, 6, 15)
        rect(px + 2, py + 2, 4, 4, 10)
        if (x + y) % 3 == 0 then rect(px + 3, py + 3, 1, 1, 4) end
      else
        rect(px, py, 8, 8, (x + y) % 2 == 0 and 8 or 1)
        if (x * 7 + y * 13) % 11 == 0 then rect(px + 2, py + 2, 2, 2, 15) end
      end
    end
  end
end

local function draw_items()
  for i = 1, #WORLD.items do
    local it = WORLD.items[i]
    if it.kind == "npc" then
      circ(it.x + 4, it.y + 4, 4, 9)
      rect(it.x + 2, it.y + 6, 5, 2, 10)
      rect(it.x + 3, it.y + 1, 3, 2, 15)
      rectb(it.x, it.y, 8, 8, 4)
    elseif it.kind == "spring" then
      circb(it.x + 4, it.y + 4, 3, 4)
      circ(it.x + 4, it.y + 4, 1, 4)
      line(it.x + 4, it.y + 1, it.x + 4, it.y + 7, 10)
    elseif it.kind == "door" then
      rect(it.x, it.y, 8, 8, 4)
      rectb(it.x, it.y, 8, 8, 15)
      rect(it.x + 3, it.y + 3, 2, 2, 10)
    end
  end
end

local function draw_enemies()
  for i = 1, #WORLD.enemies do
    local e = WORLD.enemies[i]
    local col = e.hurt > 0 and 7 or e.col
    if e.kind == "drone" then
      circ(e.x + 4, e.y + 4, 4, col)
      circ(e.x + 4, e.y + 4, 2, 15)
      line(e.x + 1, e.y + 1, e.x + 7, e.y + 7, 10)
    elseif e.kind == "hound" then
      rect(e.x + 1, e.y + 2, 6, 5, col)
      rect(e.x + 6, e.y, 2, 2, 4)
      rect(e.x, e.y + 6, 8, 1, 10)
    elseif e.kind == "golem" then
      rect(e.x, e.y, 8, 8, col)
      rectb(e.x, e.y, 8, 8, 15)
      rect(e.x + 2, e.y + 2, 2, 2, 4)
      rect(e.x + 5, e.y + 2, 2, 2, 4)
    else
      rect(e.x, e.y, 8, 8, col)
      rectb(e.x, e.y, 8, 8, 15)
      circ(e.x + 4, e.y + 4, 3, 4)
      line(e.x - 2, e.y + 4, e.x + 10, e.y + 4, 4)
    end
    if e.hp < e.max_hp then
      rect(e.x, e.y - 3, 8, 1, 0)
      rect(e.x, e.y - 3, math.floor(8 * e.hp / e.max_hp), 1, 2)
    end
  end
end

local function draw_player()
  local p = WORLD.player
  if p.inv > 0 and GAME.t % 6 < 3 then return end
  circ(p.x + 4, p.y + 4, 4, 12)
  rect(p.x + 2, p.y + 6, 5, 2, 10)
  rect(p.x + 3, p.y + 1, 3, 2, 4)
  rectb(p.x, p.y, 8, 8, 15)
  line(p.x + 4, p.y + 4, p.x + 4 + p.fx * 7, p.y + 4 + p.fy * 7, 4)
end

local function draw_slash()
  if not WORLD.slash then return end
  local s = WORLD.slash
  if s.life <= 0 then WORLD.slash = nil; return end
  local a = atan2(s.fy, s.fx)
  for k = -2, 2 do
    local ang = a + k * 0.22
    line(s.x, s.y, s.x + math.cos(ang) * s.range, s.y + math.sin(ang) * s.range, s.col)
  end
  s.life = s.life - 1
end

local function draw_projectiles()
  for i = 1, #WORLD.projectiles do
    local b = WORLD.projectiles[i]
    rect(math.floor(b.x), math.floor(b.y), 2, 2, b.col)
  end
end

