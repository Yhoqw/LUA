end

function reset_game()
  math.randomseed(1887)
  GAME.state = CFG.start_title and "title" or "play"
  GAME.t = 0
  GAME.gear = 1
  GAME.quest = 0
  GAME.has_spring = false
  GAME.msg = ""
  GAME.msg_t = 0
  GAME.reason = ""
  GAME.shake = 0
  WORLD.player = { x = 24, y = 24, w = 8, h = 8, hp = CFG.player_hp, inv = 0, cool = 0, stun = 0, fx = 1, fy = 0 }
  WORLD.pressure = CFG.pressure_max
  WORLD.heat = 0
  WORLD.slash = nil
  load_room(1)
  msg("TALK TO THE ENGINEER")
end

local function update_title()
  if btnp(INPUT.attack) or btnp(INPUT.interact) then
    reset_game()
    GAME.state = "play"
  end
end

local function update_play()
  update_player()
  update_enemies()
  update_projectiles()
  update_fx()
  if GAME.msg_t > 0 then GAME.msg_t = GAME.msg_t - 1 end
end

function TIC()
  GAME.t = GAME.t + 1
  if GAME.state == "title" then
    update_title()
    draw_title()
  elseif GAME.state == "play" then
    update_play()
    draw_game()
  elseif GAME.state == "dead" then
    if btnp(INPUT.attack) then reset_game(); GAME.state = "play" end
    draw_end(false)
  elseif GAME.state == "win" then
    if btnp(INPUT.attack) then reset_game(); GAME.state = "play" end
    draw_end(true)
  end
end

reset_game()
