GAME = {}
WORLD = {}

local function atan2(y, x)
  if x > 0 then return math.atan(y / x) end
  if x < 0 then return math.atan(y / x) + (y >= 0 and math.pi or -math.pi) end
  return y >= 0 and math.pi / 2 or -math.pi / 2
end

local function clamp(v, a, b)
  if v < a then return a end
  if v > b then return b end
  return v
end

local function ang_diff(a, b)
  local d = a - b
  while d > math.pi do d = d - math.pi * 2 end
  while d < -math.pi do d = d + math.pi * 2 end
  return math.abs(d)
end

local function center_text(s, y, col, scale)
  print(s, math.floor((CFG.sw - #s * 6 * (scale or 1)) / 2), y, col, scale)
end

local function msg(s)
  GAME.msg = s
  GAME.msg_t = 140
end

local function solid(tx, ty)
  if tx < 0 or ty < 0 or tx >= 30 or ty >= 17 then return true end
  local ch = string.sub(WORLD.map[ty + 1], tx + 1, tx + 1)
  return ch == "#" or ch == "%" or ch == "D"
end

local function set_tile(tx, ty, ch)
  local row = WORLD.map[ty + 1]
  WORLD.map[ty + 1] = string.sub(row, 1, tx) .. ch .. string.sub(row, tx + 2)
end

local function move_body(b, dx, dy)
  b.x = b.x + dx
  if dx ~= 0 then
    local tx = dx > 0 and math.floor((b.x + b.w - 1) / CFG.ts) or math.floor(b.x / CFG.ts)
    if solid(tx, math.floor(b.y / CFG.ts)) or solid(tx, math.floor((b.y + b.h - 1) / CFG.ts)) then
      b.x = b.x - dx
    end
  end
  b.y = b.y + dy
  if dy ~= 0 then
    local ty = dy > 0 and math.floor((b.y + b.h - 1) / CFG.ts) or math.floor(b.y / CFG.ts)
    if solid(math.floor(b.x / CFG.ts), ty) or solid(math.floor((b.x + b.w - 1) / CFG.ts), ty) then
      b.y = b.y - dy
    end
  end
end

local function los_clear(x1, y1, x2, y2, allow_end)
  local dx, dy = x2 - x1, y2 - y1
  local d = math.sqrt(dx * dx + dy * dy)
  if d < 1 then return true end
  local steps = math.max(1, math.floor(d / 4))
  for i = 1, steps do
    if not (allow_end and i == steps) then
      local t = i / steps
      if solid(math.floor((x1 + dx * t) / CFG.ts), math.floor((y1 + dy * t) / CFG.ts)) then
        return false
      end
    end
  end
  return true
end

local function add_noise(x, y, r)
  WORLD.noises[#WORLD.noises + 1] = { x = x, y = y, r = r, life = 50 }
end

local function spawn_fx(x, y, col, n)
  for i = 1, (n or 4) do
    WORLD.fx[#WORLD.fx + 1] = {
      x = x, y = y,
      vx = (math.random() - 0.5) * 1.8,
      vy = (math.random() - 0.5) * 1.8,
      life = 12 + math.random(12), col = col,
    }
  end
end

local function update_fx()
  for i = #WORLD.fx, 1, -1 do
    local f = WORLD.fx[i]
    f.x = f.x + f.vx
    f.y = f.y + f.vy
    f.vx = f.vx * 0.95
    f.vy = f.vy * 0.95
    f.life = f.life - 1
    if f.life <= 0 then table.remove(WORLD.fx, i) end
  end
end

local function draw_fx()
  for i = 1, #WORLD.fx do
    local f = WORLD.fx[i]
    rect(math.floor(f.x), math.floor(f.y), 1, 1, f.col)
  end
end

local function load_facility()
  WORLD.map = {}
  for i = 1, 17 do WORLD.map[i] = FACILITY[i] end
  WORLD.player = { x = 24, y = 24, w = 8, h = 8, hp = CFG.player_hp, inv = 0, fx = 1, fy = 0 }
  WORLD.items = {}
  WORLD.cameras = {}
  WORLD.alien = nil
  WORLD.patrol = {
    { x = 120, y = 64 }, { x = 120, y = 112 },
    { x = 200, y = 112 }, { x = 200, y = 64 }, { x = 160, y = 64 },
  }
  WORLD.noises = {}
  WORLD.fx = {}
  for y = 1, 17 do
    local row = WORLD.map[y]
    for x = 1, 30 do
      local ch = string.sub(row, x, x)
      local px, py = (x - 1) * CFG.ts, (y - 1) * CFG.ts
      if ch == "P" then
        WORLD.player.x, WORLD.player.y = px + 1, py + 1
      elseif ch == "C" then
        WORLD.cameras[#WORLD.cameras + 1] = {
          x = px + 4, y = py + 4, angle = math.pi, base = math.pi,
          disabled = false, sweep = math.random() * 6,
        }
      elseif ch == "T" then
        WORLD.items[#WORLD.items + 1] = { kind = "data", x = px + 4, y = py + 4, done = false }
      elseif ch == "O" then
        WORLD.items[#WORLD.items + 1] = { kind = "power", x = px + 4, y = py + 4, done = false }
      elseif ch == "X" then
        WORLD.items[#WORLD.items + 1] = { kind = "exit", x = px + 4, y = py + 4, done = false }
      elseif ch == "A" then
        WORLD.alien = {
          x = px + 1, y = py + 1, w = 8, h = 8,
          angle = 0, state = "patrol", wp = 1,
          last = { x = px, y = py }, timer = 0, lost = 0,
          speed = 0.72, hurt = 0,
        }
      end
    end
  end
  GAME.has_data = false
  GAME.power_off = false
  GAME.alarm = 0
  GAME.alert_t = 0
  GAME.cut_cd = 0
  GAME.hack_cd = 0
  GAME.decoy_cd = 0
end

local function player_center()
  return WORLD.player.x + 4, WORLD.player.y + 4
end

local function is_lit(tx, ty)
  local px, py = player_center()
  local x, y = tx * CFG.ts + 4, ty * CFG.ts + 4
  local dx, dy = x - px, y - py
  local d = math.sqrt(dx * dx + dy * dy)
  if d < CFG.ambient_r then return true end
  if d > CFG.light_r then return false end
  local a = atan2(dy, dx)
  local facing = atan2(WORLD.player.fy, WORLD.player.fx)
  if ang_diff(a, facing) > CFG.cone then return false end
  return los_clear(px, py, x, y, true)
end

local function alien_sees_player()
  local a = WORLD.alien
  if not a then return false end
  local px, py = player_center()
  local ax, ay = a.x + 4, a.y + 4
  local dx, dy = px - ax, py - ay
  local d = math.sqrt(dx * dx + dy * dy)
  if d > 92 then return false end
  if d > 20 and ang_diff(atan2(dy, dx), a.angle) > 0.78 then return false end
  return los_clear(ax, ay, px, py, false)
end

local function damage_player(n)
  local p = WORLD.player
  if p.inv > 0 then return end
  p.hp = p.hp - n
  p.inv = 60
  GAME.shake = 8
  spawn_fx(p.x + 4, p.y + 4, 2, 7)
  if p.hp <= 0 then
    p.hp = 0
    GAME.state = "lose"
    GAME.reason = "THE FACILITY KEEPS ITS SECRET"
  end
end

local function cut_wall()
  if GAME.cut_cd > 0 then return end
  local p = WORLD.player
  local cx, cy = player_center()
  for oy = -1, 1 do
    for ox = -1, 1 do
      local tx = math.floor((cx + p.fx * 9) / CFG.ts) + ox
      local ty = math.floor((cy + p.fy * 9) / CFG.ts) + oy
      if tx >= 0 and ty >= 0 and tx < 30 and ty < 17 then
        if string.sub(WORLD.map[ty + 1], tx + 1, tx + 1) == "%" then
          set_tile(tx, ty, ".")
          GAME.cut_cd = 24
          add_noise(tx * 8 + 4, ty * 8 + 4, 95)
          spawn_fx(tx * 8 + 4, ty * 8 + 4, 10, 12)
          msg("BULKHEAD CUT")
          return
        end
      end
    end
  end
  msg("NO CUTTABLE BULKHEAD")
end

local function hack_target()
  if GAME.hack_cd > 0 then return end
  local cx, cy = player_center()
  local best, bd, bkind = nil, 22 * 22, nil
  for i = 1, #WORLD.items do
    local it = WORLD.items[i]
    local d = (it.x - cx) ^ 2 + (it.y - cy) ^ 2
    if d < bd then best, bd, bkind = i, d, "item" end
  end
  for i = 1, #WORLD.cameras do
    local c = WORLD.cameras[i]
    local d = (c.x - cx) ^ 2 + (c.y - cy) ^ 2
    if d < bd then best, bd, bkind = i, d, "camera" end
  end
  local ptx = math.floor(cx / CFG.ts)
  local pty = math.floor(cy / CFG.ts)
  local door = nil
  for oy = -1, 1 do
    for ox = -1, 1 do
      local tx, ty = ptx + ox, pty + oy
      if tx >= 0 and ty >= 0 and tx < 30 and ty < 17 then
        if string.sub(WORLD.map[ty + 1], tx + 1, tx + 1) == "D" then door = { tx = tx, ty = ty } end
      end
    end
  end
  if door then
    set_tile(door.tx, door.ty, ".")
    GAME.hack_cd = 28
    add_noise(door.tx * 8 + 4, door.ty * 8 + 4, 40)
    msg("DOOR OPENED")
    return
  end
  if bkind == "camera" then
    local c = WORLD.cameras[best]
    if c.disabled then msg("CAMERA ALREADY DEAD") return end
    c.disabled = true
    GAME.hack_cd = 28
    add_noise(c.x, c.y, 35)
    msg("CAMERA DISABLED")
    return
  elseif bkind == "item" then
    local it = WORLD.items[best]
    if it.kind == "data" then
      if it.done then msg("DATA ALREADY STOLEN") return end
      it.done = true
      GAME.has_data = true
      GAME.hack_cd = 30
      add_noise(it.x, it.y, 60)
      msg("DATA STOLEN. REACH THE EXIT.")
      return
    elseif it.kind == "power" then
      if it.done then msg("POWER ALREADY DOWN") return end
      it.done = true
      GAME.power_off = true
      for i = 1, #WORLD.cameras do WORLD.cameras[i].disabled = true end
      GAME.hack_cd = 30
      add_noise(it.x, it.y, 55)
      msg("POWER CUT. CAMERAS OFFLINE.")
      return
    elseif it.kind == "exit" then
      if GAME.has_data then
        GAME.state = "win"
        GAME.reason = "THE BEACON IS YOURS"
      else
        msg("THE EXIT NEEDS THE DATA CORE")
      end
      return
    end
  end
  msg("NOTHING TO HACK")
end

local function throw_decoy()
  if GAME.decoy_cd > 0 then return end
  local p = WORLD.player
  local x = p.x + 4 + p.fx * 30
  local y = p.y + 4 + p.fy * 30
  add_noise(x, y, 145)
  GAME.decoy_cd = 130
  spawn_fx(x, y, 14, 10)
  msg("DECOY THROWN")
end

local function update_player()
  local p = WORLD.player
  local dx, dy = 0, 0
  if btn(INPUT.left) then dx = -1 end
  if btn(INPUT.right) then dx = 1 end
  if btn(INPUT.up) then dy = -1 end
  if btn(INPUT.down) then dy = 1 end
  if dx ~= 0 or dy ~= 0 then
    local l = math.sqrt(dx * dx + dy * dy)
    dx, dy = dx / l, dy / l
    p.fx, p.fy = dx, dy
    move_body(p, dx * CFG.player_speed, dy * CFG.player_speed)
  end
  p.inv = math.max(0, p.inv - 1)
  GAME.cut_cd = math.max(0, GAME.cut_cd - 1)
  GAME.hack_cd = math.max(0, GAME.hack_cd - 1)
  GAME.decoy_cd = math.max(0, GAME.decoy_cd - 1)
  if btnp(INPUT.cut) then cut_wall() end
  if btnp(INPUT.hack) then hack_target() end
  if btnp(INPUT.decoy) then throw_decoy() end
end

local function move_alien(a, tx, ty, speed)
  local ax, ay = a.x + 4, a.y + 4
  local dx, dy = tx - ax, ty - ay
  local d = math.sqrt(dx * dx + dy * dy)
  if d < 1 then return true end
  a.angle = atan2(dy, dx)
  move_body(a, dx / d * speed, dy / d * speed)
  return d < 6
end

local function update_alien()
  local a = WORLD.alien
  if not a then return end
  local px, py = player_center()
  local ax, ay = a.x + 4, a.y + 4
  local see = alien_sees_player()
  local dplayer = math.sqrt((px - ax) ^ 2 + (py - ay) ^ 2)
  if see then
    a.state = "chase"
    a.last.x, a.last.y = px, py
    a.lost = 0
  end
  for i = 1, #WORLD.noises do
    local n = WORLD.noises[i]
    local d = math.sqrt((n.x - ax) ^ 2 + (n.y - ay) ^ 2)
    if d < n.r and a.state ~= "chase" then
      a.state = "investigate"
      a.last.x, a.last.y = n.x, n.y
      a.timer = 130
    end
  end
  if GAME.alert_t > 0 then
    GAME.alert_t = GAME.alert_t - 1
    a.state = "chase"
    a.last.x, a.last.y = px, py
  end
  if a.state == "chase" then
    if not see and GAME.alert_t <= 0 then
      a.lost = a.lost + 1
      if a.lost > 120 then a.state = "search"; a.timer = 150 end
    end
    move_alien(a, see and px or a.last.x, see and py or a.last.y, 1.0)
    if dplayer < 8 then damage_player(1) end
  elseif a.state == "investigate" then
    a.timer = a.timer - 1
    if move_alien(a, a.last.x, a.last.y, 0.88) or a.timer <= 0 then
      a.state = "patrol"
    end
  elseif a.state == "search" then
    a.timer = a.timer - 1
    if move_alien(a, a.last.x, a.last.y, 0.82) or a.timer <= 0 then
      a.state = "patrol"
    end
  else
    local wp = WORLD.patrol[a.wp]
    if move_alien(a, wp.x, wp.y, a.speed) then
      a.wp = (a.wp % #WORLD.patrol) + 1
    end
  end
end

local function update_cameras()
  local px, py = player_center()
  local seen = false
  for i = 1, #WORLD.cameras do
    local c = WORLD.cameras[i]
    if not c.disabled then
      c.sweep = c.sweep + 0.012
      c.angle = c.base + math.sin(c.sweep) * 0.65
      local dx, dy = px - c.x, py - c.y
      local d = math.sqrt(dx * dx + dy * dy)
      if d < 105 and ang_diff(atan2(dy, dx), c.angle) < 0.42 and los_clear(c.x, c.y, px, py, false) then
        seen = true
        GAME.alarm = clamp(GAME.alarm + 1.15, 0, 100)
      end
    end
  end
  if not seen then GAME.alarm = clamp(GAME.alarm - 0.25, 0, 100) end
  if GAME.alarm >= 100 then
    GAME.alarm = 65
    GAME.alert_t = 260
    msg("ALARM. THE ALIEN KNOWS.")
  end
end

local function update_noises()
  for i = #WORLD.noises, 1, -1 do
    local n = WORLD.noises[i]
    n.life = n.life - 1
    if n.life <= 0 then table.remove(WORLD.noises, i) end
  end
end

local function draw_map()
  for y = 0, 16 do
    for x = 0, 29 do
      if is_lit(x, y) then
        local px, py = x * CFG.ts, y * CFG.ts
        local ch = string.sub(WORLD.map[y + 1], x + 1, x + 1)
        if ch == "#" then
          rect(px, py, 8, 8, 5)
          rect(px + 1, py + 1, 6, 6, 10)
          rect(px + 3, py + 3, 2, 2, 15)
        elseif ch == "%" then
          rect(px, py, 8, 8, 4)
          rect(px + 1, py + 1, 6, 6, 10)
          line(px + 1, py + 2, px + 6, py + 5, 0)
          line(px + 2, py + 6, px + 7, py + 3, 0)
        elseif ch == "D" then
          rect(px, py, 8, 8, 4)
          rectb(px, py, 8, 8, 15)
          rect(px + 3, py + 3, 2, 2, 10)
        else
          rect(px, py, 8, 8, (x + y) % 2 == 0 and 1 or 8)
          if (x * 11 + y * 7) % 13 == 0 then rect(px + 2, py + 2, 2, 2, 15) end
        end
      end
    end
  end
end

local function draw_light()
  local p = WORLD.player
  local cx, cy = player_center()
  local base = atan2(p.fy, p.fx)
  for k = -2, 2 do
    local a = base + k * CFG.cone * 0.45
    line(cx, cy, cx + math.cos(a) * CFG.light_r, cy + math.sin(a) * CFG.light_r, k == 0 and 7 or 6)
  end
  circb(cx, cy, CFG.ambient_r, 6)
end

local function draw_items()
  for i = 1, #WORLD.items do
    local it = WORLD.items[i]
    local tx, ty = math.floor(it.x / CFG.ts), math.floor(it.y / CFG.ts)
    if is_lit(tx, ty) then
      if it.kind == "data" then
        rect(it.x - 4, it.y - 4, 8, 8, it.done and 1 or 11)
        rectb(it.x - 4, it.y - 4, 8, 8, 15)
        print("D", it.x - 2, it.y - 2, 0)
      elseif it.kind == "power" then
        circ(it.x, it.y, 4, it.done and 1 or 10)
        line(it.x - 2, it.y, it.x + 2, it.y, 0)
        line(it.x, it.y - 2, it.x, it.y + 2, 0)
      else
        rect(it.x - 4, it.y - 4, 8, 8, 4)
        rectb(it.x - 4, it.y - 4, 8, 8, 15)
        print("X", it.x - 2, it.y - 2, 7)
      end
    end
  end
end

local function draw_cameras()
  for i = 1, #WORLD.cameras do
    local c = WORLD.cameras[i]
    local tx, ty = math.floor(c.x / CFG.ts), math.floor(c.y / CFG.ts)
    if is_lit(tx, ty) then
      circ(c.x, c.y, 3, c.disabled and 1 or 12)
      rect(c.x - 1, c.y - 4, 2, 2, 15)
      if not c.disabled then
        for k = -1, 1 do
          local a = c.angle + k * 0.18
          line(c.x, c.y, c.x + math.cos(a) * 42, c.y + math.sin(a) * 42, 12)
        end
      end
    end
  end
end

local function draw_alien()
  local a = WORLD.alien
  if not a then return end
  local tx, ty = math.floor((a.x + 4) / CFG.ts), math.floor((a.y + 4) / CFG.ts)
  local px, py = player_center()
  local d = math.sqrt((px - a.x) ^ 2 + (py - a.y) ^ 2)
  if not is_lit(tx, ty) and d > 42 then return end
  local col = a.state == "chase" and 2 or 14
  circ(a.x + 4, a.y + 4, 5, col)
  circ(a.x + 4, a.y + 4, 2, 0)
  line(a.x + 4, a.y + 4, a.x + 4 + math.cos(a.angle) * 9, a.y + 4 + math.sin(a.angle) * 9, col)
  line(a.x - 1, a.y + 7, a.x + 1, a.y + 10, col)
  line(a.x + 6, a.y + 7, a.x + 8, a.y + 10, col)
end

local function draw_noises()
  for i = 1, #WORLD.noises do
    local n = WORLD.noises[i]
    local r = n.r * (1 - n.life / 60)
    circb(n.x, n.y, math.max(2, r), 14)
  end
end

local function draw_player()
  local p = WORLD.player
  if p.inv > 0 and GAME.t % 6 < 3 then return end
  circ(p.x + 4, p.y + 4, 4, 6)
  rect(p.x + 2, p.y + 6, 5, 2, 11)
  rectb(p.x, p.y, 8, 8, 15)
  line(p.x + 4, p.y + 4, p.x + 4 + p.fx * 7, p.y + 4 + p.fy * 7, 15)
end

local function draw_hud()
  rect(0, 0, 240, 18, 0)
  line(0, 18, 239, 18, 5)
  print("HP", 3, 3, 7)
  for i = 1, CFG.player_hp do
    rect(20 + (i - 1) * 8, 4, 6, 5, i <= WORLD.player.hp and 2 or 1)
  end
  print("ALARM", 54, 3, 7)
  rect(90, 4, 58, 5, 1)
  rect(90, 4, math.floor(58 * GAME.alarm / 100), 5, GAME.alarm > 70 and 2 or 12)
  print("DATA", 158, 3, GAME.has_data and 10 or 5)
  print("POWER", 190, 3, GAME.power_off and 10 or 5)
  print("Z CUT", 3, 11, GAME.cut_cd > 0 and 5 or 7)
  print("X HACK", 48, 11, GAME.hack_cd > 0 and 5 or 7)
  print("A DECOY", 96, 11, GAME.decoy_cd > 0 and 5 or 7)
  print(GAME.alert_t > 0 and "HUNTED" or "HIDDEN", 160, 11, GAME.alert_t > 0 and 2 or 10)
  if GAME.msg_t > 0 then
    rect(0, 118, 240, 18, 0)
    line(0, 118, 239, 118, 5)
    print(GAME.msg, 4, 124, 7)
  end
end

local function draw_game()
  cls(0)
  draw_map()
  draw_light()
  draw_items()
  draw_cameras()
  draw_alien()
  draw_noises()
  draw_player()
  draw_fx()
  draw_hud()
end

