  center_text("CUT WALLS. HACK DOORS. THROW DECOYS.", 64, 5, 1)
  center_text("Z CUT   X HACK   A DECOY", 78, 15, 1)
  center_text("ARROWS MOVE", 88, 15, 1)
  center_text("PRESS Z TO INFILTRATE", 108, 10, 1)
  center_text(CFG.by, 128, 5, 1)
end

local function draw_end(win)
  cls(0)
  rect(0, 0, 240, 136, win and 1 or 0)
  for i = 1, 35 do
    rect((i * 41) % 240, (i * 29) % 136, 2, 2, win and 14 or 2)
  end
  center_text(win and "BEACON BREACHED" or "SIGNAL LOST", 32, win and 10 or 2, 2)
  center_text(GAME.reason, 58, 7, 1)
  center_text("PRESS Z TO TRY AGAIN", 88, 10, 1)
end

function reset_game()
  math.randomseed(7331)
  GAME.state = CFG.start_title and "title" or "play"
  GAME.t = 0
  GAME.msg = ""
  GAME.msg_t = 0
  GAME.reason = ""
  GAME.shake = 0
  load_facility()
  msg("STEAL THE DATA. STAY QUIET.")
end

function TIC()
  GAME.t = GAME.t + 1
  if GAME.msg_t > 0 then GAME.msg_t = GAME.msg_t - 1 end
  if GAME.state == "title" then
    if btnp(INPUT.cut) or btnp(INPUT.hack) then
      reset_game()
      GAME.state = "play"
    end
    draw_title()
  elseif GAME.state == "play" then
    update_player()
    update_alien()
    update_cameras()
    update_noises()
    update_fx()
    draw_game()
  elseif GAME.state == "win" or GAME.state == "lose" then
    if btnp(INPUT.cut) then
      reset_game()
      GAME.state = "play"
    end
    draw_end(GAME.state == "win")
  end
end

reset_game()
