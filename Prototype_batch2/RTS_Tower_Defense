CFG = {
  title = "RTS TOWER DEFENSE", sub = "THREE LANES. ONE HERO.", by = "YAZDAN ALI KHAN",
  sw = 240, sh = 136, lanes = 3, lane_y = { 32, 66, 100 },
  base_x = 12, spawn_x = 236, start_title = true, waves = 10,
}

INPUT = { up = 0, down = 1, left = 2, right = 3, fire = 4, cycle = 5, start = 6, ability = 7 }

TOWER_TYPES = {
  { name = "CANNON", cost = 15, damage = 3, rate = 55, range = 92, col = 10 },
  { name = "FROST", cost = 12, damage = 1, rate = 40, range = 82, col = 11, slow = 70 },
  { name = "TESLA", cost = 20, damage = 2, rate = 65, range = 86, col = 14, chain = 2 },
}

ENEMY_TYPES = {
  grunt = { name = "GRUNT", hp = 4, speed = 0.36, damage = 1, gold = 2, col = 2, w = 5, h = 8 },
  runner = { name = "RUNNER", hp = 2, speed = 0.72, damage = 1, gold = 1, col = 12, w = 4, h = 6 },
  tank = { name = "TANK", hp = 10, speed = 0.20, damage = 3, gold = 4, col = 5, w = 8, h = 9 },
  boss = { name = "BOSS", hp = 40, speed = 0.12, damage = 8, gold = 20, col = 4, w = 10, h = 12 },
}

WAVES = {
  { "grunt", "grunt", "grunt", "grunt", "grunt" },
  { "grunt", "grunt", "grunt", "runner", "runner", "grunt" },
  { "grunt", "runner", "runner", "runner", "grunt", "runner" },
  { "tank", "grunt", "grunt", "tank", "grunt", "runner" },
  { "runner", "runner", "runner", "runner", "grunt", "grunt", "runner", "runner" },
  { "tank", "tank", "grunt", "grunt", "grunt", "runner" },
  { "runner", "runner", "runner", "runner", "tank", "tank", "runner", "runner" },
  { "grunt", "grunt", "runner", "runner", "tank", "tank", "grunt", "runner" },
  { "runner", "runner", "runner", "runner", "tank", "tank", "tank", "grunt" },
  { "grunt", "grunt", "runner", "runner", "tank", "tank", "tank", "boss" },
}

GAME = {}
WORLD = {}

local function clamp(v, a, b)
  if v < a then return a end
  if v > b then return b end
  return v
end

local function center_text(s, y, col, scale)
  print(s, math.floor((CFG.sw - #s * 6 * (scale or 1)) / 2), y, col, scale)
end

local function msg(s)
  GAME.msg = s
  GAME.msg_t = 150
end

local function spawn_fx(x, y, col, n)
  for i = 1, (n or 4) do
    WORLD.fx[#WORLD.fx + 1] = {
      x = x, y = y,
      vx = (math.random() - 0.5) * 2.4,
      vy = (math.random() - 0.5) * 2.4,
      life = 12 + math.random(12), col = col,
    }
  end
end

local function update_fx()
  for i = #WORLD.fx, 1, -1 do
    local f = WORLD.fx[i]
    f.x = f.x + f.vx
    f.y = f.y + f.vy
    f.vx = f.vx * 0.95
    f.vy = f.vy * 0.95
    f.life = f.life - 1
    if f.life <= 0 then table.remove(WORLD.fx, i) end
  end
end

local function draw_fx()
  for i = 1, #WORLD.fx do
    local f = WORLD.fx[i]
    rect(math.floor(f.x), math.floor(f.y), 1, 1, f.col)
  end
end

local function add_enemy(kind, lane)
  local d = ENEMY_TYPES[kind]
  WORLD.enemies[#WORLD.enemies + 1] = {
    kind = kind, lane = lane, x = CFG.spawn_x + math.random(10),
    y = CFG.lane_y[lane], w = d.w, h = d.h,
    hp = d.hp, max_hp = d.hp, speed = d.speed,
    damage = d.damage, gold = d.gold, col = d.col,
    slow = 0, hurt = 0,
  }
end

local function start_wave()
  if GAME.phase ~= "build" or GAME.wave >= CFG.waves then return end
  GAME.wave = GAME.wave + 1
  GAME.phase = "wave"
  WORLD.wave_list = {}
  local w = WAVES[GAME.wave]
  for i = 1, #w do
    WORLD.wave_list[#WORLD.wave_list + 1] = { kind = w[i], lane = math.random(CFG.lanes) }
  end
  WORLD.spawn_i = 1
  WORLD.spawn_t = 0
  WORLD.enemies = {}
  WORLD.projectiles = {}
  WORLD.tracers = {}
  msg("WAVE " .. GAME.wave .. " INCOMING")
end

local function finish_wave()
  GAME.phase = "build"
  WORLD.enemies = {}
  WORLD.projectiles = {}
  if GAME.wave >= CFG.waves then
    GAME.state = "win"
    GAME.reason = "ALL WAVES BROKEN"
    return
  end
  WORLD.gold = WORLD.gold + 12
  WORLD.base_hp = math.min(WORLD.base_max, WORLD.base_hp + 2)
  msg("WAVE CLEARED. +12 GOLD")
end

local function damage_base(n)
  WORLD.base_hp = WORLD.base_hp - n
  GAME.shake = 8
  spawn_fx(CFG.base_x + 8, 66, 2, 8)
  if WORLD.base_hp <= 0 then
    WORLD.base_hp = 0
    GAME.state = "lose"
    GAME.reason = "THE CORE IS OVERRUN"
  end
end

local function hurt_enemy(e, n, x, y)
  e.hp = e.hp - n
  e.hurt = 6
  spawn_fx(x or e.x, y or e.y, 4, 4)
  if e.hp <= 0 then
    WORLD.gold = WORLD.gold + e.gold
    spawn_fx(e.x, e.y, e.col, 9)
    return true
  end
  return false
end

local function nearest_enemy(lane, x, range)
  local best, bd = nil, range * range
  for i = 1, #WORLD.enemies do
    local e = WORLD.enemies[i]
    if (lane == 0 or e.lane == lane) and e.hp > 0 then
      local d = (e.x - x) ^ 2
      if d < bd then best, bd = i, d end
    end
  end
  return best
end

local function update_towers()
  for lane = 1, CFG.lanes do
    for col = 1, 3 do
      local s = WORLD.slots[lane][col]
      s.cool = math.max(0, s.cool - 1)
      if s.kind > 0 and s.cool <= 0 then
        local t = TOWER_TYPES[s.kind]
        local ti = nearest_enemy(0, s.x, t.range)
        if ti then
          local e = WORLD.enemies[ti]
          s.cool = t.rate
          WORLD.tracers[#WORLD.tracers + 1] = {
            x1 = s.x, y1 = s.y, x2 = e.x, y2 = e.y,
            life = 5, col = t.col,
          }
          if hurt_enemy(e, t.damage, e.x, e.y) then table.remove(WORLD.enemies, ti) end
          if t.slow then e.slow = t.slow end
          if t.chain then
            local hits = 0
            for j = #WORLD.enemies, 1, -1 do
              local o = WORLD.enemies[j]
              if o ~= e and o.hp > 0 and math.abs(o.x - e.x) < 55 and hits < t.chain then
                hits = hits + 1
                WORLD.tracers[#WORLD.tracers + 1] = {
                  x1 = e.x, y1 = e.y, x2 = o.x, y2 = o.y,
                  life = 5, col = t.col,
                }
                if hurt_enemy(o, t.damage, o.x, o.y) then table.remove(WORLD.enemies, j) end
              end
            end
          end
        end
      end
    end
  end
end

local function hero_attack()
  local h = WORLD.hero
  if h.down > 0 or h.cool > 0 then return end
  local ti = nearest_enemy(h.lane, h.x, 78)
  if not ti then
    msg("NO TARGET IN LANE")
    return
  end
  h.cool = 18
  local e = WORLD.enemies[ti]
  WORLD.projectiles[#WORLD.projectiles + 1] = {
    x = h.x, y = h.y, target = e, damage = 2, life = 50, col = 12,
  }
  spawn_fx(h.x, h.y, 12, 3)
end

local function hero_ability()
  local h = WORLD.hero
  if h.down > 0 or h.ability_cd > 0 then return end
  h.ability_cd = 300
  for i = #WORLD.enemies, 1, -1 do
    local e = WORLD.enemies[i]
    if e.lane == h.lane and math.abs(e.x - h.x) < 80 then
      if hurt_enemy(e, 4, e.x, e.y) then table.remove(WORLD.enemies, i) end
    end
  end
  spawn_fx(h.x, h.y, 14, 18)
  msg("PULSE DISCHARGE")
end

local function update_hero()
  local h = WORLD.hero
  if h.down > 0 then
    h.down = h.down - 1
    if h.down <= 0 then
      h.hp = h.max_hp
      h.x = CFG.base_x + 22
      h.lane = 2
      h.y = CFG.lane_y[2]
      msg("HERO REBOOTED")
    end
    return
  end
  h.cool = math.max(0, h.cool - 1)
  h.ability_cd = math.max(0, h.ability_cd - 1)
  h.inv = math.max(0, h.inv - 1)
  if btn(INPUT.up) and h.lane > 1 then h.lane = h.lane - 1; h.y = CFG.lane_y[h.lane] end
  if btn(INPUT.down) and h.lane < CFG.lanes then h.lane = h.lane + 1; h.y = CFG.lane_y[h.lane] end
  if btn(INPUT.left) then h.x = math.max(CFG.base_x + 20, h.x - 1.4) end
  if btn(INPUT.right) then h.x = math.min(222, h.x + 1.4) end
  if btnp(INPUT.fire) then hero_attack() end
  if btnp(INPUT.ability) then hero_ability() end
  for i = 1, #WORLD.enemies do
    local e = WORLD.enemies[i]
    if e.lane == h.lane and math.abs(e.x - h.x) < 8 and h.inv <= 0 then
      h.hp = h.hp - 1
      h.inv = 45
      spawn_fx(h.x, h.y, 2, 5)
      if h.hp <= 0 then
        h.hp = 0
        h.down = 180
        msg("HERO DOWN. REBOOTING.")
      end
      break
    end
  end
end

local function update_enemies()
  for i = #WORLD.enemies, 1, -1 do
    local e = WORLD.enemies[i]
    e.hurt = math.max(0, e.hurt - 1)
    e.slow = math.max(0, e.slow - 1)
    local sp = e.speed * (e.slow > 0 and 0.38 or 1)
    e.x = e.x - sp
    if e.x <= CFG.base_x + 10 then
      damage_base(e.damage)
      table.remove(WORLD.enemies, i)
    elseif e.hp <= 0 then
      table.remove(WORLD.enemies, i)
    end
  end
end

local function update_projectiles()
  for i = #WORLD.projectiles, 1, -1 do
    local b = WORLD.projectiles[i]
    b.life = b.life - 1
    if b.target and b.target.hp > 0 then
      local dx, dy = b.target.x - b.x, b.target.y - b.y
      local d = math.sqrt(dx * dx + dy * dy)
      if d < 6 then
        local e = b.target
        local ex, ey = e.x, e.y
        if hurt_enemy(e, b.damage, ex, ey) then
          for j = #WORLD.enemies, 1, -1 do
            if WORLD.enemies[j] == e then table.remove(WORLD.enemies, j) end
          end
        end
        table.remove(WORLD.projectiles, i)
      else
        b.x = b.x + dx / d * 4
        b.y = b.y + dy / d * 4
      end
    else
      table.remove(WORLD.projectiles, i)
    end
  end
end

local function update_tracers()
  for i = #WORLD.tracers, 1, -1 do
    local t = WORLD.tracers[i]
    t.life = t.life - 1
    if t.life <= 0 then table.remove(WORLD.tracers, i) end
  end
end

local function update_wave()
  if WORLD.spawn_i <= #WORLD.wave_list then
    WORLD.spawn_t = WORLD.spawn_t - 1
    if WORLD.spawn_t <= 0 then
      local n = WORLD.wave_list[WORLD.spawn_i]
      add_enemy(n.kind, n.lane)
      WORLD.spawn_i = WORLD.spawn_i + 1
      WORLD.spawn_t = 42
    end
  end
  update_hero()
  update_towers()
  update_enemies()
  update_projectiles()
  update_tracers()
  update_fx()
  if GAME.state == "play" and WORLD.spawn_i > #WORLD.wave_list and #WORLD.enemies == 0 then
    finish_wave()
  end
end

local function update_build()
  if btnp(INPUT.up) then GAME.cursor_lane = math.max(1, GAME.cursor_lane - 1) end
  if btnp(INPUT.down) then GAME.cursor_lane = math.min(CFG.lanes, GAME.cursor_lane + 1) end
  if btnp(INPUT.left) then GAME.cursor_col = math.max(1, GAME.cursor_col - 1) end
  if btnp(INPUT.right) then GAME.cursor_col = math.min(3, GAME.cursor_col + 1) end
  if btnp(INPUT.cycle) then
    GAME.build_type = (GAME.build_type % #TOWER_TYPES) + 1
    msg(TOWER_TYPES[GAME.build_type].name)
  end
  if btnp(INPUT.fire) then
    local s = WORLD.slots[GAME.cursor_lane][GAME.cursor_col]
    if s.kind > 0 then
      msg("SLOT OCCUPIED")
    else
      local t = TOWER_TYPES[GAME.build_type]
      if WORLD.gold < t.cost then
        msg("NOT ENOUGH GOLD")
      else
        WORLD.gold = WORLD.gold - t.cost
        s.kind = GAME.build_type
        s.cool = 0
        msg(t.name .. " BUILT")
      end
    end
  end
  if btnp(INPUT.start) then start_wave() end
end

local function draw_background()
  rect(0, 0, 240, 136, 0)
  for i = 1, 40 do
    local x = (i * 53) % 240
    local y = (i * 31) % 136
    rect(x, y, 1, 1, i % 5 == 0 and 5 or 1)
  end
  for lane = 1, CFG.lanes do
    local y = CFG.lane_y[lane]
    rect(0, y - 14, 240, 28, lane == 2 and 1 or 8)
    line(0, y - 14, 239, y - 14, 5)
    line(0, y + 13, 239, y + 13, 5)
    for x = 30, 230, 20 do
      rect(x, y + 11, 6, 1, 5)
    end
  end
  rect(0, 14, 240, 2, 5)
  rect(0, 116, 240, 2, 5)
end

local function draw_base()
  rect(2, 40, 26, 54, 10)
  rectb(2, 40, 26, 54, 15)
  rect(6, 48, 18, 38, 4)
  rect(9, 54, 12, 26, 8)
  rect(9, 54, 12, 4, 15)
  line(15, 40, 15, 30, 15)
  rect(15, 30, 9, 5, 2)
  rect(2, 94, 26, 3, 5)
  print("CORE", 6, 86, 7)
end

local function draw_slots()
  for lane = 1, CFG.lanes do
    for col = 1, 3 do
      local s = WORLD.slots[lane][col]
      local x = 50 + (col - 1) * 48
      local y = CFG.lane_y[lane]
      s.x, s.y = x, y
      rect(x - 5, y + 8, 11, 3, 5)
      rect(x - 4, y + 9, 9, 1, 10)
      if s.kind == 1 then
        rect(x - 5, y - 5, 10, 8, 5)
        line(x - 7, y - 3, x + 7, y - 3, 15)
        circ(x, y - 5, 2, 10)
      elseif s.kind == 2 then
        rect(x - 4, y - 6, 8, 9, 8)
        circ(x, y - 2, 3, 11)
        line(x, y - 6, x, y + 2, 15)
      elseif s.kind == 3 then
        rect(x - 3, y - 7, 6, 10, 4)
        circ(x, y - 7, 3, 14)
        line(x - 4, y - 10, x + 4, y - 4, 14)
      end
    end
  end
  if GAME.phase == "build" then
    local x = 50 + (GAME.cursor_col - 1) * 48
    local y = CFG.lane_y[GAME.cursor_lane]
    rectb(x - 7, y - 10, 15, 22, 14)
    rectb(x - 5, y - 8, 11, 18, 15)
  end
end

local function draw_enemy(e)
  local col = e.hurt > 0 and 7 or e.col
  local y = e.y
  if e.kind == "runner" then
    rect(math.floor(e.x) - 2, y - 3, 4, 6, col)
    line(math.floor(e.x), y - 3, math.floor(e.x) - 3, y - 6, 15)
  elseif e.kind == "tank" then
    rect(math.floor(e.x) - 4, y - 5, 8, 9, col)
    rectb(math.floor(e.x) - 4, y - 5, 8, 9, 15)
    line(math.floor(e.x) - 6, y + 2, math.floor(e.x) + 6, y + 2, 10)
  elseif e.kind == "boss" then
    rect(math.floor(e.x) - 5, y - 6, 10, 12, col)
    rectb(math.floor(e.x) - 5, y - 6, 10, 12, 15)
    circ(math.floor(e.x), y - 7, 3, 14)
    line(math.floor(e.x) - 7, y - 2, math.floor(e.x) + 7, y - 2, 10)
  else
    rect(math.floor(e.x) - 2, y - 4, 5, 8, col)
    rect(math.floor(e.x) - 1, y - 6, 3, 2, 15)
  end
  if e.slow > 0 then circ(math.floor(e.x), y - 8, 2, 11) end
  if e.hp < e.max_hp then
    rect(math.floor(e.x) - e.w / 2, y - e.h / 2 - 5, e.w, 1, 0)
    rect(math.floor(e.x) - e.w / 2, y - e.h / 2 - 5, math.floor(e.w * e.hp / e.max_hp), 1, 2)
  end
end

local function draw_hero()
  local h = WORLD.hero
  if h.down > 0 then
    print("DOWN " .. math.ceil(h.down / 60), h.x - 10, h.y - 3, 2)
    return
  end
  if h.inv > 0 and GAME.t % 6 < 3 then return end
  rect(h.x - 4, h.y - 4, 8, 8, 12)
  rectb(h.x - 4, h.y - 4, 8, 8, 15)
  rect(h.x - 2, h.y - 6, 4, 2, 4)
  line(h.x + 4, h.y, h.x + 9, h.y, 14)
  rect(h.x - 6, h.y + 5, 12, 1, 0)
  rect(h.x - 6, h.y + 5, math.floor(12 * h.hp / h.max_hp), 1, 2)
end

local function draw_hud()
  rect(0, 0, 240, 14, 0)
  print("BASE", 3, 4, 7)
  rect(28, 5, 40, 4, 1)
  rect(28, 5, math.floor(40 * WORLD.base_hp / WORLD.base_max), 4, 10)
  print("GOLD " .. WORLD.gold, 76, 4, 10)
  print("WAVE " .. GAME.wave .. "/" .. CFG.waves, 132, 4, 7)
  print("HERO", 184, 4, 7)
  rect(208, 5, 28, 4, 1)
  rect(208, 5, math.floor(28 * WORLD.hero.hp / WORLD.hero.max_hp), 4, 12)
  rect(0, 118, 240, 18, 0)
  if GAME.phase == "build" then
    local t = TOWER_TYPES[GAME.build_type]
    print("BUILD: " .. t.name .. " " .. t.cost, 3, 123, t.col)
    print("X CYCLE   Z BUILD   A START", 120, 123, 7)
  else
    print("ARROWS MOVE   Z FIRE   S PULSE", 3, 123, 7)
    print("PULSE " .. (WORLD.hero.ability_cd <= 0 and "READY" or math.ceil(WORLD.hero.ability_cd / 60)), 174, 123, 14)
  end
  if GAME.msg_t > 0 then
    rect(0, 108, 240, 10, 0)
    print(GAME.msg, 3, 110, 7)
  end
end

local function draw_game()
  draw_background()
  draw_base()
  draw_slots()
  for i = 1, #WORLD.enemies do draw_enemy(WORLD.enemies[i]) end
  for i = 1, #WORLD.projectiles do
    local b = WORLD.projectiles[i]
    rect(math.floor(b.x), math.floor(b.y), 2, 2, b.col)
  end
  for i = 1, #WORLD.tracers do
    local t = WORLD.tracers[i]
    line(math.floor(t.x1), math.floor(t.y1), math.floor(t.x2), math.floor(t.y2), t.col)
  end
  draw_hero()
  draw_fx()
  draw_hud()
end

