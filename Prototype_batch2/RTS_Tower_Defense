local function draw_end(win)
  cls(0)
  rect(0, 0, 240, 136, win and 1 or 0)
  for i = 1, 35 do
    rect((i * 41) % 240, (i * 29) % 136, 2, 2, win and 10 or 2)
  end
  center_text(win and "ALL WAVES BROKEN" or "THE CORE FALLS", 32, win and 10 or 2, 2)
  center_text(GAME.reason, 58, 7, 1)
  center_text("WAVES: " .. GAME.wave, 74, 5, 1)
  center_text("PRESS Z TO REDEPLOY", 96, 10, 1)
end

function reset_game()
  math.randomseed(7777)
  GAME.state = CFG.start_title and "title" or "play"
  GAME.phase = "build"
  GAME.wave = 0
  WORLD.gold = 30
  GAME.cursor_col = 2
  GAME.cursor_lane = 2
  GAME.build_type = 1
  GAME.msg = ""
  GAME.msg_t = 0
  GAME.reason = ""
  GAME.t = 0
  WORLD.base_hp = 20
  WORLD.base_max = 20
  WORLD.slots = {}
  for lane = 1, CFG.lanes do
    WORLD.slots[lane] = {}
    for col = 1, 3 do
      WORLD.slots[lane][col] = { kind = 0, cool = 0, x = 50 + (col - 1) * 48, y = CFG.lane_y[lane] }
    end
  end
  WORLD.hero = {
    x = CFG.base_x + 22, y = CFG.lane_y[2], lane = 2,
    hp = 10, max_hp = 10, cool = 0, ability_cd = 0, inv = 0, down = 0,
  }
  WORLD.enemies = {}
  WORLD.projectiles = {}
  WORLD.tracers = {}
  WORLD.fx = {}
  WORLD.wave_list = {}
  WORLD.spawn_i = 1
  WORLD.spawn_t = 0
  msg("BUILD YOUR FIRST TOWER")
end

function TIC()
  GAME.t = GAME.t + 1
  if GAME.msg_t > 0 then GAME.msg_t = GAME.msg_t - 1 end
  if GAME.state == "title" then
    if btnp(INPUT.fire) or btnp(INPUT.start) then
      reset_game()
      GAME.state = "play"
    end
    draw_title()
  elseif GAME.state == "play" then
    if GAME.phase == "build" then update_build() else update_wave() end
    draw_game()
  elseif GAME.state == "win" or GAME.state == "lose" then
    if btnp(INPUT.fire) then
      reset_game()
      GAME.state = "play"
    end
    draw_end(GAME.state == "win")
  end
end

