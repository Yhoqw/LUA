CFG = {
  title = "FTL: SANDBOX", sub = "A SHIP IS A SYSTEM", by = "YAZDAN ALI KHAN",
  sw = 240, sh = 136, reactor = 8, hull_max = 20, oxygen_max = 100,
  start_title = true, columns = 4, rows = 3,
}

INPUT = { up = 0, down = 1, left = 2, right = 3, confirm = 4, back = 5, fire = 6 }

SYSTEMS = {
  { name = "PILOT", short = "P", max = 3, col = 12 },
  { name = "WEAPONS", short = "W", max = 3, col = 10 },
  { name = "SHIELDS", short = "S", max = 3, col = 11 },
  { name = "ENGINES", short = "E", max = 3, col = 14 },
  { name = "OXYGEN", short = "O", max = 3, col = 7 },
  { name = "MEDBAY", short = "M", max = 3, col = 2 },
}

CREW_NAMES = { "ADA", "BRICK", "CORA", "DEX", "ELI", "FENN" }
CREW_SKILL = { 2, 0, 1, 2, 1, 0 }

GAME = {}
WORLD = {}

local function clamp(v, a, b)
  if v < a then return a end
  if v > b then return b end
  return v
end

local function center_text(s, y, col, scale)
  print(s, math.floor((CFG.sw - #s * 6 * (scale or 1)) / 2), y, col, scale)
end

local function msg(s)
  GAME.msg = s
  GAME.msg_t = 150
end

local function node_at(col, row)
  for i = 1, #WORLD.nodes do
    local n = WORLD.nodes[i]
    if n.col == col and n.row == row then return n end
  end
  return nil
end

local function crew_in_room(room)
  local list = {}
  for i = 1, #WORLD.crew do
    if WORLD.crew[i].room == room and WORLD.crew[i].hp > 0 then list[#list + 1] = i end
  end
  return list
end

local function crew_bonus(room)
  local best = 0
  for i = 1, #WORLD.crew do
    local c = WORLD.crew[i]
    if c.room == room and c.hp > 0 and c.skill > best then best = c.skill end
  end
  return best * 0.5
end

local function effective_power(i)
  local s = WORLD.systems[i]
  return math.max(0, s.power - s.damage) + crew_bonus(i)
end

local function used_power()
  local n = 0
  for i = 1, #WORLD.systems do n = n + WORLD.systems[i].power end
  return n
end

local function gen_nodes()
  WORLD.nodes = {}
  for col = 0, CFG.columns - 1 do
    for row = 0, CFG.rows - 1 do
      local t = "empty"
      if col == CFG.columns - 1 and row == 1 then
        t = "exit"
      elseif col > 0 then
        local r = math.random()
        if r < 0.34 then t = "combat"
        elseif r < 0.64 then t = "event"
        elseif r < 0.78 then t = "shop" end
      end
      WORLD.nodes[#WORLD.nodes + 1] = { col = col, row = row, type = t }
    end
  end
end

local function start_combat()
  local hull = 9 + math.random(6)
  WORLD.enemy = {
    hull = hull, max_hull = hull, shield = 4, max_shield = 4,
    weapons = 1 + math.random(2), fire_cd = 110, evasion = 0.10,
  }
  GAME.screen = "combat"
  GAME.fire_cd = 0
  msg("HOSTILE SHIP. FIRE WITH A.")
end

local function start_event()
  local r = math.random(4)
  if r == 1 then
    GAME.event = {
      kind = "distress", title = "DISTRESS SIGNAL",
      text = "A civilian transport is venting atmosphere.",
      a = "Z: RENDER AID (-1 FUEL, +6 SCRAP)",
      b = "X: IGNORE THE SIGNAL",
    }
  elseif r == 2 then
    GAME.event = {
      kind = "derelict", title = "DERELICT HULK",
      text = "A dead cruiser drifts in the debris field.",
      a = "Z: SALVAGE (+8 SCRAP, -2 HULL)",
      b = "X: LEAVE IT DARK",
    }
  elseif r == 3 then
    GAME.event = {
      kind = "trader", title = "ROAMING TRADER",
      text = "A pressure-sealed trader offers repairs.",
      a = "Z: REPAIR HULL (-8 SCRAP, +5 HULL)",
      b = "X: WAVE THEM ON",
    }
  else
    GAME.event = {
      kind = "asteroid", title = "ASTEROID SWARM",
      text = "A dense field blocks the lane ahead.",
      a = "Z: BURN FUEL TO SHIELD (-1 FUEL)",
      b = "X: RUN THE FIELD (RISKY)",
    }
  end
  GAME.screen = "event"
end

local function resolve_event(choice)
  local e = GAME.event
  if not e then GAME.screen = "map"; return end
  if e.kind == "distress" then
    if choice == 1 then
      if WORLD.fuel >= 1 then
        WORLD.fuel = WORLD.fuel - 1
        WORLD.scrap = WORLD.scrap + 6
        msg("SURVIVORS SAVED. SALVAGE +6.")
      else
        msg("NOT ENOUGH FUEL.")
      end
    else
      msg("YOU LEAVE THEM TO THE DARK.")
    end
  elseif e.kind == "derelict" then
    if choice == 1 then
      WORLD.scrap = WORLD.scrap + 8
      WORLD.hull = math.max(1, WORLD.hull - 2)
      msg("SALVAGE RECOVERED. HULL -2.")
    else
      msg("THE HULK DRIFTS ON.")
    end
  elseif e.kind == "trader" then
    if choice == 1 then
      if WORLD.scrap >= 8 then
        WORLD.scrap = WORLD.scrap - 8
        WORLD.hull = math.min(CFG.hull_max, WORLD.hull + 5)
        msg("HULL PATCHED. SCRAP -8.")
      else
        msg("NOT ENOUGH SCRAP.")
      end
    else
      msg("THE TRADER MOVES ON.")
    end
  elseif e.kind == "asteroid" then
    if choice == 1 then
      if WORLD.fuel >= 1 then
        WORLD.fuel = WORLD.fuel - 1
        msg("FUEL BURNED. FIELD CLEARED.")
      else
        msg("NOT ENOUGH FUEL.")
      end
    else
      if math.random() < 0.55 then
        WORLD.hull = math.max(1, WORLD.hull - 3)
        msg("ROCKS HIT THE HULL. HULL -3.")
      else
        msg("YOU SLIP THROUGH CLEAN.")
      end
    end
  end
  GAME.event = nil
  GAME.screen = "map"
end

local function travel()
  local cur = WORLD.current
  if cur.col >= CFG.columns - 1 then
    GAME.state = "win"
    GAME.reason = "THE EXIT LANE OPENS"
    return
  end
  local n = node_at(cur.col + 1, GAME.sel_row - 1)
  if not n then return end
  if WORLD.fuel < 1 then
    msg("NO FUEL TO JUMP")
    return
  end
  WORLD.fuel = WORLD.fuel - 1
  WORLD.current = n
  if n.type == "exit" then
    GAME.state = "win"
    GAME.reason = "THE EXIT LANE OPENS"
  elseif n.type == "combat" then
    start_combat()
  elseif n.type == "event" then
    start_event()
  elseif n.type == "shop" then
    start_event()
  else
    WORLD.scrap = WORLD.scrap + 3
    msg("EMPTY SECTOR. SALVAGE +3.")
  end
end

local function damage_ship(n)
  if WORLD.shield > 0 then
    WORLD.shield = WORLD.shield - n
    if WORLD.shield < 0 then
      WORLD.hull = WORLD.hull + WORLD.shield
      WORLD.shield = 0
    end
  else
    WORLD.hull = WORLD.hull - n
    local i = math.random(#WORLD.systems)
    WORLD.systems[i].damage = math.min(3, WORLD.systems[i].damage + 1)
  end
  GAME.shake = 8
  if WORLD.hull <= 0 then
    WORLD.hull = 0
    GAME.state = "lose"
    GAME.reason = "THE HULL BREAKS APART"
  end
end

local function player_fire()
  if not WORLD.enemy then return end
  if GAME.fire_cd > 0 then return end
  local power = effective_power(2)
  if power <= 0 then
    msg("WEAPONS UNPOWERED")
    return
  end
  local dmg = 1 + math.floor(power)
  local e = WORLD.enemy
  if e.shield > 0 then
    e.shield = e.shield - dmg
    if e.shield < 0 then
      e.hull = e.hull + e.shield
      e.shield = 0
    end
  else
    e.hull = e.hull - dmg
  end
  GAME.fire_cd = math.max(18, 70 - math.floor(power) * 10)
  GAME.shake = 4
  msg("WEAPONS HIT FOR " .. dmg)
  if e.hull <= 0 then
    WORLD.enemy = nil
    WORLD.scrap = WORLD.scrap + 8
    GAME.screen = "map"
    msg("ENEMY DESTROYED. SCRAP +8.")
  end
end

local function update_ship_systems()
  for i = 1, #WORLD.systems do
    local s = WORLD.systems[i]
    if s.damage > 0 then
      local b = crew_bonus(i)
      if b > 0 then s.damage = math.max(0, s.damage - 0.012 * (1 + b)) end
    end
  end
  local ox = effective_power(5)
  if ox > 0 then
    WORLD.oxygen = clamp(WORLD.oxygen + 0.16 * ox, 0, CFG.oxygen_max)
  else
    WORLD.oxygen = clamp(WORLD.oxygen - 0.22, 0, CFG.oxygen_max)
  end
  for i = 1, #WORLD.crew do
    local c = WORLD.crew[i]
    if c.hp > 0 then
      if WORLD.oxygen < 20 then c.hp = c.hp - 0.04 end
      if c.room == 6 and effective_power(6) > 0 then
        c.hp = math.min(100, c.hp + 0.10 * effective_power(6))
      end
      if c.hp <= 0 then
        c.hp = 0
        c.room = 0
      end
    end
  end
  local dead = true
  for i = 1, #WORLD.crew do if WORLD.crew[i].hp > 0 then dead = false end end
  if dead then
    GAME.state = "lose"
    GAME.reason = "NO CREW LEFT ALIVE"
  end
  local sp = effective_power(3)
  WORLD.shield_max = math.floor(sp * 2)
  WORLD.shield = math.min(WORLD.shield_max, WORLD.shield + 0.03 * sp)
end

local function update_combat()
  if not WORLD.enemy then return end
  local e = WORLD.enemy
  e.shield = math.min(e.max_shield, e.shield + 0.02)
  e.fire_cd = e.fire_cd - 1
  if e.fire_cd <= 0 then
    e.fire_cd = 120
    local evade = 0.06 * (effective_power(1) + effective_power(4)) + crew_bonus(1) * 0.08
    evade = math.min(0.55, evade)
    if math.random() < evade then
      msg("INCOMING FIRE EVADED")
    else
      damage_ship(1 + e.weapons)
      msg("HULL HIT FOR " .. (1 + e.weapons))
    end
  end
  if e.hull <= 0 then
    WORLD.enemy = nil
    WORLD.scrap = WORLD.scrap + 8
    GAME.screen = "map"
    msg("ENEMY DESTROYED. SCRAP +8.")
  end
end

local function update_map()
  if btnp(INPUT.up) then GAME.sel_row = math.max(1, GAME.sel_row - 1) end
  if btnp(INPUT.down) then GAME.sel_row = math.min(CFG.rows, GAME.sel_row + 1) end
  if btnp(INPUT.confirm) then travel() end
  if btnp(INPUT.back) then GAME.screen = "ship"; msg("SHIP VIEW") end
end

local function update_event()
  if btnp(INPUT.confirm) then resolve_event(1) end
  if btnp(INPUT.back) then resolve_event(2) end
end

local function update_ship()
  if btnp(INPUT.left) then GAME.sel_room = math.max(1, GAME.sel_room - 1) end
  if btnp(INPUT.right) then GAME.sel_room = math.min(#WORLD.systems, GAME.sel_room + 1) end
  local s = WORLD.systems[GAME.sel_room]
  local def = SYSTEMS[GAME.sel_room]
  if btnp(INPUT.up) then
    if s.power < def.max and used_power() < CFG.reactor then
      s.power = s.power + 1
    else
      msg("REACTOR AT CAPACITY")
    end
  end
  if btnp(INPUT.down) then
    if s.power > 0 then s.power = s.power - 1 end
  end
  if btnp(INPUT.confirm) then
    if GAME.carry then
      local c = WORLD.crew[GAME.carry]
      c.room = GAME.sel_room
      GAME.carry = nil
      msg(c.name .. " ASSIGNED TO " .. SYSTEMS[GAME.sel_room].name)
    else
      local list = crew_in_room(GAME.sel_room)
      if #list > 0 then
        GAME.carry = list[1]
        WORLD.crew[list[1]].room = 0
        msg(WORLD.crew[list[1]].name .. " READY TO MOVE")
      else
        msg("NO CREW IN THIS ROOM")
      end
    end
  end
  if btnp(INPUT.fire) and WORLD.enemy then player_fire() end
  if btnp(INPUT.back) and not WORLD.enemy then GAME.screen = "map" end
  GAME.fire_cd = math.max(0, GAME.fire_cd - 1)
  update_ship_systems()
  update_combat()
end

local function draw_stars()
  rect(0, 0, 240, 136, 0)
  for i = 1, 45 do
    local x = (i * 53 + math.floor(GAME.t / 40)) % 240
    local y = (i * 37) % 136
    rect(x, y, 1, 1, i % 5 == 0 and 7 or 5)
  end
end

local function draw_hud()
  rect(0, 0, 240, 18, 0)
  line(0, 18, 239, 18, 5)
  print("HULL", 3, 3, 7)
  rect(27, 4, 44, 5, 1)
  rect(27, 4, math.floor(44 * WORLD.hull / CFG.hull_max), 5, 2)
  print("O2", 76, 3, 7)
  rect(90, 4, 34, 5, 1)
  rect(90, 4, math.floor(34 * WORLD.oxygen / CFG.oxygen_max), 5, 11)
  print("FUEL " .. WORLD.fuel, 128, 3, 7)
  print("SCRAP " .. WORLD.scrap, 168, 3, 7)
  print("PWR " .. used_power() .. "/" .. CFG.reactor, 210, 3, 5)
  if GAME.msg_t > 0 then
    rect(0, 118, 240, 18, 0)
    line(0, 118, 239, 118, 5)
    print(GAME.msg, 4, 124, 7)
  end
end

local function draw_map()
  draw_stars()
  local cur = WORLD.current
  for col = 0, CFG.columns - 1 do
    for row = 0, CFG.rows - 1 do
      local n = node_at(col, row)
      local x = 30 + col * 58
      local y = 34 + row * 28
      if col == cur.col + 1 then
        line(30 + cur.col * 58, 34 + cur.row * 28, x, y, 5)
      end
      local colr = 5
      if n == cur then colr = 10
      elseif n.type == "exit" then colr = 14
      elseif n.type == "combat" then colr = 2
      elseif n.type == "event" then colr = 12
      elseif n.type == "shop" then colr = 4
      elseif col == cur.col + 1 and row == GAME.sel_row - 1 then colr = 15 end
      circ(x, y, 5, colr)
      if n.type == "exit" then print("E", x - 2, y - 2, 0)
      elseif n.type == "combat" then print("!", x - 1, y - 2, 0)
      elseif n.type == "event" then print("?", x - 2, y - 2, 0)
      elseif n.type == "shop" then print("$", x - 2, y - 2, 0)
      elseif n == cur then print("*", x - 2, y - 2, 0) end
      if col == cur.col + 1 and row == GAME.sel_row - 1 then circb(x, y, 8, 15) end
    end
  end
  print("SECTOR " .. (cur.col + 1) .. "/" .. CFG.columns, 4, 104, 5)
  print("UP/DOWN TARGET   Z JUMP   X SHIP", 4, 112, 7)
  draw_hud()
end

local function room_rect(i)
  local x = 4 + ((i - 1) % 3) * 60
  local y = 32 + math.floor((i - 1) / 3) * 44
  return x, y, 56, 38
end

local function draw_ship()
  draw_stars()
  for i = 1, #WORLD.systems do
    local s = WORLD.systems[i]
    local def = SYSTEMS[i]
    local x, y, w, h = room_rect(i)
    local fill = i == GAME.sel_room and 1 or 0
    rect(x, y, w, h, fill)
    rectb(x, y, w, h, i == GAME.sel_room and 15 or 5)
    print(def.name, x + 3, y + 3, def.col)
    for p = 1, def.max do
      rect(x + 3 + (p - 1) * 7, y + 12, 5, 4, p <= s.power and def.col or 1)
    end
    if s.damage > 0 then
      print("DMG " .. math.floor(s.damage * 100) .. "%", x + 30, y + 3, 2)
    end
    local list = crew_in_room(i)
    for k = 1, #list do
      local c = WORLD.crew[list[k]]
      circ(x + 8 + (k - 1) * 9, y + 27, 3, c.hp > 0 and 14 or 1)
    end
    if GAME.carry and WORLD.crew[GAME.carry].room == 0 then
      circ(x + 45, y + 27, 3, 15)
    end
  end
  if WORLD.enemy then
    local e = WORLD.enemy
    rect(184, 32, 52, 84, 0)
    rectb(184, 32, 52, 84, 2)
    print("ENEMY", 190, 36, 2)
    rect(190, 46, 40, 5, 1)
    rect(190, 46, math.floor(40 * e.hull / e.max_hull), 5, 2)
    print("HULL", 190, 54, 7)
    rect(190, 64, 40, 5, 1)
    rect(190, 64, math.floor(40 * e.shield / e.max_shield), 5, 11)
    print("SHLD", 190, 72, 7)
    circ(210, 92, 8, 4)
    line(202, 92, 218, 92, 15)
    print("A FIRE", 190, 104, 10)
  end
  print("LEFT/RIGHT ROOM   UP/DOWN POWER   Z CREW   X MAP", 4, 112, 7)
  draw_hud()
end

local function draw_event()
  local e = GAME.event
  if not e then draw_map() return end
  draw_stars()
  rect(20, 28, 200, 78, 0)
  rectb(20, 28, 200, 78, 12)
  center_text(e.title, 36, 12, 1)
  print(e.text, 30, 52, 7)
  print(e.a, 30, 68, 10)
  print(e.b, 30, 82, 5)
  print("Z CHOOSE FIRST   X CHOOSE SECOND", 30, 96, 5)
  draw_hud()
end

local function draw_title()
  draw_stars()
  center_text(CFG.title, 16, 11, 2)
  center_text(CFG.sub, 38, 7, 1)
  center_text("JUMP SECTOR TO SECTOR. KEEP THE SHIP ALIVE.", 54, 5, 1)
  center_text("POWER SYSTEMS. MOVE CREW. FIGHT HOSTILES.", 66, 5, 1)
  center_text("Z CONFIRM   X SHIP/MAP   A FIRE", 80, 15, 1)
  center_text("ARROWS NAVIGATE", 90, 15, 1)
  center_text("PRESS Z TO LAUNCH", 110, 10, 1)
  center_text(CFG.by, 128, 5, 1)
end

local function draw_end(win)
  draw_stars()
  center_text(win and "SECTOR CLEARED" or "SHIP LOST", 30, win and 10 or 2, 2)
  center_text(GAME.reason, 56, 7, 1)
  center_text("SCRAP: " .. WORLD.scrap .. "   FUEL: " .. WORLD.fuel, 70, 5, 1)
  center_text("PRESS Z TO LAUNCH AGAIN", 92, 10, 1)
end

function reset_game()
  math.randomseed(4242)
  GAME.state = CFG.start_title and "title" or "play"
  GAME.screen = "map"
  GAME.t = 0
  GAME.msg = ""
  GAME.msg_t = 0
  GAME.reason = ""
  GAME.shake = 0
  GAME.sel_row = 2
  GAME.sel_room = 1
  GAME.carry = nil
  GAME.fire_cd = 0
  GAME.event = nil
  WORLD.hull = CFG.hull_max
  WORLD.fuel = 10
  WORLD.scrap = 10
  WORLD.oxygen = CFG.oxygen_max
  WORLD.shield = 0
  WORLD.shield_max = 0
  WORLD.enemy = nil
  WORLD.systems = {}
  local initial = { 1, 2, 2, 1, 1, 1 }
  for i = 1, #SYSTEMS do
    WORLD.systems[i] = { power = initial[i], damage = 0 }
  end
  WORLD.crew = {}
  for i = 1, #CREW_NAMES do
    WORLD.crew[i] = { name = CREW_NAMES[i], skill = CREW_SKILL[i], room = i, hp = 100 }
  end
  gen_nodes()
  WORLD.current = node_at(0, 1)
  msg("CHOOSE A JUMP LANE")
end

function TIC()
  GAME.t = GAME.t + 1
  if GAME.msg_t > 0 then GAME.msg_t = GAME.msg_t - 1 end
  if GAME.state == "title" then
    if btnp(INPUT.confirm) or btnp(INPUT.back) then
      reset_game()
      GAME.state = "play"
    end
    draw_title()
  elseif GAME.state == "play" then
    if GAME.screen == "map" then
      update_map()
      draw_map()
    elseif GAME.screen == "event" then
      update_event()
      draw_event()
    else
      update_ship()
      draw_ship()
    end
  elseif GAME.state == "win" or GAME.state == "lose" then
    if btnp(INPUT.confirm) then
      reset_game()
      GAME.state = "play"
    end
    draw_end(GAME.state == "win")
  end
end

reset_game()
