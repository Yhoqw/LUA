WORDS = {}
WORD_COUNT = 0
for w in string.gmatch(WORD_LIST, "%a+") do
  if not WORDS[w] then
    WORDS[w] = true
    WORD_COUNT = WORD_COUNT + 1
  end
end

GAME = {}
WORLD = {}

local function clamp(v, a, b)
  if v < a then return a end
  if v > b then return b end
  return v
end

local function text_w(s, scale)
  return #s * 6 * (scale or 1)
end

local function center_text(s, y, col, scale)
  print(s, math.floor((CFG.sw - text_w(s, scale)) / 2), y, col, scale)
end

local function msg(s)
  GAME.msg = s
  GAME.msg_t = 100
end

local function random_letter()
  local i = math.random(#LETTER_BAG)
  return string.sub(LETTER_BAG, i, i)
end

local function new_tile()
  return { ch = random_letter(), pop = 0 }
end

local function count_vowels()
  local n = 0
  for y = 1, CFG.gh do
    for x = 1, CFG.gw do
      if VOWELS[WORLD.grid[y][x].ch] then n = n + 1 end
    end
  end
  return n
end

local function fill_board()
  repeat
    WORLD.grid = {}
    for y = 1, CFG.gh do
      WORLD.grid[y] = {}
      for x = 1, CFG.gw do WORLD.grid[y][x] = new_tile() end
    end
  until count_vowels() >= 14
end

local function tile_at(x, y)
  return WORLD.grid[y][x]
end

local function selected_index(x, y)
  for i = 1, #WORLD.sel do
    local s = WORLD.sel[i]
    if s[1] == x and s[2] == y then return i end
  end
  return nil
end

local function selected_word()
  local out = ""
  for i = 1, #WORLD.sel do
    local s = WORLD.sel[i]
    out = out .. tile_at(s[1], s[2]).ch
  end
  return out
end

local function adjacent(ax, ay, bx, by)
  return math.abs(ax - bx) + math.abs(ay - by) == 1
end

local function clear_selection()
  WORLD.sel = {}
end

local function toggle_select(x, y)
  local i = selected_index(x, y)
  if i then
    if i == #WORLD.sel then
      table.remove(WORLD.sel)
    else
      clear_selection()
    end
    return
  end
  if #WORLD.sel >= 7 then
    msg("MAX 7 LETTERS")
    return
  end
  if #WORLD.sel > 0 then
    local last = WORLD.sel[#WORLD.sel]
    if not adjacent(last[1], last[2], x, y) then
      msg("MUST TOUCH THE LAST LETTER")
      return
    end
  end
  WORLD.sel[#WORLD.sel + 1] = { x, y }
end

local function count_letters(word)
  local v, c, r = 0, 0, 0
  for i = 1, #word do
    local ch = string.sub(word, i, i)
    if VOWELS[ch] then
      v = v + 1
    elseif RARE[ch] then
      r = r + 1
    else
      c = c + 1
    end
  end
  return v, c, r
end

local function spawn_fx(x, y, col)
  for i = 1, 4 do
    WORLD.fx[#WORLD.fx + 1] = {
      x = x, y = y,
      vx = (math.random() - 0.5) * 1.8,
      vy = -math.random() * 1.4,
      life = 16 + math.random(12),
      col = col,
    }
  end
end

local function update_fx()
  for i = #WORLD.fx, 1, -1 do
    local f = WORLD.fx[i]
    f.x = f.x + f.vx
    f.y = f.y + f.vy
    f.vy = f.vy + 0.06
    f.life = f.life - 1
    if f.life <= 0 then table.remove(WORLD.fx, i) end
  end
end

local function draw_fx()
  for i = 1, #WORLD.fx do
    local f = WORLD.fx[i]
    rect(math.floor(f.x), math.floor(f.y), 1, 1, f.col)
  end
end

local function check_end()
  if WORLD.pop <= 0 then
    GAME.state = "lose"
    GAME.reason = "THE SETTLEMENT EMPTIED"
  elseif GAME.turn > CFG.max_turn then
    GAME.state = "lose"
    GAME.reason = "THE LEDGER CLOSED"
  elseif WORLD.pop >= CFG.win_pop and #WORLD.structures >= CFG.win_build then
    GAME.state = "win"
    GAME.reason = "A TOWN OF WORDS"
  end
end

local function resolve_threat()
  local t = THREATS[math.random(#THREATS)]
  local have = WORLD[t.res]
  if have >= t.cost then
    WORLD[t.res] = have - t.cost
    msg("THREAT " .. t.name .. " PAID " .. t.cost .. " " .. string.upper(t.res))
  elseif t.penalty == "pop" then
    WORLD.pop = math.max(0, WORLD.pop - t.amount)
    msg("THREAT " .. t.name .. " -" .. t.amount .. " POP")
  elseif t.penalty == "build" then
    if #WORLD.structures > 0 then
      table.remove(WORLD.structures)
      msg("THREAT " .. t.name .. " -1 BUILDING")
    else
      WORLD.pop = math.max(0, WORLD.pop - 2)
      msg("THREAT " .. t.name .. " -2 POP")
    end
  else
    WORLD.food = math.max(0, WORLD.food - t.amount)
    msg("THREAT " .. t.name .. " -" .. t.amount .. " FOOD")
  end
end

local function advance_turn()
  GAME.turn = GAME.turn + 1
  for i = 1, #WORLD.structures do
    local d = STRUCTURES[WORLD.structures[i].tier]
    WORLD.food = WORLD.food + d.food
    WORLD.wood = WORLD.wood + d.wood
    WORLD.gold = WORLD.gold + d.gold
  end
  local eat = math.max(1, math.floor(WORLD.pop / 3))
  WORLD.food = WORLD.food - eat
  if WORLD.food < 0 then
    WORLD.food = 0
    WORLD.pop = math.max(0, WORLD.pop - 2)
    msg("STARVATION -2 POP")
  end
  GAME.threat_t = GAME.threat_t + 1
  if GAME.threat_t >= CFG.threat_every then
    GAME.threat_t = 0
    resolve_threat()
  end
  check_end()
end

local function resolve_word(word)
  if #word < 3 then
    msg("NEED AT LEAST 3 LETTERS")
    return
  end
  if not WORDS[word] then
    msg("NOT IN THE LEDGER")
    return
  end
  local v, c, r = count_letters(word)
  local tier = math.min(#word, 7)
  WORLD.pop = WORLD.pop + math.max(1, math.floor(#word / 2))
  WORLD.food = WORLD.food + v + 1
  WORLD.wood = WORLD.wood + c
  WORLD.gold = WORLD.gold + r * 2
  WORLD.structures[#WORLD.structures + 1] = { tier = tier, word = word }
  GAME.last_word = word
  GAME.last_gain = "+" .. (v + 1) .. "F +" .. c .. "W +" .. (r * 2) .. "G"
  for i = 1, #WORLD.sel do
    local s = WORLD.sel[i]
    local t = tile_at(s[1], s[2])
    spawn_fx(CFG.gx + (s[1] - 1) * CFG.cell + 5, CFG.gy + (s[2] - 1) * CFG.cell + 5, 4)
    t.ch = random_letter()
    t.pop = 14
  end
  clear_selection()
  msg("FORMED " .. word .. "  " .. GAME.last_gain)
  if #word == 7 then
    GAME.state = "win"
    GAME.reason = "THE SEVEN-LETTER CHARTER"
    return
  end
  advance_turn()
end

local function sow_tile(x, y)
  if WORLD.food < 1 then
    msg("NEED 1 FOOD TO SOW")
    return
  end
  WORLD.food = WORLD.food - 1
  local t = tile_at(x, y)
  t.ch = random_letter()
  t.pop = 10
  clear_selection()
  spawn_fx(CFG.gx + (x - 1) * CFG.cell + 5, CFG.gy + (y - 1) * CFG.cell + 5, 11)
  msg("SOWED A NEW LETTER")
end

function reset_game()
  math.randomseed(4319)
  GAME.state = CFG.start_title and "title" or "play"
  GAME.t = 0
  GAME.turn = 1
  GAME.threat_t = 0
  GAME.last_word = ""
  GAME.last_gain = ""
  GAME.msg = ""
  GAME.msg_t = 0
  GAME.reason = ""
  WORLD.pop = CFG.start_pop
  WORLD.food = CFG.start_food
  WORLD.wood = CFG.start_wood
  WORLD.gold = CFG.start_gold
  WORLD.structures = {}
  WORLD.sel = {}
  WORLD.fx = {}
  WORLD.cursor = { x = 4, y = 4 }
  fill_board()
  msg("PICK LETTERS. FORM A WORD.")
end

local function update_title()
  if btnp(INPUT.pick) or btnp(INPUT.form) then
    reset_game()
    GAME.state = "play"
  end
end

local function update_play()
  local c = WORLD.cursor
  if btnp(INPUT.up) then c.y = clamp(c.y - 1, 1, CFG.gh) end
  if btnp(INPUT.down) then c.y = clamp(c.y + 1, 1, CFG.gh) end
  if btnp(INPUT.left) then c.x = clamp(c.x - 1, 1, CFG.gw) end
  if btnp(INPUT.right) then c.x = clamp(c.x + 1, 1, CFG.gw) end
  if btnp(INPUT.pick) then toggle_select(c.x, c.y) end
  if btnp(INPUT.form) then resolve_word(selected_word()) end
  if btnp(INPUT.clear) then
    clear_selection()
    msg("SELECTION CLEARED")
  end
  if btnp(INPUT.sow) then sow_tile(c.x, c.y) end
  for y = 1, CFG.gh do
    for x = 1, CFG.gw do
      local t = WORLD.grid[y][x]
      if t.pop > 0 then t.pop = t.pop - 1 end
    end
  end
end

local function draw_hud()
  rect(0, 0, 240, 24, 0)
  line(0, 24, 239, 24, 5)
  print(CFG.title, 4, 4, 7)
  print("TURN " .. GAME.turn .. "/" .. CFG.max_turn, 150, 4, 5)
  print("POP " .. WORLD.pop .. "/" .. CFG.win_pop, 4, 12, 10)
  print("BUILD " .. #WORLD.structures .. "/" .. CFG.win_build, 80, 12, 10)
  print("THREAT " .. (CFG.threat_every - GAME.threat_t), 150, 12, 8)
end

local function draw_board()
  local bx, by = CFG.gx, CFG.gy
  rect(bx - 3, by - 3, CFG.gw * CFG.cell + 6, CFG.gh * CFG.cell + 6, 0)
  rectb(bx - 3, by - 3, CFG.gw * CFG.cell + 6, CFG.gh * CFG.cell + 6, 5)
  for y = 1, CFG.gh do
    for x = 1, CFG.gw do
      local px = bx + (x - 1) * CFG.cell
      local py = by + (y - 1) * CFG.cell
      local t = WORLD.grid[y][x]
      local sel = selected_index(x, y)
      local fill = (x + y) % 2 == 0 and 1 or 8
      local lcol = VOWELS[t.ch] and 11 or (RARE[t.ch] and 4 or 7)
      if sel then
        fill = 4
        lcol = 0
      end
      rect(px, py, 9, 9, fill)
      rectb(px, py, 9, 9, sel and 15 or 5)
      print(t.ch, px + 2, py + 2, lcol)
      if t.pop > 0 then rectb(px, py, 9, 9, 7) end
    end
  end
  for i = 2, #WORLD.sel do
    local a = WORLD.sel[i - 1]
    local b = WORLD.sel[i]
    line(
      CFG.gx + (a[1] - 1) * CFG.cell + 4,
      CFG.gy + (a[2] - 1) * CFG.cell + 4,
      CFG.gx + (b[1] - 1) * CFG.cell + 4,
      CFG.gy + (b[2] - 1) * CFG.cell + 4,
      4
    )
  end
  local cx = CFG.gx + (WORLD.cursor.x - 1) * CFG.cell
  local cy = CFG.gy + (WORLD.cursor.y - 1) * CFG.cell
  rectb(cx - 1, cy - 1, 11, 11, 12)
end

local function draw_panel()
  rect(80, 26, 156, 70, 0)
  rectb(80, 26, 156, 70, 5)
  print("SETTLEMENT", 84, 29, 7)
  print("POP " .. WORLD.pop .. "/" .. CFG.win_pop, 84, 37, 10)
  print("BUILD " .. #WORLD.structures .. "/" .. CFG.win_build, 150, 37, 10)
  print("FOOD " .. WORLD.food, 84, 45, 11)
  print("WOOD " .. WORLD.wood, 124, 45, 10)
  print("GOLD " .. WORLD.gold, 164, 45, 4)
  print("STRUCTURES", 84, 55, 7)
  if #WORLD.structures == 0 then
    print("NONE YET", 84, 63, 15)
  else
    local start = math.max(1, #WORLD.structures - 2)
    for i = start, #WORLD.structures do
      local s = WORLD.structures[i]
      local d = STRUCTURES[s.tier]
      print(d.name .. " " .. s.word, 84, 63 + (i - start) * 8, d.col)
    end
  end
  print("THREAT IN " .. (CFG.threat_every - GAME.threat_t), 84, 88, 8)
end

local function draw_bottom()
  rect(0, 100, 240, 36, 0)
  line(0, 100, 239, 100, 5)
  local word = selected_word()
  print("WORD " .. (word == "" and "..." or word), 4, 104, 7)
  if #word >= 3 then
    if WORDS[word] then
      print("VALID", 190, 104, 11)
    else
      print("NOT IN LEDGER", 154, 104, 8)
    end
  end
  print("LAST " .. (GAME.last_word == "" and "NONE" or GAME.last_word) .. " " .. GAME.last_gain, 4, 112, 5)
  print("Z PICK  X FORM  A CLEAR  B SOW", 4, 120, 5)
  print(GAME.msg, 4, 128, 8)
end

local function draw_game()
  cls(0)
  draw_hud()
  draw_board()
  draw_panel()
  draw_bottom()
  draw_fx()
end

local function draw_title()
  cls(0)
  for i = 1, 36 do
    local ch = string.sub(LETTER_BAG, (i * 17) % #LETTER_BAG + 1, (i * 17) % #LETTER_BAG + 1)
    local x = (i * 53) % 230
    local y = 4 + (i * 31) % 124
    print(ch, x, y, i % 3 == 0 and 1 or 8)
  end
  center_text(CFG.title, 12, 4, 2)
  center_text(CFG.sub, 34, 7, 1)
  center_text("WORDS ARE PEOPLE.", 48, 11, 1)
  center_text("JOIN ADJACENT LETTERS INTO WORDS.", 58, 5, 1)
  center_text("WORDS BECOME BUILDINGS AND RESOURCES.", 66, 5, 1)
  center_text("KEEP FOOD UP. SURVIVE THE THREATS.", 76, 5, 1)
  center_text("FOUND A TOWN OF 20 PEOPLE", 86, 10, 1)
  center_text("AND 3 BUILDINGS.", 94, 10, 1)
  center_text("OR SPELL A 7-LETTER CHARTER.", 104, 4, 1)
  center_text("Z PICK  X FORM  A CLEAR  B SOW", 114, 7, 1)
  center_text("PRESS Z TO BEGIN", 124, 10, 1)
  center_text(CFG.by .. "  LEDGER " .. WORD_COUNT, 132, 5, 1)
end

local function draw_end(win)
  cls(0)
  for i = 1, 40 do
    local ch = string.sub(LETTER_BAG, (i * 13) % #LETTER_BAG + 1, (i * 13) % #LETTER_BAG + 1)
    local x = (i * 47) % 232
    local y = (i * 29) % 132
    print(ch, x, y, win and 10 or 8)
  end
  center_text(win and "A TOWN OF WORDS" or "THE LEDGER CLOSED", 24, win and 10 or 8, 2)
  center_text(GAME.reason, 48, 7, 1)
  center_text("TURN " .. math.min(GAME.turn, CFG.max_turn) .. "   POP " .. WORLD.pop .. "   BUILD " .. #WORLD.structures, 64, 12, 1)
  if win then
    center_text("THE SETTLEMENT IS FOUNDED.", 82, 11, 1)
    center_text("THE LETTERS HOLD.", 90, 11, 1)
  else
    center_text("THE LETTERS SCATTER.", 82, 8, 1)
  end
  center_text("PRESS Z TO BEGIN AGAIN", 108, 10, 1)
end

function TIC()
  GAME.t = GAME.t + 1
  if GAME.state == "title" then
    update_title()
    draw_title()
  elseif GAME.state == "play" then
    update_play()
    draw_game()
  elseif GAME.state == "win" then
    if btnp(INPUT.pick) or btnp(INPUT.form) then reset_game(); GAME.state = "play" end
    draw_end(true)
  elseif GAME.state == "lose" then
    if btnp(INPUT.pick) or btnp(INPUT.form) then reset_game(); GAME.state = "play" end
    draw_end(false)
  end
  if GAME.msg_t > 0 then GAME.msg_t = GAME.msg_t - 1 end
  update_fx()
end

reset_game()
