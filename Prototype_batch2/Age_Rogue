CFG = {
  title = "AGE ROGUE", sub = "A DYNASTY IN TWENTY TURNS", by = "YAZDAN ALI KHAN",
  sw = 240, sh = 136, map_w = 24, map_h = 14, ts = 8,
  max_turns = 20, start_title = true, win_cities = 6,
}

INPUT = { up = 0, down = 1, left = 2, right = 3, act = 4, found = 5, end_turn = 6 }

GAME = {}
WORLD = {}

local function clamp(v, a, b)
  if v < a then return a end
  if v > b then return b end
  return v
end

local function center_text(s, y, col, scale)
  print(s, math.floor((CFG.sw - #s * 6 * (scale or 1)) / 2), y, col, scale)
end

local function msg(s)
  GAME.msg = s
  GAME.msg_t = 150
end

local function key(x, y)
  return y * 100 + x
end

local function get_tile(x, y)
  if x < 1 or y < 1 or x > CFG.map_w or y > CFG.map_h then return "~" end
  return string.sub(WORLD.tiles[y], x, x)
end

local function set_tile(x, y, ch)
  local row = WORLD.tiles[y]
  WORLD.tiles[y] = string.sub(row, 1, x - 1) .. ch .. string.sub(row, x + 1)
end

local function passable(x, y)
  local t = get_tile(x, y)
  return t ~= "~" and t ~= "^"
end

local function city_at(x, y)
  for i = 1, #WORLD.cities do
    local c = WORLD.cities[i]
    if c.x == x and c.y == y then return c end
  end
  return nil
end

local function army_at(x, y)
  for i = 1, #WORLD.ai_armies do
    local a = WORLD.ai_armies[i]
    if a.x == x and a.y == y then return i end
  end
  return nil
end

local function player_city_count()
  local n = 0
  for i = 1, #WORLD.cities do
    if WORLD.cities[i].owner == "player" then n = n + 1 end
  end
  return n
end

local function ai_capital_count()
  local n = 0
  for i = 1, #WORLD.cities do
    local c = WORLD.cities[i]
    if c.capital and c.owner ~= "player" then n = n + 1 end
  end
  return n
end

local function add_city(x, y, owner, capital, name, defense)
  set_tile(x, y, ".")
  WORLD.cities[#WORLD.cities + 1] = {
    x = x, y = y, owner = owner, capital = capital,
    name = name, defense = defense or 2,
  }
end

local function gen_map()
  WORLD.tiles = {}
  for y = 1, CFG.map_h do
    local row = ""
    for x = 1, CFG.map_w do
      local r = math.random()
      local ch = "."
      if r < 0.10 then ch = "~"
      elseif r < 0.20 then ch = "f"
      elseif r < 0.27 then ch = "^" end
      row = row .. ch
    end
    WORLD.tiles[y] = row
  end
  for y = 1, CFG.map_h do set_tile(12, y, ".") end
  for x = 1, CFG.map_w do set_tile(x, 7, ".") end
  WORLD.cities = {}
  add_city(2, 7, "player", true, "HOME", 4)
  add_city(22, 1, "ai1", true, "RED KEEP", 4)
  add_city(22, 12, "ai2", true, "SALT HOLD", 4)
  add_city(1, 12, "ai3", true, "IRON GATE", 4)
  add_city(12, 1, "ai4", true, "HIGH SPIRE", 4)
  add_city(12, 7, "neutral", false, "CROSSROADS", 2)
  add_city(18, 10, "neutral", false, "MILL", 2)
  WORLD.ai_armies = {}
end

local function win_game()
  GAME.state = "win"
  GAME.reason = "A NEW AGE DAWNS"
  if not GAME.legacy_awarded then
    GAME.legacy_awarded = true
    GAME.legacy_gain = 20 + player_city_count() * 2
    GAME.meta_legacy = GAME.meta_legacy + GAME.legacy_gain
  end
end

local function lose_game(reason)
  GAME.state = "lose"
  GAME.reason = reason
  if not GAME.legacy_awarded then
    GAME.legacy_awarded = true
    GAME.legacy_gain = 5 + player_city_count()
    GAME.meta_legacy = GAME.meta_legacy + GAME.legacy_gain
  end
end

local function check_win()
  if player_city_count() >= CFG.win_cities or ai_capital_count() == 0 then
    win_game()
  end
end

local function respawn_army()
  local cap = WORLD.cities[1]
  WORLD.army.x, WORLD.army.y = cap.x, cap.y
  WORLD.army.strength = math.max(1, WORLD.army.strength)
  msg("THE ARMY REGROUPS AT HOME")
end

local function fight_ai(index)
  local a = WORLD.ai_armies[index]
  local p = WORLD.army
  if p.strength >= a.strength then
    p.strength = math.max(1, p.strength - 1)
    table.remove(WORLD.ai_armies, index)
    msg("ENEMY ARMY BROKEN")
  else
    p.strength = p.strength - 1
    a.strength = math.max(1, a.strength - 1)
    if p.strength <= 0 then
      p.strength = 1
      respawn_army()
    end
    msg("THE ARMY FALLS BACK")
  end
end

local function attack_city(c)
  local p = WORLD.army
  local defense = c.defense + (c.capital and 2 or 0)
  if p.strength + math.random(0, 2) >= defense then
    c.owner = "player"
    c.defense = math.max(1, c.defense - 1)
    p.strength = math.max(1, p.strength - 1)
    p.moves = 0
    msg(c.name .. " TAKEN")
    check_win()
  else
    p.strength = p.strength - 1
    p.moves = 0
    if p.strength <= 0 then
      p.strength = 1
      respawn_army()
    end
    msg("THE WALLS HOLD")
  end
end

local function move_army(dx, dy)
  local p = WORLD.army
  if GAME.state ~= "play" then return end
  if p.moves <= 0 then
    msg("NO MOVES LEFT. END TURN.")
    return
  end
  local nx, ny = p.x + dx, p.y + dy
  if not passable(nx, ny) then
    msg("IMPASSABLE TERRAIN")
    return
  end
  local ai = army_at(nx, ny)
  if ai then
    fight_ai(ai)
    p.moves = p.moves - 1
    return
  end
  local c = city_at(nx, ny)
  if c then
    if c.owner == "player" then
      p.x, p.y = nx, ny
      p.moves = p.moves - 1
    elseif c.owner == "neutral" then
      c.owner = "player"
      c.defense = math.max(1, c.defense - 1)
      p.x, p.y = nx, ny
      p.moves = p.moves - 1
      msg(c.name .. " JOINED THE REALM")
      check_win()
    else
      attack_city(c)
    end
    return
  end
  p.x, p.y = nx, ny
  p.moves = p.moves - 1
end

local function reinforce()
  local p = WORLD.army
  local cap = WORLD.cities[1]
  if p.x ~= cap.x or p.y ~= cap.y then
    msg("RETURN HOME TO REINFORCE")
    return
  end
  if p.strength >= 10 then
    msg("THE ARMY IS AT FULL STRENGTH")
    return
  end
  if WORLD.gold < 10 then
    msg("NEED 10 GOLD")
    return
  end
  WORLD.gold = WORLD.gold - 10
  p.strength = p.strength + 1
  msg("ARMY REINFORCED")
end

local function found_city()
  local p = WORLD.army
  if city_at(p.x, p.y) then
    msg("A CITY ALREADY STANDS HERE")
    return
  end
  if get_tile(p.x, p.y) == "~" or get_tile(p.x, p.y) == "^" then
    msg("CANNOT FOUND HERE")
    return
  end
  if WORLD.gold < 12 then
    msg("NEED 12 GOLD TO FOUND")
    return
  end
  WORLD.gold = WORLD.gold - 12
  add_city(p.x, p.y, "player", false, "NEW HOLD", 2)
  msg("A NEW HOLD IS FOUNDED")
  check_win()
end

local function next_step(sx, sy, tx, ty)
  local q = { { sx, sy } }
  local prev = {}
  prev[key(sx, sy)] = { sx, sy }
  local head = 1
  while head <= #q do
    local x, y = q[head][1], q[head][2]
    head = head + 1
    if x == tx and y == ty then break end
    local dirs = { { 1, 0 }, { -1, 0 }, { 0, 1 }, { 0, -1 } }
    for i = 1, 4 do
      local nx, ny = x + dirs[i][1], y + dirs[i][2]
      if passable(nx, ny) and not prev[key(nx, ny)] then
        prev[key(nx, ny)] = { x, y }
        q[#q + 1] = { nx, ny }
      end
    end
  end
  if not prev[key(tx, ty)] then return nil end
  local cx, cy = tx, ty
  while true do
    local p = prev[key(cx, cy)]
    if p[1] == sx and p[2] == sy then return cx, cy end
    cx, cy = p[1], p[2]
  end
end

local function ai_attack_city(c, a)
  local defense = c.defense + (c.capital and 2 or 0)
  if a.strength >= defense then
    c.owner = a.owner
    c.defense = 1
    if c.capital and c.x == 2 and c.y == 7 then
      lose_game("THE CAPITAL HAS FALLEN")
    end
  else
    c.defense = math.max(1, c.defense - 1)
  end
end

local function update_ai()
  local cap = WORLD.cities[1]
  if cap.owner ~= "player" then
    lose_game("THE CAPITAL HAS FALLEN")
    return
  end
  if GAME.turn % 3 == 0 then
    for i = 1, #WORLD.cities do
      local c = WORLD.cities[i]
      if c.owner:sub(1, 2) == "ai" then
        WORLD.ai_armies[#WORLD.ai_armies + 1] = {
          x = c.x, y = c.y, owner = c.owner,
          strength = 2 + math.floor(GAME.turn / 5),
        }
      end
    end
  end
  for i = #WORLD.ai_armies, 1, -1 do
    local a = WORLD.ai_armies[i]
    local nx, ny = next_step(a.x, a.y, cap.x, cap.y)
    if nx and ny then
      if WORLD.army.x == nx and WORLD.army.y == ny then
        if WORLD.army.strength >= a.strength then
          WORLD.army.strength = math.max(1, WORLD.army.strength - 1)
          table.remove(WORLD.ai_armies, i)
        else
          WORLD.army.strength = WORLD.army.strength - 1
          a.strength = math.max(1, a.strength - 1)
          if WORLD.army.strength <= 0 then WORLD.army.strength = 1; respawn_army() end
        end
      else
        local c = city_at(nx, ny)
        if c and c.owner == "player" then
          ai_attack_city(c, a)
          table.remove(WORLD.ai_armies, i)
        else
          a.x, a.y = nx, ny
        end
      end
    end
    if GAME.state ~= "play" then return end
  end
end

local function end_turn()
  if GAME.state ~= "play" then return end
  GAME.turn = GAME.turn + 1
  if GAME.turn > CFG.max_turns then
    lose_game("THE AGE ENDS")
    return
  end
  local income = player_city_count() * 2
  WORLD.gold = WORLD.gold + income
  WORLD.army.moves = 2
  update_ai()
  if GAME.state == "play" then msg("TURN " .. GAME.turn .. "  +" .. income .. " GOLD") end
end

local function update_play()
  if btnp(INPUT.up) then move_army(0, -1) end
  if btnp(INPUT.down) then move_army(0, 1) end
  if btnp(INPUT.left) then move_army(-1, 0) end
  if btnp(INPUT.right) then move_army(1, 0) end
  if btnp(INPUT.act) then reinforce() end
  if btnp(INPUT.found) then found_city() end
  if btnp(INPUT.end_turn) then end_turn() end
end

local function draw_tile(x, y, ch)
  local px, py = (x - 1) * CFG.ts, 18 + (y - 1) * CFG.ts
  if ch == "~" then
    rect(px, py, 8, 8, 1)
    rect(px + 1, py + 5, 3, 1, 8)
    rect(px + 4, py + 2, 3, 1, 8)
  elseif ch == "^" then
    rect(px, py, 8, 8, 5)
    tri(px + 1, py + 7, px + 4, py + 1, px + 7, py + 7, 10)
    tri(px + 3, py + 7, px + 4, py + 4, px + 6, py + 7, 15)
  elseif ch == "f" then
    rect(px, py, 8, 8, 3)
    circ(px + 3, py + 4, 2, 2)
    circ(px + 6, py + 5, 2, 4)
    rect(px + 4, py + 6, 1, 2, 5)
  else
    rect(px, py, 8, 8, (x + y) % 2 == 0 and 3 or 11)
    if (x * 7 + y * 3) % 13 == 0 then rect(px + 2, py + 2, 1, 1, 15) end
  end
end

local function draw_city(c)
  local px, py = (c.x - 1) * CFG.ts, 18 + (c.y - 1) * CFG.ts
  local col = c.owner == "player" and 12 or (c.owner == "neutral" and 7 or 2)
  rect(px + 1, py + 2, 6, 6, col)
  rectb(px + 1, py + 2, 6, 6, 15)
  rect(px + 2, py + 4, 1, 2, 0)
  rect(px + 5, py + 4, 1, 2, 0)
  if c.capital then
    line(px + 4, py + 2, px + 4, py, 10)
    tri(px + 4, py, px + 7, py + 1, px + 4, py + 2, 14)
  end
  print(tostring(c.defense), px + 3, py + 6, 0)
end

local function draw_army(a, col)
  local px, py = (a.x - 1) * CFG.ts + 4, 18 + (a.y - 1) * CFG.ts + 4
  circ(px, py, 4, col)
  circb(px, py, 4, 15)
  print(tostring(a.strength), px - 1, py - 3, 0)
end

local function draw_map()
  for y = 1, CFG.map_h do
    for x = 1, CFG.map_w do draw_tile(x, y, get_tile(x, y)) end
  end
  for i = 1, #WORLD.cities do draw_city(WORLD.cities[i]) end
  for i = 1, #WORLD.ai_armies do draw_army(WORLD.ai_armies[i], 2) end
  draw_army(WORLD.army, 12)
  rectb((WORLD.army.x - 1) * CFG.ts, 18 + (WORLD.army.y - 1) * CFG.ts, 8, 8, 15)
end

local function draw_hud()
  rect(0, 0, 240, 18, 0)
  line(0, 18, 239, 18, 5)
  print("AGE " .. (1 + math.floor((GAME.turn - 1) / 7)), 3, 3, 14)
  print("TURN " .. GAME.turn .. "/" .. CFG.max_turns, 52, 3, 7)
  print("GOLD " .. WORLD.gold, 116, 3, 10)
  print("CITIES " .. player_city_count() .. "/" .. CFG.win_cities, 170, 3, 11)
  rect(192, 18, 48, 118, 0)
  line(192, 18, 192, 135, 5)
  print("ARMY", 196, 24, 12)
  print("STR " .. WORLD.army.strength, 196, 34, 7)
  print("MOV " .. WORLD.army.moves, 196, 44, 7)
  print("HOME", 196, 58, 10)
  print("D" .. WORLD.cities[1].defense, 196, 68, 7)
  print("LEGACY", 196, 82, 14)
  print(tostring(GAME.meta_legacy), 196, 92, 7)
  print("Z REIN", 196, 104, 5)
  print("X FOUND", 196, 112, 5)
  print("A END", 196, 120, 5)
  if GAME.msg_t > 0 then
    rect(0, 130, 192, 6, 0)
    print(GAME.msg, 2, 131, 7)
  end
end

local function draw_game()
  cls(0)
  draw_map()
  draw_hud()
end

local function draw_title()
  cls(0)
  rect(0, 0, 240, 136, 0)
  for i = 1, 50 do
    local x = (i * 37) % 240
    local y = (i * 53) % 136
    rect(x, y, 1, 1, i % 4 == 0 and 10 or 5)
  end
  center_text(CFG.title, 16, 10, 2)
  center_text(CFG.sub, 38, 7, 1)
  center_text("TAKE SIX CITIES OR BREAK THE FOUR CAPITALS.", 52, 5, 1)
  center_text("MOVE THE ARMY. FOUND HOLDS. REINFORCE.", 64, 5, 1)
  center_text("ARROWS MOVE   Z REINFORCE   X FOUND   A END TURN", 78, 15, 1)
  center_text("LEGACY " .. GAME.meta_legacy, 92, 14, 1)
  center_text("PRESS Z TO BEGIN", 110, 10, 1)
  center_text(CFG.by, 128, 5, 1)
end

local function draw_end(win)
  cls(0)
  rect(0, 0, 240, 136, win and 1 or 0)
  for i = 1, 35 do
    rect((i * 41) % 240, (i * 29) % 136, 2, 2, win and 10 or 2)
  end
  center_text(win and "THE DYNASTY ENDURES" or "THE AGE CLOSES", 30, win and 10 or 2, 2)
  center_text(GAME.reason, 54, 7, 1)
  center_text("LEGACY GAINED: " .. GAME.legacy_gain, 70, 14, 1)
  center_text("TOTAL LEGACY: " .. GAME.meta_legacy, 82, 7, 1)
  center_text("PRESS Z TO BEGIN AGAIN", 104, 10, 1)
end

function reset_game()
  if GAME.meta_legacy == nil then GAME.meta_legacy = 0 end
  math.randomseed(1200 + GAME.meta_legacy)
  GAME.state = CFG.start_title and "title" or "play"
  GAME.t = 0
  GAME.turn = 1
  GAME.msg = ""
  GAME.msg_t = 0
  GAME.reason = ""
  GAME.legacy_gain = 0
  GAME.legacy_awarded = false
  gen_map()
  WORLD.gold = 10 + math.floor(GAME.meta_legacy / 10)
  WORLD.army = {
    x = WORLD.cities[1].x, y = WORLD.cities[1].y,
    strength = 3 + math.floor(GAME.meta_legacy / 15), moves = 2,
  }
  msg("MOVE THE ARMY. TAKE THE CROSSROADS.")
end

function TIC()
  GAME.t = GAME.t + 1
  if GAME.msg_t > 0 then GAME.msg_t = GAME.msg_t - 1 end
  if GAME.state == "title" then
    if btnp(INPUT.act) or btnp(INPUT.found) then
      reset_game()
      GAME.state = "play"
    end
    draw_title()
  elseif GAME.state == "play" then
    update_play()
    draw_game()
  elseif GAME.state == "win" or GAME.state == "lose" then
    if btnp(INPUT.act) then
      reset_game()
      GAME.state = "play"
    end
    draw_end(GAME.state == "win")
  end
end

reset_game()
