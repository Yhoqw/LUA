function draw_buildings(camx, camy)
  for _, b in ipairs(WORLD.buildings) do
    local x, y = b.x - camx, b.y - camy
    if x < 240 and x + b.w > 0 and y < 136 and y + b.h > 0 then
      rect(x + 3, y + 3, b.w, b.h, 0)
      rect(x, y, b.w, b.h, b.base)
      rect(x + 2, y + 2, b.w - 4, b.h - 4, b.roof)
      rectb(x, y, b.w, b.h, b.edge)
      rectb(x + 2, y + 2, b.w - 4, b.h - 4, b.edge)
      for py = y + 4, y + b.h - 4, 4 do
        rect(x + 3, py, b.w - 6, 1, 0)
      end
      rect(x + math.floor(b.w / 2) - 3, y + b.h - 8, 6, 8, 0)
      rectb(x + math.floor(b.w / 2) - 3, y + b.h - 8, 6, 8, b.edge)
      if b.w > 20 then
        rect(x + 4, y + b.h - 8, 4, 4, 10)
        rect(x + b.w - 8, y + b.h - 8, 4, 4, 10)
      end
      if b.sign ~= "" then
        local w = #b.sign * 6 + 4
        local sx = x + math.floor((b.w - w) / 2)
        rect(sx, y + 3, w, 9, 0)
        rectb(sx, y + 3, w, 9, b.edge)
        print(b.sign, x + math.floor((b.w - #b.sign * 6) / 2), y + 4, b.edge)
      end
      rect(x, y, b.w, 2, b.edge)
    end
  end
end

function draw_zones(camx, camy)
  for _, z in ipairs(WORLD.zones) do
    local x, y = z.x - camx, z.y - camy
    if x < 240 and x + z.w > 0 and y < 136 and y + z.h > 0 then
