  local mx, my, mw, mh = 184, 14, 52, 34
  local sx, sy = mw / CFG.ww, mh / CFG.wh
  rect(mx - 1, my - 1, mw + 2, mh + 2, 15)
  rect(mx, my, mw, mh, 0)
  rect(mx, my + math.floor(204 * sy), mw, 1, 4)
  rect(mx + math.floor(332 * sx), my, 1, mh, 4)
  rect(mx + math.floor(656 * sx), my + math.floor(384 * sy),
       math.max(1, math.floor(168 * sx)), math.max(1, math.floor(128 * sy)), 12)
  for _, b in ipairs(WORLD.buildings) do
    rect(mx + math.floor(b.x * sx), my + math.floor(b.y * sy),
         math.max(1, math.floor(b.w * sx)), math.max(1, math.floor(b.h * sy)), 4)
  end
  for _, e in ipairs(WORLD.outlaws) do
    if not e.dead then
      rect(mx + math.floor(e.x * sx), my + math.floor(e.y * sy), 2, 2, e.target and 10 or 8)
    end
  end
  for _, e in ipairs(WORLD.lawmen) do
    if not e.dead then
      rect(mx + math.floor(e.x * sx), my + math.floor(e.y * sy), 2, 2, 12)
    end
  end
  local h = WORLD.horse
  if h and not h.dead then
    rect(mx + math.floor(h.x * sx), my + math.floor(h.y * sy), 2, 2, 11)
  end
  if GAME.target then
    local tx = mx + math.floor(GAME.target.x * sx)
    local ty = my + math.floor(GAME.target.y * sy)
    if math.floor(GAME.t / 12) % 2 == 0 then rect(tx - 1, ty - 1, 3, 3, 10) end
  end
  local p = GAME.player
  rect(mx + math.floor(p.x * sx) - 1, my + math.floor(p.y * sy) - 1, 3, 3, 7)
end

