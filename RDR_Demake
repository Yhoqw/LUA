function init_title()
  TITLE.sky = {}
  local x = -4
  while x < 244 do
    local w = math.random(14, 32)
    local h = math.random(10, 36)
    table.insert(TITLE.sky, { x = x, w = w, h = h, seed = math.random(1, 99) })
    x = x + w + math.random(2, 8)
  end
end

function start_game()
  GAME.state = "play"
  if not GAME.bounty then new_bounty() end
end

function TIC()
  GAME.t = GAME.t + 1
  if GAME.state == "title" then
    draw_title()
    if btnp(INPUT.fire) or btnp(INPUT.use) then start_game() end
    return
  end
  if GAME.state == "dead" then
    GAME.dead_t = GAME.dead_t - 1
    update_effects()
    update_shake()
    update_camera()
    draw_game()
    draw_dead()
    if GAME.dead_t <= 0 then respawn() end
    return
  end
  update_play()
  draw_game()
end

