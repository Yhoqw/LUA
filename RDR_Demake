function draw_char(e, base, camx, camy, bob)
  local x, y = e.x - camx, e.y - camy + (bob or 0)
  if x > -16 and x < 256 and y > -16 and y < 152 then
    elli(x, y + 5, 4, 2, 0)
    spr(base + dir8(e.angle) * 2, math.floor(x) - 8, math.floor(y) - 8, 0, 1, false, 0, 2, 2)
