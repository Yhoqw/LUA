function draw_entities(camx, camy)
  for _, e in ipairs(WORLD.peds) do
    if not e.dead then
      draw_char(e, e.base, camx, camy, math.sin((GAME.t + e.step) * 0.2) * 0.6)
    end
  end
  for _, e in ipairs(WORLD.outlaws) do
    if not e.dead then
      draw_char(e, e.base, camx, camy, math.sin((GAME.t + e.step) * 0.2) * 0.6)
      if e.target then
        local x, y = e.x - camx, e.y - camy - 14 + math.sin(GAME.t * 0.15) * 2
        star(x, y, 10)
      end
    end
  end
  for _, e in ipairs(WORLD.lawmen) do
    if not e.dead then draw_char(e, e.base, camx, camy, 0) end
  end
  draw_horse(camx, camy)
  local p = GAME.player
  if not p.mounted and not p.dead then
    local bob = 0
    if p.moving then bob = math.sin(p.walk * 0.55) * 0.8 end
    draw_char(p, SPR.player, camx, camy, bob)
    if p.inv > 0 and math.floor(GAME.t / 2) % 2 == 0 then
      circb(p.x - camx, p.y - camy, 7, 7)
    end
  end
end

function draw_bullets(camx, camy)
