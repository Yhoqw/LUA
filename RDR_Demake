function draw_horse(camx, camy)
  local h = WORLD.horse
  if not h or h.dead then return end
  local x, y = h.x - camx, h.y - camy
  if x > -16 and x < 256 and y > -16 and y < 152 then
    elli(x, y + 6, 7, 3, 0)
    spr(SPR.horse + dir8(h.angle) * 2, math.floor(x) - 8, math.floor(y) - 8, 0, 1, false, 0, 2, 2)
    if GAME.player.mounted then
      circ(x, y - 1, 3, 6)
      line(x - 4, y - 1, x + 4, y - 1, 6)
      circ(x, y + 2, 2, 8)
    end
  end
