function tile_solid(id)
  return id == TILE.water or id == TILE.rock
end

function solid_tile_at(x, y)
  local tx = math.floor(x / CFG.ts)
  local ty = math.floor(y / CFG.ts)
  if tx < 0 or ty < 0 or tx >= CFG.ww / CFG.ts or ty >= CFG.wh / CFG.ts then return true end
  return tile_solid(mget(tx, ty))
end

function solid_at(x, y, r)
  if x - r < 0 or y - r < 0 or x + r > CFG.ww or y + r > CFG.wh then return true end
  if solid_tile_at(x, y) then return true end
  if solid_tile_at(x - r, y - r) or solid_tile_at(x + r, y - r) or
     solid_tile_at(x - r, y + r) or solid_tile_at(x + r, y + r) then
    return true
  end
  for _, b in ipairs(WORLD.buildings) do
    if x + r > b.x and x - r < b.x + b.w and y + r > b.y and y - r < b.y + b.h then
      return true
    end
  end
  for _, o in ipairs(WORLD.obstacles) do
    if dist(x, y, o.x, o.y) < r + o.r then return true end
  end
  return false
end

function move_actor(a, dx, dy, r)
  if dx ~= 0 and not solid_at(a.x + dx, a.y, r) then a.x = a.x + dx end
  if dy ~= 0 and not solid_at(a.x, a.y + dy, r) then a.y = a.y + dy end
end

function move_enemy(e, nx, ny)
  if not solid_at(nx, e.y, 4) then e.x = nx end
  if not solid_at(e.x, ny, 4) then e.y = ny end
end

function add_building(tx, ty, tw, th, pal, label)
  local b = {
    x = tx * CFG.ts, y = ty * CFG.ts,
    w = tw * CFG.ts, h = th * CFG.ts,
    base = pal.base, roof = pal.roof, edge = pal.edge,
    sign = label or "", seed = math.random(1, 999),
  }
  table.insert(WORLD.buildings, b)
  return b
end

function add_zone(name, x, y, w, h)
  table.insert(WORLD.zones, { name = name, x = x, y = y, w = w, h = h })
end

function zone_at(x, y)
  for _, z in ipairs(WORLD.zones) do
    if x > z.x and x < z.x + z.w and y > z.y and y < z.y + z.h then return z end
  end
  return nil
end

function find_desert_prop()
  for i = 1, 50 do
    local x = math.random(20, CFG.ww - 20)
    local y = math.random(20, CFG.wh - 20)
    local tx, ty = math.floor(x / CFG.ts), math.floor(y / CFG.ts)
    local in_town = tx >= 18 and tx <= 62 and ty >= 10 and ty <= 44
    if not in_town and not solid_at(x, y, 8) then return x, y end
  end
  return nil
end

function find_desert_spot(cx, cy, min_d, max_d)
  for i = 1, 140 do
    local x = math.random(40, CFG.ww - 40)
    local y = math.random(40, CFG.wh - 40)
    local d = dist(x, y, cx, cy)
    local tx, ty = math.floor(x / CFG.ts), math.floor(y / CFG.ts)
    local in_town = tx >= 18 and tx <= 62 and ty >= 10 and ty <= 44
    if d >= min_d and d <= max_d and not in_town and not solid_at(x, y, 6) then
      return x, y
    end
  end
  for i = 1, 200 do
    local x = math.random(40, CFG.ww - 40)
    local y = math.random(40, CFG.wh - 40)
    if not solid_at(x, y, 6) then return x, y end
  end
  return 60, 60
end

function find_town_spot()
  for i = 1, 90 do
    local tx = math.random(21, 59)
    local ty = math.random(13, 41)
    local x = tx * CFG.ts + 4
    local y = ty * CFG.ts + 4
    if not solid_at(x, y, 4) then return x, y end
  end
  return nil
end

