function clamp(v, lo, hi)
  if v < lo then return lo end
  if v > hi then return hi end
  return v
end

function sign(v)
  if v < 0 then return -1 end
  if v > 0 then return 1 end
  return 0
end

function atan2(y, x)
  if x > 0 then return math.atan(y / x) end
  if x < 0 then
    if y >= 0 then return math.atan(y / x) + math.pi end
    return math.atan(y / x) - math.pi
  end
  if y > 0 then return math.pi / 2 end
  if y < 0 then return -math.pi / 2 end
  return 0
end

function dist(ax, ay, bx, by)
  local dx, dy = ax - bx, ay - by
  return math.sqrt(dx * dx + dy * dy)
end

function dist2(ax, ay, bx, by)
  local dx, dy = ax - bx, ay - by
  return dx * dx + dy * dy
end

function dir8(a)
  return math.floor(((-math.pi / 2 - a) % (math.pi * 2)) / (math.pi / 4) + 0.5) % 8
end

function tw(s, sc)
  return #s * 6 * (sc or 1)
end

function center(s, y, c, sc)
  sc = sc or 1
  print(s, math.floor((CFG.sw - tw(s, sc)) / 2), y, c, false, sc)
end

function vclear(id)
  local a = 0x4000 + id * 32
  for i = 0, 31 do poke(a + i, 0) end
end

function vpx(id, x, y, c)
  local a = 0x4000 + id * 32 + y * 4 + math.floor(x / 2)
  local b = peek(a)
  if x % 2 == 0 then
    poke(a, b - b % 16 + c * 16)
  else
    poke(a, b - b % 16 + c)
  end
end

function vclear16(base)
  vclear(base)
  vclear(base + 1)
  vclear(base + 16)
  vclear(base + 17)
end

function vwrite16(base, g)
  vclear16(base)
  for y = 0, 15 do
    for x = 0, 15 do
      local c = g[y + 1][x + 1]
      if c and c > 0 then
        vpx(base + math.floor(x / 8) + math.floor(y / 8) * 16, x % 8, y % 8, c)
      end
    end
  end
end

function paint16(rows, cmap)
  local g = {}
  for y = 1, 16 do
    g[y] = {}
    local row = rows[y]
    for x = 1, 16 do
      g[y][x] = cmap[row:sub(x, x)] or 0
    end
  end
  return g
end

function rot16(g, ang)
  local out = {}
  local cx, cy = 8.5, 8.5
  local co, si = math.cos(ang), math.sin(ang)
  for y = 1, 16 do
    out[y] = {}
    for x = 1, 16 do
      local dx, dy = x - cx, y - cy
      local sx = math.floor(cx + dx * co + dy * si + 0.5)
      local sy = math.floor(cy - dx * si + dy * co + 0.5)
      out[y][x] = (g[sy] and g[sy][sx]) or 0
    end
  end
  return out
end

function bake_rot(base, rows, cmap)
  local g = paint16(rows, cmap)
  for k = 0, 7 do
    vwrite16(base + k * 2, rot16(g, k * math.pi / 4))
  end
end

function bake_tile(id, rows)
  vclear(id)
  for y = 1, 8 do
    local row = rows[y]
    for x = 1, 8 do
      local c = tonumber(row:sub(x, x), 16)
      if c and c > 0 then vpx(id, x - 1, y - 1, c) end
    end
  end
end

function bake_wave(id, vals)
  for k = 0, 31 do
    local v = vals[k + 1] or 0
    local a = 0xFFE4 + id * 16 + math.floor(k / 2)
    local b = peek(a)
    if k % 2 == 0 then
      poke(a, b - b % 16 + v * 16)
    else
      poke(a, b - b % 16 + v)
    end
  end
end

function bake_sfx(id, note, oct, wave, dur)
  local base = 0x100E4 + id * 66
  for i = 0, 65 do poke(base + i, 0) end
  for i = 0, 29 do
    local vol = 15
    if i < dur then vol = math.floor((i / dur) * 14) end
    local w = 0
    if i < dur then w = wave end
    poke(base + i * 2, vol + w * 16)
    poke(base + i * 2 + 1, 0)
  end
  poke(base + 60, oct)
  poke(base + 61, note)
end

