function draw_target_world(camx, camy)
  local t = GAME.target
  if not t then return end
  local x, y = t.x - camx, t.y - camy
  if x < 0 or x > 240 or y < 0 or y > 136 then return end
  local pulse = 2 + math.sin(GAME.t * 0.15) * 2
  circb(x, y, 14 + pulse, 8)
  circb(x, y, 8, 10)
end

function draw_arrow(camx, camy)
  local t = GAME.target
  if not t then return end
  local sx, sy = t.x - camx, t.y - camy
  if sx > 10 and sx < 230 and sy > 16 and sy < 118 then return end
  local ang = atan2(sy - 68, sx - 120)
  local cx = clamp(sx, 12, 228)
  local cy = clamp(sy, 18, 116)
  local c = 10
  if math.floor(GAME.t / 10) % 2 == 0 then c = 15 end
  local x1 = cx + math.cos(ang) * 6
  local y1 = cy + math.sin(ang) * 6
  local x2 = cx + math.cos(ang + 2.4) * 6
  local y2 = cy + math.sin(ang + 2.4) * 6
  local x3 = cx + math.cos(ang - 2.4) * 6
  local y3 = cy + math.sin(ang - 2.4) * 6
  tri(x1, y1, x2, y2, x3, y3, c)
end

