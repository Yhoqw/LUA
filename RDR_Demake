  GAME = {}
  WORLD = {}
  TITLE = {}
  GAME.state = "title"
  GAME.t = 0
  GAME.money = 20
  GAME.honor = 50
  GAME.wanted = 0
  GAME.wanted_t = 0
  GAME.cop_t = 0
  GAME.deadeye = CFG.deadeye_max
  GAME.slow = false
  GAME.ammo = 24
  GAME.reload_t = 0
  GAME.fire_cd = 0
  GAME.use_cd = 0
  GAME.msg = nil
  GAME.msg_t = 0
  GAME.shake = 0
  GAME.prompt = nil
  GAME.mission = ""
  GAME.target = nil
  GAME.bounty = nil
  GAME.bountyn = 0
  GAME.new_bounty_t = 0
  GAME.won = false
  GAME.win_t = 0
  GAME.dead_t = 0
  GAME.pickup_t = 300
  GAME.camx = 0
  GAME.camy = 0
  GAME.weapon = "revolver"
  GAME.player = {
    x = 220, y = 210, angle = math.pi / 2, facing = math.pi / 2,
