  GAME.camy = clamp(GAME.player.y - CFG.sh / 2, 0, CFG.wh - CFG.sh - 8)
  build_world()
  spawn_world()
  init_title()
  GAME.ready = true
end

function heal_cost()
  return 60 - math.floor(GAME.honor / 5)
end

function ammo_cost()
  return 30 - math.floor(GAME.honor / 10)
end

function mount_horse()
  local p = GAME.player
  local h = WORLD.horse
  if not h or h.dead then return end
  p.mounted = true
  p.x, p.y = h.x, h.y
  p.angle = h.angle
  GAME.use_cd = 20
  snd(SFX.horse)
  show_msg("MOUNTED")
end

function dismount_horse()
  local p = GAME.player
  local h = WORLD.horse
  local px, py = p.x, p.y
  local spots = { { 0, 12 }, { 12, 0 }, { -12, 0 }, { 0, -12 } }
  for _, s in ipairs(spots) do
    if not solid_at(p.x + s[1], p.y + s[2], 3.5) then
      px, py = p.x + s[1], p.y + s[2]
      break
    end
  end
  if h then
    h.x, h.y = p.x, p.y
    h.angle = p.angle
    h.moving = false
    h.fast = false
  end
  p.mounted = false
  p.x, p.y = px, py
  GAME.use_cd = 20
  snd(SFX.horse)
end

function try_use()
  local p = GAME.player
  if GAME.use_cd > 0 then return end
  if p.mounted then
    dismount_horse()
    GAME.use_cd = 20
    return
  end
  local z = zone_at(p.x, p.y)
  if z and z.name ~= "stable" then
    if z.name == "saloon" then
      local cost = heal_cost()
      if p.health >= CFG.health then
        show_msg("YOU'RE ALREADY HEALTHY")
      elseif GAME.money < cost then
        show_msg("NEED $" .. cost)
      else
        add_money(-cost)
        p.health = CFG.health
        show_msg("PATCHED UP -$" .. cost)
        snd(SFX.cash)
      end
    elseif z.name == "store" then
      local cost = ammo_cost()
      if GAME.ammo >= CFG.ammo_max then
        show_msg("AMMO IS FULL")
      elseif GAME.money < cost then
        show_msg("NEED $" .. cost)
      else
        add_money(-cost)
        GAME.ammo = CFG.ammo_max
        show_msg("AMMO RESTOCKED -$" .. cost)
        snd(SFX.reload)
      end
    elseif z.name == "sheriff" then
      if GAME.bounty then show_msg("BOUNTY STILL OUT THERE") else new_bounty() end
    elseif z.name == "bank" then
      show_msg("BANK: YOUR MONEY IS YOURS")
    end
    GAME.use_cd = 20
    return
  end
  local h = WORLD.horse
  if h and not h.dead and dist(p.x, p.y, h.x, h.y) < 18 then
    mount_horse()
    GAME.use_cd = 20
    return
  end
  if z and z.name == "stable" then
    show_msg("YOUR HORSE WAITS OUTSIDE")
    GAME.use_cd = 20
    return
  end
  if GAME.ammo < CFG.ammo_max then start_reload() end
end

function start_reload()
  if GAME.reload_t > 0 then return end
  GAME.reload_t = 45
  show_msg("RELOADING")
  snd(SFX.reload)
end

function try_fire()
  local p = GAME.player
  if GAME.fire_cd > 0 or GAME.reload_t > 0 or p.dead then return end
  if GAME.ammo <= 0 then
    start_reload()
    return
  end
  local w = WEAPONS[GAME.weapon]
  local a = p.angle + (math.random() - 0.5) * w.spread
  local x = p.x + math.cos(a) * 7
  local y = p.y + math.sin(a) * 7
  new_bullet("p", x, y, a, w.speed, w.damage, 10)
  GAME.ammo = GAME.ammo - 1
  GAME.fire_cd = w.rate
  GAME.shake = math.max(GAME.shake, 2)
  spawn_particle(x, y, math.cos(a) * 0.8, math.sin(a) * 0.8, 6, 10, 1)
  snd(SFX.gun)
  for _, e in ipairs(WORLD.peds) do
    if dist(x, y, e.x, e.y) < 90 then e.panic = 160 end
  end
  if GAME.ammo <= 0 then start_reload() end
end

function damage_player(n)
  local p = GAME.player
  if p.inv > 0 or p.dead then return end
  p.health = clamp(p.health - n, 0, CFG.health)
  p.inv = 14
  GAME.shake = 4
  snd(SFX.hurt)
  if p.health <= 0 then
    p.dead = true
    GAME.state = "dead"
    GAME.dead_t = 120
    GAME.wanted = 0
    GAME.wanted_t = 0
    if p.mounted then
      p.mounted = false
      if WORLD.horse then
        WORLD.horse.x, WORLD.horse.y = p.x, p.y
        WORLD.horse.dead = false
        WORLD.horse.moving = false
        WORLD.horse.fast = false
      end
    end
    burst(p.x, p.y, 12, 8, 2)
    snd(SFX.dead)
  end
end

function kill_ped(ped, by_horse)
  if ped.dead then return end
  ped.dead = true
  burst(ped.x, ped.y, 6, 8, 1.2)
  snd(SFX.hit)
  GAME.honor = clamp(GAME.honor - 10, 0, 100)
  crime(1)
  show_msg("INNOCENT KILLED -HONOR")
end

function kill_lawman(e)
  if e.dead then return end
  e.dead = true
  burst(e.x, e.y, 7, 8, 1.3)
  snd(SFX.hit)
  GAME.honor = clamp(GAME.honor - 5, 0, 100)
  crime(1)
  if math.random() < 0.5 then new_pickup(e.x, e.y, "ammo", 6) end
end

function kill_outlaw(e)
  if e.dead then return end
  e.dead = true
  burst(e.x, e.y, 8, 8, 1.4)
  snd(SFX.hit)
  if e.target then
    complete_bounty(e)
  else
    GAME.honor = clamp(GAME.honor + 2, 0, 100)
    GAME.deadeye = clamp(GAME.deadeye + 8, 0, CFG.deadeye_max)
    if math.random() < 0.5 then new_pickup(e.x, e.y, "cash", math.random(20, 60)) end
    if math.random() < 0.25 then new_pickup(e.x, e.y, "ammo", 8) end
  end
end

function complete_bounty(e)
  local j = GAME.bounty
  if not j then return end
  add_money(j.payout)
  GAME.honor = clamp(GAME.honor + 8, 0, 100)
  GAME.deadeye = clamp(GAME.deadeye + 20, 0, CFG.deadeye_max)
  GAME.shake = 5
  show_msg("BOUNTY COLLECTED +$" .. j.payout)
  snd(SFX.cash)
  burst(GAME.player.x, GAME.player.y, 14, 10, 1.8)
  GAME.bounty = nil
  GAME.target = nil
  if GAME.money >= CFG.money_win and not GAME.won then
    GAME.won = true
    GAME.win_t = 300
    show_msg("LEGEND OF THE WEST")
    snd(SFX.bounty)
  end
  GAME.new_bounty_t = 90
end

function new_bounty()
  GAME.bountyn = GAME.bountyn + 1
  local p = GAME.player
  local name = BOUNTY_NAMES[math.random(1, #BOUNTY_NAMES)]
  local payout = 120 + GAME.bountyn * 70
  local x, y = find_desert_spot(p.x, p.y, 260, 560)
  local e = new_outlaw(x, y, true)
  e.name = name
  e.hp = ENEMY_TYPES.target.hp + math.floor(GAME.bountyn / 3)
  e.maxhp = e.hp
  GAME.bounty = { name = name, payout = payout, target = e }
  GAME.target = { x = e.x, y = e.y }
  GAME.mission = "BOUNTY: " .. name .. "  $" .. payout
  for i = 1, math.min(2, 1 + math.floor(GAME.bountyn / 2)) do
    local gx, gy = find_desert_spot(e.x, e.y, 30, 80)
    new_outlaw(gx, gy, false)
  end
  show_msg("NEW BOUNTY: " .. name)
  snd(SFX.bounty)
end

function spawn_lawman()
  local p = GAME.player
  for i = 1, 40 do
    local a = math.random() * math.pi * 2
    local r = 180 + math.random() * 160
    local x = p.x + math.cos(a) * r
    local y = p.y + math.sin(a) * r
    if x > 16 and x < CFG.ww - 16 and y > 16 and y < CFG.wh - 16 and not solid_at(x, y, 4) then
      return new_lawman(x, y)
    end
  end
  return nil
end

function trample(h)
  for _, e in ipairs(WORLD.outlaws) do
    if not e.dead and dist(h.x, h.y, e.x, e.y) < 9 then
      e.hp = e.hp - 2
      burst(e.x, e.y, 4, 8, 1)
      if e.hp <= 0 then kill_outlaw(e) end
    end
  end
  for _, e in ipairs(WORLD.lawmen) do
    if not e.dead and dist(h.x, h.y, e.x, e.y) < 9 then
      e.hp = e.hp - 2
      burst(e.x, e.y, 4, 8, 1)
      if e.hp <= 0 then kill_lawman(e) end
    end
  end
  for _, e in ipairs(WORLD.peds) do
    if not e.dead and dist(h.x, h.y, e.x, e.y) < 8 then kill_ped(e, true) end
  end
end

function move_input()
  local dx, dy = 0, 0
  if btn(INPUT.left) then dx = dx - 1 end
  if btn(INPUT.right) then dx = dx + 1 end
  if btn(INPUT.up) then dy = dy - 1 end
  if btn(INPUT.down) then dy = dy + 1 end
  return dx, dy
end

function update_deadeye()
  local p = GAME.player
  if btn(INPUT.dead_eye) and GAME.deadeye > 0 and not p.dead then
    GAME.slow = true
    GAME.deadeye = clamp(GAME.deadeye - 0.9, 0, CFG.deadeye_max)
  else
    GAME.slow = false
    GAME.deadeye = clamp(GAME.deadeye + 0.12, 0, CFG.deadeye_max)
  end
end

function update_foot()
  local p = GAME.player
  local dx, dy = move_input()
  local sp = CFG.walk
  if btn(INPUT.run) then sp = CFG.run end
  if dx ~= 0 or dy ~= 0 then
    local m = math.sqrt(dx * dx + dy * dy)
    move_actor(p, dx / m * sp, dy / m * sp, 3.5)
    p.angle = atan2(dy, dx)
    p.moving = true
    p.walk = p.walk + sp
  else
    p.moving = false
  end
  if btn(INPUT.fire) then try_fire() end
  if btnp(INPUT.use) then try_use() end
end

function update_horse()
  local p = GAME.player
  local h = WORLD.horse
  if not h or h.dead then
    p.mounted = false
    return
  end
  local dx, dy = move_input()
  local sp = CFG.horse_walk
  if btn(INPUT.run) then sp = CFG.horse_run end
  if dx ~= 0 or dy ~= 0 then
    local m = math.sqrt(dx * dx + dy * dy)
    move_actor(h, dx / m * sp, dy / m * sp, 5)
    p.angle = atan2(dy, dx)
    h.angle = p.angle
    h.moving = true
    h.fast = btn(INPUT.run)
    h.walk = h.walk + sp
    if h.fast and GAME.t % 4 == 0 then
      spawn_particle(
        h.x - math.cos(p.angle) * 6, h.y - math.sin(p.angle) * 6,
        -math.cos(p.angle) * 0.4, -math.sin(p.angle) * 0.4,
        12, 15, 1
      )
    end
  else
    h.moving = false
    h.fast = false
  end
  p.x, p.y = h.x, h.y
  if btn(INPUT.fire) then try_fire() end
  if btnp(INPUT.use) then try_use() end
  if h.fast and GAME.t % 6 == 0 then trample(h) end
end

function update_player()
  local p = GAME.player
  if p.inv > 0 then p.inv = p.inv - 1 end
  if GAME.fire_cd > 0 then GAME.fire_cd = GAME.fire_cd - 1 end
  if GAME.use_cd > 0 then GAME.use_cd = GAME.use_cd - 1 end
  if GAME.reload_t > 0 then
    GAME.reload_t = GAME.reload_t - 1
    if GAME.reload_t == 0 then
      GAME.ammo = CFG.ammo_max
      snd(SFX.reload)
      show_msg("RELOADED")
    end
  end
  if p.mounted then update_horse() else update_foot() end
end

function update_peds()
  local p = GAME.player
  local f = GAME.slow and 0.35 or 1
  for i = #WORLD.peds, 1, -1 do
    local e = WORLD.peds[i]
    if e.dead then
      table.remove(WORLD.peds, i)
    else
      e.timer = e.timer - f
      if e.timer <= 0 then
        e.timer = math.random(60, 180)
        e.dir = math.random(0, 3)
      end
      local ax, ay = 0, 0
      if e.dir == 0 then ay = -1 elseif e.dir == 1 then ay = 1 elseif e.dir == 2 then ax = -1 else ax = 1 end
      local sp = 0.3
      if e.panic > 0 then
        e.panic = e.panic - f
        local a = atan2(e.y - p.y, e.x - p.x)
        ax, ay = math.cos(a), math.sin(a)
        sp = 0.9
      end
      local nx = e.x + ax * sp * f
      local ny = e.y + ay * sp * f
      if solid_at(nx, ny, 3) then
        e.dir = math.random(0, 3)
        if e.panic <= 0 then e.timer = math.random(40, 100) end
      else
        e.x, e.y = nx, ny
      end
      e.angle = atan2(ay, ax)
      if p.mounted and WORLD.horse and WORLD.horse.fast and dist(p.x, p.y, e.x, e.y) < 8 then
        kill_ped(e, true)
      end
    end
  end
end

function update_outlaws()
  local p = GAME.player
  local f = GAME.slow and 0.35 or 1
  for i = #WORLD.outlaws, 1, -1 do
    local e = WORLD.outlaws[i]
    if e.dead then
      table.remove(WORLD.outlaws, i)
    else
      local et = ENEMY_TYPES[e.target and "target" or "outlaw"]
      local d = dist(e.x, e.y, p.x, p.y)
      if d < et.aggro then
        local a = atan2(p.y - e.y, p.x - e.x)
        e.angle = a
        if d > 28 then
          move_enemy(e, e.x + math.cos(a) * et.speed * f, e.y + math.sin(a) * et.speed * f)
        end
        e.cd = e.cd - f
        if e.cd <= 0 and d < et.range then
          e.cd = et.shoot_cd
          local err = (math.random() - 0.5) * 0.18
          new_bullet("e", e.x + math.cos(a) * 6, e.y + math.sin(a) * 6, a + err, 3.2, 7, 8)
          snd(SFX.gun)
        end
      else
        e.wander_t = (e.wander_t or 0) - f
        if e.wander_t <= 0 then
          e.wander_t = math.random(60, 180)
          e.wander_dir = math.random() * math.pi * 2
        end
        local a = e.wander_dir or 0
        e.angle = a
        move_enemy(e, e.x + math.cos(a) * 0.25 * f, e.y + math.sin(a) * 0.25 * f)
      end
    end
  end
end

function update_lawmen()
  local p = GAME.player
  local f = GAME.slow and 0.35 or 1
  for i = #WORLD.lawmen, 1, -1 do
    local e = WORLD.lawmen[i]
    local d = dist(e.x, e.y, p.x, p.y)
    if e.dead or GAME.wanted == 0 or d > 760 then
      table.remove(WORLD.lawmen, i)
    else
      local a = atan2(p.y - e.y, p.x - e.x)
      e.angle = a
      if d > 20 then
        move_enemy(e, e.x + math.cos(a) * 0.8 * f, e.y + math.sin(a) * 0.8 * f)
      end
      e.cd = e.cd - f
      if e.cd <= 0 and d < 140 then
        e.cd = 50 + math.random(0, 30)
        local err = (math.random() - 0.5) * 0.14
        new_bullet("e", e.x + math.cos(a) * 6, e.y + math.sin(a) * 6, a + err, 3.5, 8, 8)
        snd(SFX.gun)
      end
      if d < 9 then damage_player(8) end
    end
  end
end

function update_bullets()
  local p = GAME.player
  for i = #WORLD.bullets, 1, -1 do
    local b = WORLD.bullets[i]
    local f = 1
    if GAME.slow and b.owner == "e" then f = 0.35 end
    b.x = b.x + math.cos(b.angle) * b.speed * f
    b.y = b.y + math.sin(b.angle) * b.speed * f
    b.life = b.life - f
    local kill = b.life <= 0
    if solid_at(b.x, b.y, 0) then
      burst(b.x, b.y, 2, 15, 0.6)
      kill = true
    end
    if not kill and b.owner == "p" then
      for _, e in ipairs(WORLD.outlaws) do
        if not e.dead and dist(b.x, b.y, e.x, e.y) < 6 then
          e.hp = e.hp - b.dmg
          burst(e.x, e.y, 3, 8, 0.8)
          if e.hp <= 0 then kill_outlaw(e) end
          kill = true
          break
        end
      end
    end
    if not kill and b.owner == "p" then
      for _, e in ipairs(WORLD.lawmen) do
        if not e.dead and dist(b.x, b.y, e.x, e.y) < 6 then
          e.hp = e.hp - b.dmg
          burst(e.x, e.y, 3, 8, 0.8)
          if e.hp <= 0 then kill_lawman(e) end
          kill = true
          break
        end
      end
    end
    if not kill and b.owner == "p" then
      for _, e in ipairs(WORLD.peds) do
        if not e.dead and dist(b.x, b.y, e.x, e.y) < 6 then
          kill_ped(e, false)
          kill = true
          break
        end
      end
    end
    if not kill and b.owner == "e" then
      if dist(b.x, b.y, p.x, p.y) < 6 then
        damage_player(b.dmg)
        kill = true
      end
    end
    if kill then table.remove(WORLD.bullets, i) end
  end
end

function update_pickups()
  local p = GAME.player
  for i = #WORLD.pickups, 1, -1 do
    local it = WORLD.pickups[i]
    it.bob = it.bob + 1
    if dist(p.x, p.y, it.x, it.y) < 12 then
      if it.kind == "cash" then
        add_money(it.value)
        show_msg("+$" .. it.value)
        snd(SFX.cash)
      elseif it.kind == "ammo" then
        GAME.ammo = clamp(GAME.ammo + it.value, 0, CFG.ammo_max)
        show_msg("AMMO +" .. it.value)
        snd(SFX.reload)
      elseif it.kind == "tonic" then
        p.health = clamp(p.health + it.value, 0, CFG.health)
        show_msg("TONIC +" .. it.value)
        snd(SFX.cash)
      end
      burst(it.x, it.y, 8, 10, 1.2)
      table.remove(WORLD.pickups, i)
    end
  end
  GAME.pickup_t = GAME.pickup_t - 1
  if GAME.pickup_t <= 0 and #WORLD.pickups < 10 then
    GAME.pickup_t = 600
    local x, y = find_desert_spot(GAME.player.x, GAME.player.y, 120, 500)
    local kind = "cash"
    local val = math.random(20, 60)
    local r = math.random()
    if r < 0.3 then
      kind = "ammo"
      val = 6
    elseif r < 0.5 then
      kind = "tonic"
      val = 25
    end
    new_pickup(x, y, kind, val)
  end
end

function update_effects()
  local f = GAME.slow and 0.35 or 1
  for i = #WORLD.fx, 1, -1 do
    local e = WORLD.fx[i]
    e.x = e.x + e.vx * f
    e.y = e.y + e.vy * f
    e.vx = e.vx * 0.92
    e.vy = e.vy * 0.92
    e.life = e.life - f
    if e.life <= 0 then table.remove(WORLD.fx, i) end
  end
end

function update_tumbleweeds()
  local f = GAME.slow and 0.35 or 1
  for _, t in ipairs(WORLD.tumbleweeds) do
    t.x = t.x + t.vx * f
    t.y = t.y + math.sin((GAME.t + t.seed) * 0.1) * 0.2 * f
    if t.x > CFG.ww + 10 then
      t.x = -10
      t.y = math.random(40, CFG.wh - 40)
    end
  end
end

function update_camera()
  local p = GAME.player
  local tx = p.x - CFG.sw / 2
  local ty = p.y - CFG.sh / 2
  GAME.camx = GAME.camx + (tx - GAME.camx) * 0.14
  GAME.camy = GAME.camy + (ty - GAME.camy) * 0.14
  GAME.camx = clamp(GAME.camx, 0, CFG.ww - CFG.sw - 8)
  GAME.camy = clamp(GAME.camy, 0, CFG.wh - CFG.sh - 8)
end

function update_prompt()
  local p = GAME.player
  GAME.prompt = nil
  if p.mounted then
    GAME.prompt = "X: DISMOUNT"
  else
    local z = zone_at(p.x, p.y)
    if z and z.name ~= "stable" then
      if z.name == "saloon" then
        GAME.prompt = "X: HEAL $" .. heal_cost()
      elseif z.name == "store" then
        GAME.prompt = "X: AMMO $" .. ammo_cost()
      elseif z.name == "sheriff" then
        GAME.prompt = "X: BOUNTY BOARD"
      elseif z.name == "bank" then
        GAME.prompt = "X: BANK"
      end
    else
      local h = WORLD.horse
      if h and not h.dead and dist(p.x, p.y, h.x, h.y) < 18 then
        GAME.prompt = "X: MOUNT HORSE"
      elseif z and z.name == "stable" then
        GAME.prompt = "X: STABLE"
      elseif GAME.ammo < CFG.ammo_max and GAME.reload_t <= 0 then
        GAME.prompt = "X: RELOAD"
      end
    end
  end
end

function update_msg()
  if GAME.msg_t > 0 then
    GAME.msg_t = GAME.msg_t - 1
    if GAME.msg_t == 0 then GAME.msg = nil end
  end
end

function update_shake()
  if GAME.shake > 0 then
    GAME.shake = GAME.shake * 0.85
    if GAME.shake < 0.5 then GAME.shake = 0 end
  end
end

function update_bounty()
  if GAME.new_bounty_t > 0 then
    GAME.new_bounty_t = GAME.new_bounty_t - 1
    if GAME.new_bounty_t == 0 then new_bounty() end
    return
  end
  local j = GAME.bounty
  if not j then
    new_bounty()
    return
  end
  local e = j.target
  if not e or e.dead then
    GAME.bounty = nil
    GAME.target = nil
    GAME.new_bounty_t = 60
    return
  end
  GAME.target = { x = e.x, y = e.y }
  GAME.mission = "BOUNTY: " .. j.name .. "  $" .. j.payout
end

function update_wanted()
  if GAME.wanted > 0 then
    GAME.wanted_t = GAME.wanted_t + 1
    if GAME.wanted_t > CFG.heat_cool then
      GAME.wanted_t = 0
      GAME.wanted = GAME.wanted - 1
      if GAME.wanted == 0 then show_msg("WANTED CLEARED") end
    end
  end
  local want = GAME.wanted
  local have = 0
  for _, e in ipairs(WORLD.lawmen) do
    if not e.dead then have = have + 1 end
  end
  if have > want then
    local far, fd = nil, -1
    for i, e in ipairs(WORLD.lawmen) do
      if not e.dead then
        local d = dist(e.x, e.y, GAME.player.x, GAME.player.y)
        if d > fd then
          fd = d
          far = i
        end
      end
    end
    if far then table.remove(WORLD.lawmen, far) end
  end
  GAME.cop_t = GAME.cop_t - 1
  if have < want and GAME.cop_t <= 0 then
    GAME.cop_t = 80
    spawn_lawman()
  end
end

function update_play()
  update_deadeye()
  update_player()
  update_peds()
  update_outlaws()
  update_lawmen()
  update_bullets()
  update_pickups()
  update_bounty()
  update_wanted()
  update_effects()
  update_tumbleweeds()
  update_camera()
  update_prompt()
  update_msg()
  update_shake()
end

function respawn()
  local p = GAME.player
  p.dead = false
  p.health = CFG.health
  p.mounted = false
  p.inv = 60
  p.x, p.y = 220, 210
  p.angle = math.pi / 2
  GAME.money = clamp(GAME.money - 100, 0, 99999)
  GAME.wanted = 0
  GAME.wanted_t = 0
  GAME.honor = clamp(GAME.honor - 5, 0, 100)
  GAME.deadeye = CFG.deadeye_max
  GAME.slow = false
  WORLD.lawmen = {}
  WORLD.bullets = {}
  local h = WORLD.horse
  if h then
    h.x, h.y = 252, 216
    h.angle = 0
    h.dead = false
    h.moving = false
    h.fast = false
  end
  GAME.camx = clamp(p.x - CFG.sw / 2, 0, CFG.ww - CFG.sw - 8)
  GAME.camy = clamp(p.y - CFG.sh / 2, 0, CFG.wh - CFG.sh - 8)
  GAME.state = "play"
  show_msg("THE WEST GIVES ANOTHER CHANCE -$100")
end

function star(x, y, c)
  line(x - 3, y, x + 3, y, c)
  line(x, y - 3, x, y + 3, c)
  line(x - 2, y - 2, x + 2, y + 2, c)
  line(x - 2, y + 2, x + 2, y - 2, c)
end

function small_star(x, y, c)
  line(x - 2, y, x + 2, y, c)
  line(x, y - 2, x, y + 2, c)
  line(x - 1, y - 1, x + 1, y + 1, c)
  line(x - 1, y + 1, x + 1, y - 1, c)
end

function draw_ground(camx, camy)
  local mx = math.floor(camx / CFG.ts)
  local my = math.floor(camy / CFG.ts)
