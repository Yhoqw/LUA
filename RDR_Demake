      if z.name == "saloon" then
        rect(cx - 3, cy - 3, 5, 6, 10)
        rect(cx + 2, cy - 1, 2, 3, 10)
      elseif z.name == "store" then
        rect(cx - 3, cy - 2, 6, 4, 10)
        rectb(cx - 3, cy - 2, 6, 4, 15)
      elseif z.name == "sheriff" then
        star(cx, cy, 10)
      elseif z.name == "bank" then
