local function solid(tx, ty)
  if tx < 0 or ty < 0 or tx >= CFG.gw or ty >= CFG.gh then return true end
  return mget(tx, ty) == TILE.wall
end

local function solid_px(x, y)
  return solid(math.floor(x / 8), math.floor(y / 8))
end

local function body_move(b, dx, dy)
  b.x = b.x + dx
  if solid_px(b.x, b.y) or solid_px(b.x + b.w - 1, b.y) or solid_px(b.x, b.y + b.h - 1) or solid_px(b.x + b.w - 1, b.y + b.h - 1) then
    b.x = b.x - dx
  end
  b.y = b.y + dy
  if solid_px(b.x, b.y) or solid_px(b.x + b.w - 1, b.y) or solid_px(b.x, b.y + b.h - 1) or solid_px(b.x + b.w - 1, b.y + b.h - 1) then
    b.y = b.y - dy
  end
end

local function add_fx(x, y, col, n)
  for i = 1, n do
    WORLD.fx[#WORLD.fx + 1] = {
      x = x, y = y,
      vx = math.random(-12, 12) / 10,
      vy = math.random(-12, 12) / 10,
      t = math.random(12, 26), col = col,
    }
  end
end

local function msg(s)
  GAME.msg = s
  GAME.msg_t = 120
end

local function part_count(kind)
  return WORLD.player.parts[kind] or 0
end

local function can_cook(r)
  for k, v in pairs(r.need) do
    if part_count(k) < v then return false end
  end
  return true
end

local function add_part(kind)
  local p = WORLD.player
  p.parts[kind] = (p.parts[kind] or 0) + 1
end

local function eat_raw()
  local p = WORLD.player
  local kinds = { "meat", "wing", "cap", "goo" }
  for i = 1, #kinds do
    local k = kinds[i]
    if part_count(k) > 0 then
      p.parts[k] = p.parts[k] - 1
      local d = PARTS[k]
      p.hunger = clamp(p.hunger + d.hunger, 0, CFG.hunger_max)
      p.poison_t = CFG.poison_t
      p.poison_tick = 60
      msg("RAW " .. d.name .. " TASTES AWFUL")
      sfx(SFX.eat)
      return
    end
  end
  msg("NOTHING TO EAT")
end

local function eat_meal()
  local p = WORLD.player
  if #p.meals <= 0 then
    eat_raw()
    return
  end
  local meal = table.remove(p.meals, 1)
  p.hunger = clamp(p.hunger + meal.hunger, 0, CFG.hunger_max)
  p.buff = meal.buff
  p.buff_t = CFG.buff_t
  msg(meal.name .. " RESTORES YOU")
  sfx(SFX.eat)
end

local function cook_selected()
  local p = WORLD.player
  local r = RECIPES[GAME.cook_sel]
  if not can_cook(r) then
    msg("MISSING INGREDIENTS")
    return
  end
  for k, v in pairs(r.need) do
    p.parts[k] = p.parts[k] - v
  end
  p.meals[#p.meals + 1] = { name = r.name, hunger = r.hunger, buff = r.buff }
  GAME.meals_made = (GAME.meals_made or 0) + 1
  msg(r.name .. " COOKED")
  sfx(SFX.cook)
end

local function near(obj, range)
  local p = WORLD.player
  return dist(p.x + p.w / 2, p.y + p.h / 2, obj.x, obj.y) < (range or 20)
end

local function hurt_player(n)
  local p = WORLD.player
  if GAME.state ~= "play" or p.invuln > 0 then return end
  if p.buff == "DEFENSE" then n = math.max(0, n - 1) end
  p.hp = p.hp - n
  p.invuln = CFG.invuln
  GAME.shake = 6
  sfx(SFX.hurt)
  if p.hp <= 0 then
    p.hp = 0
    GAME.state = "lose"
    GAME.end_t = 0
  end
end

local function spawn_enemy(kind, x, y)
  local base = {
    kind = kind, x = x, y = y, w = 12, h = 12,
    hp = 2, speed = 0.35, atk = 1, drop = "meat",
    shoot_cd = 120, t = math.random(0, 60),
  }
  if kind == "slime" then
    base.hp, base.speed, base.drop = 3, 0.32, "goo"
  elseif kind == "bat" then
    base.w, base.h, base.hp, base.speed, base.drop = 12, 8, 2, 0.65, "wing"
  elseif kind == "shroom" then
    base.w, base.h, base.hp, base.speed, base.drop = 12, 12, 4, 0.22, "cap"
    base.shoot_cd = 110
  elseif kind == "boss" then
    base.w, base.h, base.hp, base.speed, base.drop = 28, 28, 24, 0.18, "meat"
    base.shoot_cd = 85
    base.boss = true
  end
  WORLD.enemies[#WORLD.enemies + 1] = base
end

local function random_floor_in(r)
  local x = math.random(r.x + 1, r.x + r.w - 2)
  local y = math.random(r.y + 1, r.y + r.h - 2)
  return x * 8, y * 8
end

local function build_floor()
  for y = 0, CFG.gh - 1 do
    for x = 0, CFG.gw - 1 do mset(x, y, TILE.wall) end
  end
  local rooms = {}
  local tries = 0
  while #rooms < 4 and tries < 120 do
    local w = math.random(6, 9)
    local h = math.random(4, 6)
    local x = math.random(2, CFG.gw - w - 2)
    local y = math.random(2, CFG.gh - h - 2)
    local ok = true
    for i = 1, #rooms do
      local r = rooms[i]
      if x < r.x + r.w + 1 and x + w + 1 > r.x and y < r.y + r.h + 1 and y + h + 1 > r.y then
        ok = false
      end
    end
    if ok then rooms[#rooms + 1] = { x = x, y = y, w = w, h = h } end
    tries = tries + 1
  end
  while #rooms < 4 do
    local w, h = 6, 4
    local x = 2 + (#rooms % 4) * 7
    local y = 2 + math.floor(#rooms / 4) * 5
    rooms[#rooms + 1] = { x = x, y = y, w = w, h = h }
  end
  for i = 1, #rooms do
    local r = rooms[i]
    for y = r.y, r.y + r.h - 1 do
      for x = r.x, r.x + r.w - 1 do mset(x, y, TILE.floor) end
    end
  end
  local function cx(r) return math.floor(r.x + r.w / 2) end
  local function cy(r) return math.floor(r.y + r.h / 2) end
  for i = 1, #rooms - 1 do
    local a, b = rooms[i], rooms[i + 1]
    local ax, ay, bx, by = cx(a), cy(a), cx(b), cy(b)
    if math.random(0, 1) == 0 then
      for x = math.min(ax, bx), math.max(ax, bx) do mset(x, ay, TILE.floor) end
      for y = math.min(ay, by), math.max(ay, by) do mset(bx, y, TILE.floor) end
    else
      for y = math.min(ay, by), math.max(ay, by) do mset(ax, y, TILE.floor) end
      for x = math.min(ax, bx), math.max(ax, bx) do mset(x, by, TILE.floor) end
    end
  end
  local p = WORLD.player
  p.x = cx(rooms[1]) * 8 - p.w / 2
  p.y = cy(rooms[1]) * 8 - p.h / 2
  p.vx, p.vy = 0, 0
  WORLD.fire = { x = cx(rooms[1]) * 8 + 14, y = cy(rooms[1]) * 8 - 8 }
  WORLD.npc = { x = cx(rooms[1]) * 8 - 28, y = cy(rooms[1]) * 8 - 8, fed = false }
  WORLD.stairs = nil
  if GAME.floor < CFG.floors then
    WORLD.stairs = { x = cx(rooms[4]) * 8, y = cy(rooms[4]) * 8 - 8 }
  end
  WORLD.enemies = {}
  WORLD.drops = {}
  WORLD.shots = {}
  WORLD.fx = {}
  local s = WORLD.season
  for i = 2, #rooms do
    local count = 1 + math.random(0, 2)
    if i == #rooms then count = count + 1 end
    for j = 1, count do
      local roll = math.random(1, 6)
      local kind = "slime"
      if roll <= s.slime then kind = "slime"
      elseif roll <= s.slime + s.bat then kind = "bat"
      else kind = "shroom" end
      local x, y = random_floor_in(rooms[i])
      spawn_enemy(kind, x, y)
    end
  end
  if GAME.floor == CFG.floors then
    spawn_enemy("boss", cx(rooms[4]) * 8 - 14, cy(rooms[4]) * 8 - 14)
    WORLD.stairs = nil
  end
  GAME.menu = false
  GAME.floor_msg_t = 120
  GAME.floor_msg = "FLOOR " .. GAME.floor .. " - " .. s.name
end

function reset_game()
  math.randomseed(7319)
  GAME.state = CFG.start_title and "title" or "play"
  GAME.t = 0
  GAME.floor = 1
  GAME.season = SEASONS[math.random(1, #SEASONS)]
  WORLD.season = GAME.season
  GAME.msg = ""
  GAME.msg_t = 0
  GAME.shake = 0
  GAME.cook_sel = 1
  GAME.menu = false
  GAME.meals_made = 0
  GAME.end_t = 0
  GAME.floor_msg = ""
  GAME.floor_msg_t = 0
  WORLD.player = {
    x = 32, y = 32, w = 12, h = 14, face = 1,
    hp = CFG.hp, max_hp = CFG.hp, hunger = CFG.hunger_max,
    parts = { meat = 0, wing = 0, cap = 0, goo = 0 },
    meals = {}, buff = "", buff_t = 0,
    attack_t = 0, attack_cd = 0, invuln = 0,
    poison_t = 0, poison_tick = 0, starve_t = 0, anim = 0,
  }
  WORLD.enemies = {}
  WORLD.drops = {}
  WORLD.shots = {}
  WORLD.fx = {}
  WORLD.fire = nil
  WORLD.npc = nil
  WORLD.stairs = nil
  build_floor()
end

local function update_fx()
  for i = #WORLD.fx, 1, -1 do
    local f = WORLD.fx[i]
    f.x = f.x + f.vx
    f.y = f.y + f.vy
    f.vy = f.vy + 0.04
    f.t = f.t - 1
    if f.t <= 0 then table.remove(WORLD.fx, i) end
  end
end

local function update_player()
  local p = WORLD.player
  local dx, dy = 0, 0
  local sp = CFG.speed + (p.buff == "SPEED" and 0.4 or 0)
  if btn(INPUT.left) then dx = -sp; p.face = -1 end
  if btn(INPUT.right) then dx = sp; p.face = 1 end
  if btn(INPUT.up) then dy = -sp end
  if btn(INPUT.down) then dy = sp end
  if dx ~= 0 and dy ~= 0 then dx, dy = dx * 0.7071, dy * 0.7071 end
  body_move(p, dx, dy)
  if dx ~= 0 or dy ~= 0 then p.anim = p.anim + 1 else p.anim = 0 end
  if p.attack_cd > 0 then p.attack_cd = p.attack_cd - 1 end
  if p.attack_t > 0 then p.attack_t = p.attack_t - 1 end
  if p.invuln > 0 then p.invuln = p.invuln - 1 end
  if btnp(INPUT.attack) and p.attack_cd <= 0 then
    p.attack_cd = CFG.attack_cd
    p.attack_t = CFG.attack_t
    sfx(SFX.hit)
  end
  if p.attack_t == CFG.attack_t - 1 then
    local ax = p.face > 0 and p.x + p.w or p.x - CFG.attack_reach
    local ay = p.y + 1
    for i = #WORLD.enemies, 1, -1 do
      local e = WORLD.enemies[i]
      if aabb(ax, ay, CFG.attack_reach, 12, e.x, e.y, e.w, e.h) then
        local dmg = 1 + (p.buff == "POWER" and 1 or 0)
        e.hp = e.hp - dmg
        add_fx(e.x + e.w / 2, e.y + e.h / 2, 8, 5)
        if e.hp <= 0 then
          WORLD.drops[#WORLD.drops + 1] = {
            x = e.x + e.w / 2, y = e.y + e.h / 2,
            kind = e.drop, t = 900, bob = math.random(0, 6),
          }
          add_fx(e.x + e.w / 2, e.y + e.h / 2, 3, 10)
          table.remove(WORLD.enemies, i)
          sfx(SFX.drop)
          if e.boss then
            GAME.state = "win"
            GAME.end_t = 0
            sfx(SFX.win)
          end
        end
      end
    end
  end
  p.hunger = p.hunger - CFG.hunger_rate * WORLD.season.hunger
  if p.hunger <= 0 then
    p.hunger = 0
    p.starve_t = p.starve_t + 1
    if p.starve_t >= 90 then
      p.starve_t = 0
      hurt_player(1)
    end
  else
    p.starve_t = 0
  end
  if p.poison_t > 0 then
    p.poison_t = p.poison_t - 1
    p.poison_tick = p.poison_tick - 1
    if p.poison_tick <= 0 then
      p.poison_tick = 60
      hurt_player(1)
    end
  end
  if p.buff_t > 0 then
    p.buff_t = p.buff_t - 1
    if p.buff == "REGEN" and p.buff_t % 60 == 0 then
      p.hp = clamp(p.hp + 1, 0, p.max_hp)
    end
    if p.buff_t <= 0 then p.buff = "" end
  end
  if btnp(INPUT.eat) then eat_meal() end
  if btnp(INPUT.use) then
    if near(WORLD.fire, CFG.fire_range) then
      GAME.menu = true
      GAME.cook_sel = 1
      sfx(SFX.cook)
    elseif WORLD.npc and not WORLD.npc.fed and near(WORLD.npc, CFG.npc_range) then
      if #p.meals > 0 then
        table.remove(p.meals, 1)
        WORLD.npc.fed = true
        p.max_hp = p.max_hp + 1
        p.hp = p.max_hp
        msg("MIRA: THANK YOU. HAVE ANOTHER HEART.")
        sfx(SFX.win)
      else
        msg("MIRA: COOK SOMETHING FIRST.")
      end
    elseif WORLD.stairs and near(WORLD.stairs, CFG.stair_range) then
      GAME.floor = GAME.floor + 1
      build_floor()
    end
  end
  for i = #WORLD.drops, 1, -1 do
    local d = WORLD.drops[i]
    d.t = d.t - 1
    if d.t <= 0 then
      table.remove(WORLD.drops, i)
    elseif dist(p.x + p.w / 2, p.y + p.h / 2, d.x, d.y) < 12 then
      add_part(d.kind)
      msg("GOT " .. PARTS[d.kind].name)
      sfx(SFX.drop)
      table.remove(WORLD.drops, i)
    end
  end
end

local function update_enemies()
  local p = WORLD.player
  local px, py = p.x + p.w / 2, p.y + p.h / 2
  for i = #WORLD.enemies, 1, -1 do
    local e = WORLD.enemies[i]
    local ex, ey = e.x + e.w / 2, e.y + e.h / 2
    local d = dist(px, py, ex, ey)
    if e.boss then
      local dx, dy = px - ex, py - ey
      if d > 24 then body_move(e, sign(dx) * e.speed, sign(dy) * e.speed) end
      e.shoot_cd = e.shoot_cd - 1
      if e.shoot_cd <= 0 then
        e.shoot_cd = 90
        for k = -1, 1 do
          local len = math.sqrt(dx * dx + dy * dy)
          if len < 1 then len = 1 end
          WORLD.shots[#WORLD.shots + 1] = {
            x = ex, y = ey, vx = dx / len * 1.6, vy = dy / len * 1.6 + k * 0.6,
            t = 180, col = 2,
          }
        end
      end
    elseif d < 90 then
      local dx, dy = px - ex, py - ey
      if d > 10 then body_move(e, sign(dx) * e.speed, sign(dy) * e.speed) end
      if e.kind == "shroom" then
        e.shoot_cd = e.shoot_cd - 1
        if e.shoot_cd <= 0 and d < 110 then
          e.shoot_cd = 120
          local len = math.sqrt(dx * dx + dy * dy)
          if len < 1 then len = 1 end
          WORLD.shots[#WORLD.shots + 1] = {
            x = ex, y = ey, vx = dx / len * 1.2, vy = dy / len * 1.2,
            t = 150, col = 14,
          }
        end
      end
    else
      e.t = e.t - 1
      if e.t <= 0 then
        e.t = math.random(40, 100)
        e.dir = math.random(1, 4)
      end
      if e.dir == 1 then body_move(e, -e.speed, 0)
      elseif e.dir == 2 then body_move(e, e.speed, 0)
      elseif e.dir == 3 then body_move(e, 0, -e.speed)
      elseif e.dir == 4 then body_move(e, 0, e.speed) end
    end
    if aabb(p.x, p.y, p.w, p.h, e.x, e.y, e.w, e.h) then
      hurt_player(e.boss and 2 or 1)
    end
  end
  for i = #WORLD.shots, 1, -1 do
    local s = WORLD.shots[i]
    s.x = s.x + s.vx
    s.y = s.y + s.vy
    s.t = s.t - 1
    if s.t <= 0 or solid_px(s.x, s.y) then
      table.remove(WORLD.shots, i)
    elseif aabb(p.x, p.y, p.w, p.h, s.x - 2, s.y - 2, 4, 4) then
      hurt_player(1)
      table.remove(WORLD.shots, i)
    end
  end
end

