local function clamp(v, a, b)
  if v < a then return a end
  if v > b then return b end
  return v
end

local function sign(v)
  if v < 0 then return -1 end
  if v > 0 then return 1 end
  return 0
end

local function aabb(ax, ay, aw, ah, bx, by, bw, bh)
  return ax < bx + bw and ax + aw > bx and ay < by + bh and ay + ah > by
end

local function dist(ax, ay, bx, by)
  local dx, dy = ax - bx, ay - by
  return math.sqrt(dx * dx + dy * dy)
end

local function text_w(s, scale)
  return #s * 6 * (scale or 1)
end

local function center_text(s, y, col, scale)
  print(s, math.floor((CFG.sw - text_w(s, scale)) / 2), y, col, scale)
end

function clear_tile(id, vram)
  local addr = vram + id * 32
  for i = 0, 31 do poke(addr + i, 0) end
end

function write_pixel(id, x, y, color, vram)
  local addr = vram + id * 32 + y * 4 + math.floor(x / 2)
  local b = peek(addr)
  if x % 2 == 0 then
    poke(addr, (b - b % 16) + color * 16)
  else
    poke(addr, (b - b % 16) + color)
  end
end

function load_art(art, base_id, vram)
  local sw, sh = #art[1], #art
  for ty = 0, math.floor((sh - 1) / 8) do
    for tx = 0, math.floor((sw - 1) / 8) do
      clear_tile(base_id + tx + ty * 16, vram)
    end
  end
  for y = 1, sh do
    local row = art[y]
    for x = 1, sw do
      local c = row:sub(x, x)
      if c ~= "0" and c ~= "." then
        local id = base_id + math.floor((x - 1) / 8) + math.floor((y - 1) / 8) * 16
        write_pixel(id, (x - 1) % 8, (y - 1) % 8, tonumber(c, 16), vram)
      end
    end
  end
end

