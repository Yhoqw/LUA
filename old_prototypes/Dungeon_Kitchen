local function draw_world()
  cls(0)
  map(0, 0, CFG.gw, CFG.gh, 0, 0)
  for i = 1, #WORLD.drops do
    local d = WORLD.drops[i]
    local bob = math.sin((GAME.t + d.bob * 10) / 12) * 2
    spr(PARTS[d.kind].spr, math.floor(d.x - 4), math.floor(d.y - 4 + bob), 0, 1, false, 0, 1, 1)
  end
  if WORLD.fire then
    local pulse = math.sin(GAME.t / 8) * 1
    spr(SPR.fire, math.floor(WORLD.fire.x - 8), math.floor(WORLD.fire.y - 8 + pulse), 0, 1, false, 0, 2, 2)
  end
  if WORLD.npc then
    draw_actor(SPR.npc, WORLD.npc.x - 8, WORLD.npc.y - 8, false)
    if not WORLD.npc.fed then print("!", math.floor(WORLD.npc.x - 1), math.floor(WORLD.npc.y - 18), 10) end
  end
  if WORLD.stairs then
    spr(SPR.stairs, math.floor(WORLD.stairs.x - 8), math.floor(WORLD.stairs.y - 8), 0, 1, false, 0, 2, 2)
  end
  for i = 1, #WORLD.enemies do
    local e = WORLD.enemies[i]
    local id = SPR.slime
    if e.kind == "bat" then id = SPR.bat
    elseif e.kind == "shroom" then id = SPR.shroom
    elseif e.kind == "boss" then id = SPR.boss end
    if e.boss then
      spr(id, math.floor(e.x - 2), math.floor(e.y - 2), 0, 2, false, 0, 2, 2)
    else
      draw_actor(id, e.x - 2, e.y - 2, e.x > WORLD.player.x)
    end
  end
  for i = 1, #WORLD.shots do
    local s = WORLD.shots[i]
    circ(math.floor(s.x), math.floor(s.y), 2, s.col)
    circb(math.floor(s.x), math.floor(s.y), 2, 0)
  end
  local p = WORLD.player
  local blink = p.invuln > 0 and math.floor(GAME.t / 4) % 2 == 0
  if not blink then
    draw_actor(SPR.player, p.x - 2, p.y - 2, p.face < 0)
  end
  if p.attack_t > 0 then
    local ax = p.face > 0 and p.x + p.w or p.x - 12
    rect(ax, p.y + 3, 12, 8, 7)
    rectb(ax, p.y + 3, 12, 8, 10)
  end
  for i = 1, #WORLD.fx do
    local f = WORLD.fx[i]
    rect(math.floor(f.x), math.floor(f.y), 1, 1, f.col)
  end
  draw_hud()
  if GAME.menu then draw_menu() end
  if GAME.shake > 0 then GAME.shake = GAME.shake - 1 end
end

function update_title()
  if btnp(INPUT.attack) or btnp(INPUT.use) then
    reset_game()
    GAME.state = "play"
  end
end

function update_play()
  if GAME.menu then
    update_menu()
  else
    update_player()
    update_enemies()
  end
  update_fx()
  if GAME.msg_t > 0 then GAME.msg_t = GAME.msg_t - 1 end
  if GAME.floor_msg_t > 0 then GAME.floor_msg_t = GAME.floor_msg_t - 1 end
end

local function draw_end(win)
  cls(0)
  for i = 1, 60 do
    rect((i * 47) % 240, (i * 29) % 136, 1, 1, win and 11 or 8)
  end
  center_text(win and "FEAST COMPLETE" or "THE DUNGEON EATS WELL", 34, win and 10 or 8, 2)
  center_text("FLOOR " .. GAME.floor .. "   SEASON " .. WORLD.season.name, 58, 7, 1)
  center_text("MEALS COOKED: " .. GAME.meals_made, 70, 9, 1)
  center_text("PRESS Z TO COOK AGAIN", 98, 10, 1)
end

function TIC()
  GAME.t = GAME.t + 1
  if GAME.state == "title" then
    update_title()
    draw_title()
  elseif GAME.state == "play" then
    update_play()
    draw_world()
  elseif GAME.state == "win" then
    GAME.end_t = GAME.end_t + 1
    if btnp(INPUT.attack) then reset_game() end
    draw_end(true)
  elseif GAME.state == "lose" then
    GAME.end_t = GAME.end_t + 1
    if btnp(INPUT.attack) then reset_game() end
    draw_end(false)
  end
end

