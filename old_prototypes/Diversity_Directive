local function draw_world()
  cls(0)
  draw_population()
  draw_stats()
  draw_hud()
end

function reset_game()
  math.randomseed(2297)
  GAME.state = CFG.start_title and "title" or "play"
  GAME.t = 0
  GAME.gen = 1
  GAME.trait = 1
  GAME.policy_sel = 1
  GAME.policies = { 1, 1, 0 }
  GAME.unrest = 0
  GAME.msg = ""
  GAME.msg_t = 0
  GAME.log = {}
  GAME.reason = ""
  GAME.end_t = 0
  WORLD.pop = {}
  for i = 1, CFG.pop_size do WORLD.pop[i] = random_citizen() end
  GAME.stats = compute_stats()
  log("THE DIRECTORATE EXPECTS RESULTS")
end

local function update_title()
  if btnp(INPUT.next_gen) or btnp(INPUT.trait) then
    reset_game()
    GAME.state = "play"
  end
end

local function update_play()
  if btnp(INPUT.left) then GAME.policy_sel = GAME.policy_sel - 1 end
  if btnp(INPUT.right) then GAME.policy_sel = GAME.policy_sel + 1 end
  GAME.policy_sel = ((GAME.policy_sel - 1) % #POLICIES) + 1
  if btnp(INPUT.up) then GAME.policies[GAME.policy_sel] = clamp(GAME.policies[GAME.policy_sel] + 1, 0, 3) end
  if btnp(INPUT.down) then GAME.policies[GAME.policy_sel] = clamp(GAME.policies[GAME.policy_sel] - 1, 0, 3) end
  if btnp(INPUT.trait) then
    GAME.trait = (GAME.trait % #TRAITS) + 1
    GAME.stats = compute_stats()
    log("DIRECTIVE TARGETS " .. TRAITS[GAME.trait])
  end
  if btnp(INPUT.next_gen) then advance_generation() end
  if GAME.msg_t > 0 then GAME.msg_t = GAME.msg_t - 1 end
end

local function draw_end(win)
  cls(0)
  for i = 1, 80 do
    local x = (i * 41) % 240
    local y = (i * 27) % 136
    rect(x, y, 1, 1, win and 11 or 8)
  end
  center_text(win and "DIVERSITY HELD" or "DIRECTIVE FAILED", 28, win and 10 or 8, 2)
  center_text(GAME.reason, 50, 7, 1)
  center_text("GEN " .. math.min(GAME.gen, CFG.generations) .. "   QUOTA " .. math.floor(GAME.stats.quota * 100) .. "%   H " .. string.format("%.2f", GAME.stats.avg), 66, 12, 1)
  if win then
    center_text("THEY CALL IT INEFFICIENCY.", 84, 11, 1)
    center_text("YOU CALL IT A POPULATION.", 92, 11, 1)
  else
    center_text("THE GRAPH CALLS IT A COLLAPSE.", 84, 8, 1)
  end
  center_text("PRESS Z TO BEGIN AGAIN", 108, 10, 1)
end

function TIC()
  GAME.t = GAME.t + 1
  if GAME.state == "title" then
    update_title()
    draw_title()
  elseif GAME.state == "play" then
    update_play()
    draw_world()
  elseif GAME.state == "win" then
    GAME.end_t = GAME.end_t + 1
    if btnp(INPUT.next_gen) then reset_game(); GAME.state = "play" end
    draw_end(true)
  elseif GAME.state == "lose" then
    GAME.end_t = GAME.end_t + 1
    if btnp(INPUT.next_gen) then reset_game(); GAME.state = "play" end
    draw_end(false)
  end
end

reset_game()
