  print("A TRAIT  Z NEXT GEN", 150, 107, 5)
  if GAME.msg_t > 0 then print(GAME.msg, 150, 116, 5) end
  print("H " .. string.format("%.2f", GAME.stats.avg) .. "  U " .. math.floor(GAME.unrest), 150, 125, 5)
end

