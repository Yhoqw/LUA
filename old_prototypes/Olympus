CFG = {
  title = "OLYMPUS", sub = "A GOD GAME OF HEROES AND QUESTS", by = "YAZDAN ALI KHAN",
  sw = 240, sh = 136, max_heroes = 3, max_quests = 5,
  favor_win = 12, city_win = 4, bless_cost = 2,
  start_title = true,
}

INPUT = { up = 0, down = 1, left = 2, right = 3, bless = 4, send = 5, end_turn = 6 }

CITIES = {
  { name = "DELPHI", x = 52, y = 36 },
  { name = "THEBES", x = 96, y = 52 },
  { name = "ATHENS", x = 112, y = 78 },
  { name = "CORINTH", x = 74, y = 86 },
  { name = "SPARTA", x = 58, y = 68 },
  { name = "TROY", x = 198, y = 30 },
}

EDGES = {
  { 1, 2 }, { 2, 3 }, { 3, 4 }, { 4, 5 }, { 5, 1 }, { 2, 6 }, { 3, 6 },
}

QUEST_NAMES = {
  "SLAY THE NYMEAN LION", "RECOVER THE GOLDEN FLEECE",
  "CALM THE ORACLE", "PURGE THE SEA CAVE",
  "GUARD THE OLYMPIC ROAD", "TAME THE WHITE BULL",
  "FIND THE LOST HERO", "BREAK THE CULT OF FEAR",
  "SAIL THE BLACK SEA", "STEAL THE FIRE",
}

HERO_FIRST = { "ALEXIOS", "KASSIA", "DOROS", "MELIA", "NIKOS", "THALIA", "ORPHEUS", "HELENE" }
HERO_LAST = { "OF SPARTA", "OF THEBES", "OF ATHENS", "OF TROY", "THE BOLD", "THE WISE", "THE SWIFT" }

GAME = {}
WORLD = {}

local function clamp(v, a, b)
  if v < a then return a end
  if v > b then return b end
  return v
end

local function text_w(s, scale)
  return #s * 6 * (scale or 1)
end

local function center_text(s, y, col, scale)
  print(s, math.floor((CFG.sw - text_w(s, scale)) / 2), y, col, scale)
end

local function log(s)
  GAME.log[#GAME.log + 1] = s
  while #GAME.log > 3 do table.remove(GAME.log, 1) end
  GAME.msg = s
  GAME.msg_t = 100
end

local function player_cities()
  local n = 0
  for i = 1, #WORLD.cities do
    if WORLD.cities[i].pinf >= 3 then n = n + 1 end
  end
  return n
end

local function rival_cities()
  local n = 0
  for i = 1, #WORLD.cities do
    if WORLD.cities[i].rinf >= 3 then n = n + 1 end
  end
  return n
end

local function random_hero(city)
  return {
    name = HERO_FIRST[math.random(1, #HERO_FIRST)] .. " " .. HERO_LAST[math.random(1, #HERO_LAST)],
    city = city or math.random(1, #CITIES),
    might = math.random(1, 5), wits = math.random(1, 5), charm = math.random(1, 5),
    loyalty = math.random(3, 5), blessings = 0, questing = false,
  }
end

local function make_quest()
  return {
    name = QUEST_NAMES[math.random(1, #QUEST_NAMES)],
    city = math.random(1, #CITIES),
    diff = math.random(2, 6),
    reward = math.random(2, 4),
    turns = math.random(2, 4),
    progress = 0,
    assigned = nil,
    rival = false,
  }
end

local function add_quest()
  if #WORLD.quests < CFG.max_quests then
    WORLD.quests[#WORLD.quests + 1] = make_quest()
  end
end

local function selected_hero()
  return WORLD.heroes[GAME.hero_sel]
end

local function selected_quest()
  return WORLD.quests[GAME.quest_sel]
end

local function hero_power(h)
  return (h.might + h.wits + h.charm) / 3
end

local function resolve_quest(q)
  if q.assigned then
    local h = q.assigned
    local chance = clamp(0.18 + (hero_power(h) - q.diff) * 0.12 + h.loyalty * 0.03 + h.blessings * 0.04, 0.08, 0.92)
    if math.random() < chance then
      GAME.favor = GAME.favor + q.reward
      WORLD.cities[q.city].pinf = WORLD.cities[q.city].pinf + 1
      log(h.name .. " WINS " .. q.name)
    else
      h.loyalty = h.loyalty - 1
      if h.loyalty <= 0 then
        h.loyalty = 1
        log(h.name .. " IS DISILLUSIONED")
      else
        log(h.name .. " FAILS " .. q.name)
      end
    end
    h.questing = false
  elseif q.rival then
    local chance = clamp(0.35 + q.diff * 0.04, 0.2, 0.8)
    if math.random() < chance then
      GAME.rival = GAME.rival + q.reward
      WORLD.cities[q.city].rinf = WORLD.cities[q.city].rinf + 1
      log("THE RIVAL WINS " .. q.name)
    else
      log("THE RIVAL FAILS " .. q.name)
    end
  end
end

local function end_turn()
  GAME.turn = GAME.turn + 1
  GAME.favor = GAME.favor + player_cities()
  GAME.rival = GAME.rival + rival_cities()
  for i = #WORLD.quests, 1, -1 do
    local q = WORLD.quests[i]
    if q.assigned or q.rival then
      q.progress = q.progress + 1
      if q.progress >= q.turns then
        resolve_quest(q)
        table.remove(WORLD.quests, i)
      end
    end
  end
  if math.random(1, 10) <= 7 then
    local free = {}
    for i = 1, #WORLD.quests do
      local q = WORLD.quests[i]
      if not q.assigned and not q.rival then free[#free + 1] = q end
    end
    if #free > 0 then
      local q = free[math.random(1, #free)]
      q.rival = true
      q.progress = 0
      log("THE RIVAL CLAIMS " .. q.name)
    end
  end
  if math.random(1, 10) <= 6 then add_quest() end
  if #WORLD.quests < 3 then add_quest() end
  if math.random(1, 6) == 1 then
    local h = WORLD.heroes[math.random(1, #WORLD.heroes)]
    if not h.questing then
      h.loyalty = h.loyalty + 1
      log(h.name .. " PRAISES YOUR NAME")
    end
  end
  GAME.hero_sel = clamp(GAME.hero_sel, 1, #WORLD.heroes)
  GAME.quest_sel = clamp(GAME.quest_sel, 1, math.max(1, #WORLD.quests))
  if GAME.favor >= CFG.favor_win or player_cities() >= CFG.city_win then
    GAME.state = "win"
    GAME.end_t = 0
  elseif GAME.rival >= CFG.favor_win or rival_cities() >= CFG.city_win then
    GAME.state = "lose"
    GAME.end_t = 0
  end
end

local function bless_hero()
  local h = selected_hero()
  if h.questing then
    log("THE HERO IS ON A QUEST")
    return
  end
  if GAME.favor < CFG.bless_cost then
    log("NOT ENOUGH FAVOR")
    return
  end
  GAME.favor = GAME.favor - CFG.bless_cost
  local stat = math.random(1, 3)
  if stat == 1 then h.might = h.might + 1
  elseif stat == 2 then h.wits = h.wits + 1
  else h.charm = h.charm + 1 end
  h.loyalty = h.loyalty + 1
  h.blessings = h.blessings + 1
  log("YOU BLESS " .. h.name)
end

local function send_hero()
  local h = selected_hero()
  local q = selected_quest()
  if h.questing then
    log("THE HERO IS ALREADY QUESTING")
    return
  end
  if not q then
    log("NO QUEST SELECTED")
    return
  end
  if q.assigned or q.rival then
    log("THAT QUEST IS TAKEN")
    return
  end
  q.assigned = h
  q.progress = 0
  h.questing = true
  h.city = q.city
  log(h.name .. " SETS OUT")
end

local function draw_map()
  rect(0, 18, 240, 82, 1)
  for i = 1, 22 do
    line(0, 20 + i * 4, 239, 14 + i * 3, 8)
  end
  tri(24, 26, 86, 14, 60, 96, 3)
  tri(58, 48, 146, 24, 126, 96, 3)
  tri(132, 52, 194, 34, 172, 92, 3)
  tri(174, 18, 214, 12, 208, 48, 4)
  for i = 1, #EDGES do
    local a, b = CITIES[EDGES[i][1]], CITIES[EDGES[i][2]]
    line(a.x, a.y, b.x, b.y, 5)
  end
  for i = 1, #WORLD.cities do
    local c = CITIES[i]
    local inf = WORLD.cities[i]
    circ(c.x, c.y, 5, 0)
    circb(c.x, c.y, 5, inf.pinf >= 3 and 12 or (inf.rinf >= 3 and 8 or 6))
    if inf.pinf > 0 then print("" .. inf.pinf, c.x - 8, c.y - 10, 12) end
    if inf.rinf > 0 then print("" .. inf.rinf, c.x + 4, c.y - 10, 8) end
    print(c.name, c.x - math.floor(#c.name * 3), c.y + 7, 7)
  end
  for i = 1, #WORLD.quests do
    local q = WORLD.quests[i]
    local c = CITIES[q.city]
    local ox = ((i - 1) % 3) * 9 - 9
    local oy = math.floor((i - 1) / 3) * 8 - 3
    local pulse = math.floor(GAME.t / 12) % 2
    if i == GAME.quest_sel then
      circb(c.x + ox, c.y + oy, 5 + pulse, 10)
    end
    circ(c.x + ox, c.y + oy, 3, q.rival and 8 or 10)
    circb(c.x + ox, c.y + oy, 3, 0)
  end
  for i = 1, #WORLD.heroes do
    local h = WORLD.heroes[i]
    local c = CITIES[h.city]
    local ox = (i - 1) * 8 - 8
    circ(c.x + ox, c.y + 15, 3, 12)
    circb(c.x + ox, c.y + 15, 3, i == GAME.hero_sel and 10 or 0)
    print(string.sub(h.name, 1, 1), c.x + ox - 2, c.y + 12, 0)
  end
  for i = 1, #GAME.log do
    print(GAME.log[i], 4, 88 + (i - 1) * 5, 5)
  end
end

local function draw_hud()
  rect(0, 0, 240, 18, 0)
  line(0, 18, 239, 18, 5)
  print("FAVOR " .. GAME.favor, 4, 4, 10)
  print("RIVAL " .. GAME.rival, 74, 4, 8)
  print("TURN " .. GAME.turn, 144, 4, 7)
  print("CITIES " .. player_cities() .. "/" .. CFG.city_win, 190, 4, 12)
  print("L/R U/D  X SEND  Z BLESS  A END", 4, 12, 5)
  rect(0, 100, 240, 36, 0)
  line(0, 100, 239, 100, 5)
  local h = selected_hero()
  local q = selected_quest()
  print("HERO " .. h.name, 4, 104, 12)
  print("M" .. h.might .. " W" .. h.wits .. " C" .. h.charm .. " L" .. h.loyalty, 4, 112, 7)
  if h.questing then print("ON QUEST", 96, 112, 10) end
  if q then
    print("QUEST " .. q.name, 4, 120, 10)
    print("DIFF " .. q.diff .. "  REWARD " .. q.reward .. "  TURNS " .. q.turns, 4, 128, 5)
  else
    print("NO QUESTS", 4, 120, 5)
  end
end

local function draw_title()
  cls(0)
  for i = 1, 80 do
    local x = (i * 37) % 240
    local y = (i * 23) % 120 + 8
    circ(x, y, 1, i % 4 == 0 and 10 or 12)
  end
  center_text(CFG.title, 16, 10, 3)
  center_text(CFG.sub, 44, 7, 1)
  center_text("L/R SELECT HERO   U/D SELECT QUEST", 64, 7, 1)
  center_text("X SEND   Z BLESS   A END TURN", 74, 7, 1)
  center_text("GUIDE DEMIGODS. CLAIM CITIES. OUTSHINE THE RIVAL.", 90, 5, 1)
  center_text("PRESS Z TO ASCEND", 112, 10, 1)
  center_text(CFG.by, 128, 5, 1)
end

local function draw_world()
  cls(0)
  draw_map()
  draw_hud()
end

function reset_game()
  math.randomseed(6131)
  GAME.state = CFG.start_title and "title" or "play"
  GAME.t = 0
  GAME.turn = 1
  GAME.favor = 0
  GAME.rival = 0
  GAME.hero_sel = 1
  GAME.quest_sel = 1
  GAME.msg = ""
  GAME.msg_t = 0
  GAME.log = {}
  GAME.end_t = 0
  WORLD.cities = {}
  for i = 1, #CITIES do
    WORLD.cities[i] = { pinf = 0, rinf = 0 }
  end
  WORLD.cities[3].pinf = 1
  WORLD.cities[5].rinf = 1
  WORLD.heroes = {}
  for i = 1, CFG.max_heroes do
    WORLD.heroes[i] = random_hero(math.random(1, #CITIES))
  end
  WORLD.quests = {}
  for i = 1, 3 do add_quest() end
end

local function update_title()
  if btnp(INPUT.bless) or btnp(INPUT.send) then
    reset_game()
    GAME.state = "play"
  end
end

local function update_play()
  if btnp(INPUT.left) then GAME.hero_sel = GAME.hero_sel - 1 end
  if btnp(INPUT.right) then GAME.hero_sel = GAME.hero_sel + 1 end
  GAME.hero_sel = ((GAME.hero_sel - 1) % #WORLD.heroes) + 1
  if #WORLD.quests > 0 then
    if btnp(INPUT.up) then GAME.quest_sel = GAME.quest_sel - 1 end
    if btnp(INPUT.down) then GAME.quest_sel = GAME.quest_sel + 1 end
    GAME.quest_sel = ((GAME.quest_sel - 1) % #WORLD.quests) + 1
  else
    GAME.quest_sel = 1
  end
  if btnp(INPUT.bless) then bless_hero() end
  if btnp(INPUT.send) then send_hero() end
  if btnp(INPUT.end_turn) then end_turn() end
  if GAME.msg_t > 0 then GAME.msg_t = GAME.msg_t - 1 end
end

local function draw_end(win)
  cls(0)
  for i = 1, 80 do
    local x = (i * 41) % 240
    local y = (i * 27) % 136
    circ(x, y, 1, win and 10 or 8)
  end
  center_text(win and "OLYMPUS ACCLAIMS YOU" or "THE RIVAL ASCENDS", 30, win and 10 or 8, 2)
  center_text("TURN " .. GAME.turn .. "   FAVOR " .. GAME.favor .. "   CITIES " .. player_cities(), 54, 7, 1)
  center_text("PRESS Z TO BEGIN AGAIN", 96, 10, 1)
end

function TIC()
  GAME.t = GAME.t + 1
  if GAME.state == "title" then
    update_title()
    draw_title()
  elseif GAME.state == "play" then
    update_play()
    draw_world()
  elseif GAME.state == "win" then
    GAME.end_t = GAME.end_t + 1
    if btnp(INPUT.bless) then reset_game() end
    draw_end(true)
  elseif GAME.state == "lose" then
    GAME.end_t = GAME.end_t + 1
    if btnp(INPUT.bless) then reset_game() end
    draw_end(false)
  end
end

reset_game()
