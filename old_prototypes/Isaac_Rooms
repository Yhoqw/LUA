local function key_of(gx, gy)
  return gx .. "," .. gy
end

local function room_at(gx, gy)
  return FLOOR.grid[key_of(gx, gy)]
end

local function add_fx(x, y, col, n)
  for i = 1, n do
    WORLD.fx[#WORLD.fx + 1] = {
      x = x, y = y, vx = math.random(-14, 14) / 10,
      vy = math.random(-14, 14) / 10, t = math.random(12, 28), col = col,
    }
  end
end

local function make_enemy(kind, x, y)
  local e = { kind = kind, x = x, y = y, w = 12, h = 12, hp = 2, speed = 0.5, shoot_cd = 80, t = math.random(0, 50), flash = 0 }
  if kind == "fly" then
    e.hp, e.speed = 2, 0.7
  elseif kind == "gaper" then
    e.hp, e.speed = 3, 0.45
  elseif kind == "hopper" then
    e.hp, e.speed = 2, 0.9
  elseif kind == "boss" then
    e.w, e.h, e.hp, e.speed = 28, 28, 22 + GAME.floor * 9, 0.28
    e.boss = true
    e.shoot_cd = 70
  end
  return e
end

local function blocked_by_obstacle(r, tx, ty)
  for i = 1, #r.obstacles do
    local o = r.obstacles[i]
    if tx >= o.x and tx < o.x + o.w and ty >= o.y and ty < o.y + o.h then return true end
  end
  return false
end

local function spawn_enemy(r, kind, tx, ty)
  r.enemies[#r.enemies + 1] = make_enemy(kind, tx * 8, ty * 8)
end

local function fill_room_enemies(r)
  local count = 2 + GAME.floor + math.random(0, 2)
  if count > 6 then count = 6 end
  local spots = {
    { 6, 4 }, { 22, 4 }, { 6, 12 }, { 22, 12 },
    { 14, 4 }, { 14, 12 }, { 9, 8 }, { 20, 8 },
  }
  for i = 1, count do
    local s = spots[math.random(1, #spots)]
    local tx, ty = s[1], s[2]
    if not blocked_by_obstacle(r, tx, ty) then
      local roll = math.random(1, 10)
      local kind = "fly"
      if roll <= 4 then kind = "fly"
      elseif roll <= 7 then kind = "gaper"
      else kind = "hopper" end
      if GAME.floor >= 2 and math.random(1, 3) == 1 then kind = "gaper" end
      spawn_enemy(r, kind, tx, ty)
    end
  end
end

local function ensure_room(r)
  if not r.init then
    r.init = true
    if r.type == "normal" then
      fill_room_enemies(r)
    elseif r.type == "boss" then
      spawn_enemy(r, "boss", 14, 7)
    elseif r.type == "item" then
      local keys = { "heart", "damage", "speed", "tears", "bomb" }
      r.item = keys[math.random(1, #keys)]
    end
    if #r.enemies == 0 then r.cleared = true end
  end
  r.visited = true
end

local function open_doors(r)
  if r ~= GAME.room then return end
  local sides = {
    { "n", 0, -1, 14, 0, 15, 0 },
    { "s", 0, 1, 14, 16, 15, 16 },
    { "w", -1, 0, 0, 8, 0, 9 },
    { "e", 1, 0, 29, 8, 29, 9 },
  }
  for i = 1, #sides do
    local s = sides[i]
    if room_at(r.gx + s[2], r.gy + s[3]) then
      mset(s[4], s[5], TILE.door)
      mset(s[6], s[7], TILE.door)
    end
  end
end

local function build_room_map(r)
  for y = 0, CFG.rh - 1 do
    for x = 0, CFG.rw - 1 do mset(x, y, TILE.wall) end
  end
  for y = 1, CFG.rh - 2 do
    for x = 1, CFG.rw - 2 do mset(x, y, TILE.floor) end
  end
  for i = 1, #r.obstacles do
    local o = r.obstacles[i]
    for y = o.y, o.y + o.h - 1 do
      for x = o.x, o.x + o.w - 1 do
        if x > 0 and x < CFG.rw - 1 and y > 0 and y < CFG.rh - 1 then mset(x, y, TILE.wall) end
      end
    end
  end
  local door_tile = r.cleared and TILE.door or TILE.closed
  local sides = {
    { "n", 0, -1, 14, 0, 15, 0 },
    { "s", 0, 1, 14, 16, 15, 16 },
    { "w", -1, 0, 0, 8, 0, 9 },
    { "e", 1, 0, 29, 8, 29, 9 },
  }
  for i = 1, #sides do
    local s = sides[i]
    if room_at(r.gx + s[2], r.gy + s[3]) then
      mset(s[4], s[5], door_tile)
      mset(s[6], s[7], door_tile)
    end
  end
end

local function place_player(entry)
  local p = WORLD.player
  if entry == "w" then p.x, p.y = 12, 61
  elseif entry == "e" then p.x, p.y = 216, 61
  elseif entry == "n" then p.x, p.y = 114, 12
  elseif entry == "s" then p.x, p.y = 114, 110
  else p.x, p.y = 114, 61 end
end

local function load_room(r, entry)
  ensure_room(r)
  GAME.room = r
  GAME.room_key = key_of(r.gx, r.gy)
  WORLD.enemies = r.enemies
  WORLD.pickups = r.pickups
  WORLD.shots = {}
  WORLD.tears = {}
  WORLD.bombs = {}
  WORLD.trapdoor = r.trapdoor
  build_room_map(r)
  place_player(entry)
  GAME.trans_cd = CFG.trans_cd
end

local function transition(dir)
  local r = GAME.room
  local nx, ny = r.gx, r.gy
  local entry = "center"
  if dir == "w" then nx, ny, entry = nx - 1, ny, "e"
  elseif dir == "e" then nx, ny, entry = nx + 1, ny, "w"
  elseif dir == "n" then nx, ny, entry = nx, ny - 1, "s"
  elseif dir == "s" then nx, ny, entry = nx, ny + 1, "n" end
  local nr = room_at(nx, ny)
  if nr then
    WORLD.shots = {}
    load_room(nr, entry)
  end
end

local function hurt_player(n)
  local p = WORLD.player
  if GAME.state ~= "play" or p.invuln > 0 then return end
  p.hp = p.hp - n
  p.invuln = CFG.invuln
  GAME.shake = 6
  sfx(SFX.hurt)
  if p.hp <= 0 then
    p.hp = 0
    GAME.state = "lose"
    GAME.end_t = 0
  end
end

local function apply_item(kind)
  local p = WORLD.player
  if kind == "heart" then
    p.max_hp = p.max_hp + 1
    p.hp = p.max_hp
  elseif kind == "damage" then
    p.damage = p.damage + 1
  elseif kind == "speed" then
    p.speed = p.speed + 0.18
  elseif kind == "tears" then
    p.fire_cd_max = math.max(5, p.fire_cd_max - 3)
  elseif kind == "bomb" then
    p.bombs = p.bombs + 2
  end
  msg(ITEMS[kind].name)
  sfx(SFX.item)
end

local function check_clear(r)
  if #r.enemies == 0 and not r.cleared then
    r.cleared = true
    open_doors(r)
    if r.type == "boss" then
      r.trapdoor = true
      WORLD.trapdoor = true
      msg("THE FLOOR IS CLEAR. FIND THE TRAPDOOR.")
      sfx(SFX.win)
    else
      if math.random(1, 10) <= 4 then
        r.pickups[#r.pickups + 1] = { kind = "heart", x = 14 * 8 + 4, y = 8 * 8 + 4 }
      elseif math.random(1, 10) <= 2 then
        r.pickups[#r.pickups + 1] = { kind = "bomb", x = 14 * 8 + 4, y = 8 * 8 + 4 }
      end
      msg("ROOM CLEARED")
      sfx(SFX.clear)
    end
  end
end

local function kill_enemy(e)
  local r = GAME.room
  for i = #r.enemies, 1, -1 do
    if r.enemies[i] == e then table.remove(r.enemies, i) end
  end
  add_fx(e.x + e.w / 2, e.y + e.h / 2, 8, 8)
  sfx(SFX.hit)
  check_clear(r)
end

local function fire_tear()
  local p = WORLD.player
  local dx, dy = 0, 0
  if p.dir == "left" then dx = -1
  elseif p.dir == "right" then dx = 1
  elseif p.dir == "up" then dy = -1
  else dy = 1 end
  local ox, oy = p.x + p.w / 2 + dx * 8, p.y + p.h / 2 + dy * 8
  WORLD.tears[#WORLD.tears + 1] = {
    x = ox, y = oy, vx = dx * CFG.tear_speed, vy = dy * CFG.tear_speed,
    t = 70, damage = p.damage,
  }
  sfx(SFX.shoot)
end

local generate_floor

local function update_player()
  local p = WORLD.player
  local dx, dy = 0, 0
  if btn(INPUT.left) then dx = -p.speed; p.dir = "left" end
  if btn(INPUT.right) then dx = p.speed; p.dir = "right" end
  if btn(INPUT.up) then dy = -p.speed; p.dir = "up" end
  if btn(INPUT.down) then dy = p.speed; p.dir = "down" end
  if dx ~= 0 and dy ~= 0 then dx, dy = dx * 0.7071, dy * 0.7071 end
  body_move(p, dx, dy)
  if p.invuln > 0 then p.invuln = p.invuln - 1 end
  if p.fire_cd > 0 then p.fire_cd = p.fire_cd - 1 end
  if btn(INPUT.fire) and p.fire_cd <= 0 then
    p.fire_cd = p.fire_cd_max
    fire_tear()
  end
  if btnp(INPUT.use) then
    if WORLD.trapdoor and dist(p.x + p.w / 2, p.y + p.h / 2, 14 * 8 + 4, 8 * 8 + 4) < 18 then
      if GAME.floor >= CFG.floors then
        GAME.state = "win"
        GAME.end_t = 0
        sfx(SFX.win)
        return
      else
        GAME.floor = GAME.floor + 1
        generate_floor()
        msg("FLOOR " .. GAME.floor)
        return
      end
    elseif p.bombs > 0 then
      p.bombs = p.bombs - 1
      WORLD.bombs[#WORLD.bombs + 1] = { x = p.x + p.w / 2, y = p.y + p.h / 2, t = CFG.bomb_fuse }
      sfx(SFX.boom)
    end
  end
  local r = GAME.room
  if r.item and not r.item_taken then
    if dist(p.x + p.w / 2, p.y + p.h / 2, 14 * 8 + 4, 8 * 8 + 4) < 14 then
      r.item_taken = true
      apply_item(r.item)
    end
  end
  for i = #r.pickups, 1, -1 do
    local k = r.pickups[i]
    if dist(p.x + p.w / 2, p.y + p.h / 2, k.x, k.y) < 12 then
      if k.kind == "heart" then
        p.hp = clamp(p.hp + 2, 0, p.max_hp)
        msg("HEART")
      else
        p.bombs = p.bombs + 1
        msg("BOMB")
      end
      table.remove(r.pickups, i)
      sfx(SFX.item)
    end
  end
  if GAME.trans_cd > 0 then
    GAME.trans_cd = GAME.trans_cd - 1
  elseif GAME.state == "play" then
    if p.x < 1 and room_at(r.gx - 1, r.gy) then transition("w")
    elseif p.x + p.w > 239 and room_at(r.gx + 1, r.gy) then transition("e")
    elseif p.y < 1 and room_at(r.gx, r.gy - 1) then transition("n")
    elseif p.y + p.h > 135 and room_at(r.gx, r.gy + 1) then transition("s") end
  end
end

local function update_tears()
  local r = GAME.room
  for i = #WORLD.tears, 1, -1 do
    local t = WORLD.tears[i]
    t.x = t.x + t.vx
    t.y = t.y + t.vy
    t.t = t.t - 1
    local hit = false
    if t.t <= 0 or solid_px(t.x, t.y) then
      hit = true
    else
      for j = #r.enemies, 1, -1 do
        local e = r.enemies[j]
        if aabb(t.x - 3, t.y - 3, 6, 6, e.x, e.y, e.w, e.h) then
          e.hp = e.hp - t.damage
          e.flash = 6
          add_fx(t.x, t.y, 12, 3)
          hit = true
          if e.hp <= 0 then kill_enemy(e) end
          break
        end
      end
    end
    if hit then table.remove(WORLD.tears, i) end
  end
end

local function update_enemies()
  local p = WORLD.player
  local r = GAME.room
  local px, py = p.x + p.w / 2, p.y + p.h / 2
  for i = #r.enemies, 1, -1 do
    local e = r.enemies[i]
    if e.flash > 0 then e.flash = e.flash - 1 end
    local ex, ey = e.x + e.w / 2, e.y + e.h / 2
    local dx, dy = px - ex, py - ey
    local d = dist(px, py, ex, ey)
    if e.kind == "fly" then
      e.x = e.x + sign(dx) * e.speed
      e.y = e.y + sign(dy) * e.speed
      e.x = clamp(e.x, 8, 232 - e.w)
      e.y = clamp(e.y, 8, 128 - e.h)
    elseif e.kind == "gaper" then
      if d < 140 then body_move(e, sign(dx) * e.speed, sign(dy) * e.speed) end
    elseif e.kind == "hopper" then
      e.t = e.t - 1
      if e.t <= 0 then
        e.t = math.random(28, 50)
        e.jx, e.jy = sign(dx) * e.speed * 2, sign(dy) * e.speed * 2
      end
      if e.jx then
        body_move(e, e.jx, e.jy)
        e.jx = e.jx * 0.9
        e.jy = e.jy * 0.9
        if math.abs(e.jx) < 0.05 then e.jx = nil; e.jy = nil end
      end
    elseif e.boss then
      if d > 38 then body_move(e, sign(dx) * e.speed, sign(dy) * e.speed) end
      e.shoot_cd = e.shoot_cd - 1
      if e.shoot_cd <= 0 then
        e.shoot_cd = 75
        local len = math.sqrt(dx * dx + dy * dy)
        if len < 1 then len = 1 end
        for k = -1, 1 do
          WORLD.shots[#WORLD.shots + 1] = {
            x = ex, y = ey, vx = dx / len * 1.5 + k * 0.7,
            vy = dy / len * 1.5 + k * 0.7, t = 160, col = 8,
          }
        end
      end
    end
    if aabb(p.x, p.y, p.w, p.h, e.x, e.y, e.w, e.h) then hurt_player(1) end
  end
  for i = #WORLD.shots, 1, -1 do
    local s = WORLD.shots[i]
    s.x = s.x + s.vx
    s.y = s.y + s.vy
    s.t = s.t - 1
    if s.t <= 0 or solid_px(s.x, s.y) then
      table.remove(WORLD.shots, i)
    elseif aabb(p.x, p.y, p.w, p.h, s.x - 2, s.y - 2, 4, 4) then
      hurt_player(1)
      table.remove(WORLD.shots, i)
    end
  end
end

local function update_bombs()
  for i = #WORLD.bombs, 1, -1 do
    local b = WORLD.bombs[i]
    b.t = b.t - 1
    if b.t <= 0 then
      add_fx(b.x, b.y, 10, 18)
      for j = #GAME.room.enemies, 1, -1 do
        local e = GAME.room.enemies[j]
        if dist(b.x, b.y, e.x + e.w / 2, e.y + e.h / 2) < CFG.bomb_radius then
          e.hp = e.hp - 4
          e.flash = 8
          if e.hp <= 0 then kill_enemy(e) end
        end
      end
      sfx(SFX.boom)
      table.remove(WORLD.bombs, i)
    end
  end
end

local function update_fx()
  for i = #WORLD.fx, 1, -1 do
    local f = WORLD.fx[i]
    f.x = f.x + f.vx
    f.y = f.y + f.vy
    f.vy = f.vy + 0.04
    f.t = f.t - 1
    if f.t <= 0 then table.remove(WORLD.fx, i) end
  end
end

