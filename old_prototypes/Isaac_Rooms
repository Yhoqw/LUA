local function draw_world()
  cls(0)
  map(0, 0, CFG.rw, CFG.rh, 0, 0)
  local r = GAME.room
  if r.item and not r.item_taken then
    local bob = math.sin(GAME.t / 9) * 2
    rect(14 * 8, 8 * 8 + bob, 8, 8, 0)
    spr(ITEMS[r.item].spr, 14 * 8, 8 * 8 + bob, 0, 1, false, 0, 1, 1)
  end
  if WORLD.trapdoor then
    spr(SPR.trapdoor, 14 * 8 - 4, 8 * 8 - 4, 0, 1, false, 0, 2, 2)
  end
  for i = 1, #r.pickups do
    local k = r.pickups[i]
    spr(k.kind == "heart" and SPR.heart or SPR.bomb, math.floor(k.x - 4), math.floor(k.y - 4), 0, 1, false, 0, 1, 1)
  end
  for i = 1, #WORLD.bombs do
    local b = WORLD.bombs[i]
    local pulse = math.floor(GAME.t / 5) % 2
    circ(math.floor(b.x), math.floor(b.y), 4 + pulse, 5)
    circb(math.floor(b.x), math.floor(b.y), 4 + pulse, 0)
  end
  for i = 1, #r.enemies do
    local e = r.enemies[i]
    local id = SPR.fly
    if e.kind == "gaper" then id = SPR.gaper
    elseif e.kind == "hopper" then id = SPR.hopper
    elseif e.kind == "boss" then id = SPR.boss end
    if e.boss then
      spr(id, math.floor(e.x - 2), math.floor(e.y - 2), 0, 2, false, 0, 2, 2)
    else
      local blink = e.flash > 0 and math.floor(GAME.t / 2) % 2 == 0
      if not blink then draw_actor(id, e.x - 2, e.y - 2, e.x > WORLD.player.x) end
    end
  end
  for i = 1, #WORLD.shots do
    local s = WORLD.shots[i]
    spr(SPR.shot, math.floor(s.x - 4), math.floor(s.y - 4), 0, 1, false, 0, 1, 1)
  end
  for i = 1, #WORLD.tears do
    local t = WORLD.tears[i]
    spr(SPR.tear, math.floor(t.x - 4), math.floor(t.y - 4), 0, 1, false, 0, 1, 1)
  end
  local p = WORLD.player
  local blink = p.invuln > 0 and math.floor(GAME.t / 4) % 2 == 0
  if not blink then draw_actor(SPR.player, p.x - 2, p.y - 2, p.dir == "left") end
  for i = 1, #WORLD.fx do
    local f = WORLD.fx[i]
    rect(math.floor(f.x), math.floor(f.y), 1, 1, f.col)
  end
  draw_hud()
end

function generate_floor()
  FLOOR.grid = {}
  FLOOR.list = {}
  local function add_room(gx, gy, kind)
    local r = {
      gx = gx, gy = gy, type = kind or "normal",
      visited = false, cleared = kind == "start" or kind == "item",
      enemies = {}, pickups = {}, obstacles = {},
      init = false, item = nil, item_taken = false, trapdoor = false,
    }
    if kind == "start" then r.cleared = true end
    for i = 1, math.random(2, 5) do
      local ox = math.random(4, 24)
      local oy = math.random(3, 12)
      if ox < 12 or ox > 17 or oy < 6 or oy > 10 then
        r.obstacles[#r.obstacles + 1] = { x = ox, y = oy, w = 1, h = 1 }
      end
    end
    FLOOR.grid[key_of(gx, gy)] = r
    FLOOR.list[#FLOOR.list + 1] = r
  end
  add_room(4, 4, "start")
  local dirs = { { 1, 0 }, { -1, 0 }, { 0, 1 }, { 0, -1 } }
  local tries = 0
  while #FLOOR.list < CFG.rooms and tries < 400 do
    tries = tries + 1
    local base = FLOOR.list[math.random(1, #FLOOR.list)]
    local d = dirs[math.random(1, 4)]
    local nx, ny = base.gx + d[1], base.gy + d[2]
    if nx >= 1 and nx <= CFG.grid and ny >= 1 and ny <= CFG.grid and not room_at(nx, ny) then
      add_room(nx, ny)
    end
  end
  local boss, best = nil, -1
  for i = 1, #FLOOR.list do
    local r = FLOOR.list[i]
    if r.type ~= "start" then
      local d = math.abs(r.gx - 4) + math.abs(r.gy - 4)
      if d > best then best, boss = d, r end
    end
  end
  if boss then boss.type = "boss" end
  local items = 0
  for i = #FLOOR.list, 1, -1 do
    local r = FLOOR.list[i]
    local d = math.abs(r.gx - 4) + math.abs(r.gy - 4)
    if r.type == "normal" and d >= 2 and items < 2 then
      r.type = "item"
      r.cleared = true
      items = items + 1
    end
  end
  GAME.room = nil
  load_room(FLOOR.grid["4,4"], "center")
end

function reset_game()
  math.randomseed(4417)
  GAME.state = CFG.start_title and "title" or "play"
  GAME.t = 0
  GAME.floor = 1
  GAME.msg = ""
  GAME.msg_t = 0
  GAME.shake = 0
  GAME.trans_cd = 0
  GAME.end_t = 0
  GAME.room = nil
  GAME.room_key = ""
  WORLD.player = {
    x = 114, y = 61, w = 12, h = 14, dir = "down",
    hp = CFG.hp, max_hp = CFG.hp, damage = 1, speed = CFG.speed,
    fire_cd = 0, fire_cd_max = CFG.fire_cd, bombs = 1, invuln = 0,
  }
  WORLD.tears = {}
  WORLD.shots = {}
  WORLD.bombs = {}
  WORLD.fx = {}
  WORLD.pickups = {}
  WORLD.trapdoor = false
  generate_floor()
end

function update_title()
  if btnp(INPUT.fire) or btnp(INPUT.use) then
    reset_game()
    GAME.state = "play"
  end
end

function update_play()
  update_player()
  update_tears()
  update_enemies()
  update_bombs()
  update_fx()
  if GAME.msg_t > 0 then GAME.msg_t = GAME.msg_t - 1 end
  if GAME.shake > 0 then GAME.shake = GAME.shake - 1 end
end

local function draw_end(win)
  cls(0)
  for i = 1, 60 do
    rect((i * 47) % 240, (i * 29) % 136, 1, 1, win and 11 or 8)
  end
  center_text(win and "THE BASEMENT BREAKS" or "YOU BECAME A STATUE", 34, win and 10 or 8, 2)
  center_text("FLOOR " .. GAME.floor .. "   DMG " .. WORLD.player.damage, 58, 7, 1)
  center_text("PRESS Z TO RUN AGAIN", 98, 10, 1)
end

function TIC()
  GAME.t = GAME.t + 1
  if GAME.state == "title" then
    update_title()
    draw_title()
  elseif GAME.state == "play" then
    update_play()
    draw_world()
  elseif GAME.state == "win" then
    GAME.end_t = GAME.end_t + 1
    if btnp(INPUT.fire) then reset_game() end
    draw_end(true)
  elseif GAME.state == "lose" then
    GAME.end_t = GAME.end_t + 1
    if btnp(INPUT.fire) then reset_game() end
    draw_end(false)
  end
end

