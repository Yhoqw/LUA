local function solid_tile(tx, ty)
  if tx < 0 or ty < 0 or tx >= CFG.rw or ty >= CFG.rh then return true end
  local t = mget(tx, ty)
  return t == TILE.wall or t == TILE.locked
end

local function solid_px(x, y)
  return solid_tile(math.floor(x / 8), math.floor(y / 8))
end

local function body_move(b, dx, dy)
  b.x = b.x + dx
  if solid_px(b.x, b.y) or solid_px(b.x + b.w - 1, b.y) or solid_px(b.x, b.y + b.h - 1) or solid_px(b.x + b.w - 1, b.y + b.h - 1) then
    b.x = b.x - dx
  end
  b.y = b.y + dy
  if solid_px(b.x, b.y) or solid_px(b.x + b.w - 1, b.y) or solid_px(b.x, b.y + b.h - 1) or solid_px(b.x + b.w - 1, b.y + b.h - 1) then
    b.y = b.y - dy
  end
end

