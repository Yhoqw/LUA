    local col = i <= p.hp and 8 or 1
    rect(4 + (i - 1) * 7, 5, 5, 5, col)
    rectb(4 + (i - 1) * 7, 5, 5, 5, 0)
  end
  spr(SPR.key, 62, 4, 0, 1, false, 0, 1, 1)
  print("" .. GAME.keys, 72, 5, 7)
  draw_minimap()
  if GAME.msg_t > 0 then
    rect(0, 124, 240, 10, 0)
    print(GAME.msg, 4, 126, 10)
  end
end

local function draw_title()
  cls(0)
  for i = 1, 50 do
    local x = (i * 43) % 240
    local y = (i * 29) % 110 + 8
    rect(x, y, 1, 1, 5)
  end
  center_text(CFG.title, 18, 10, 2)
  center_text(CFG.sub, 40, 7, 1)
  center_text("ARROWS MOVE   Z SWORD   X USE", 62, 7, 1)
  center_text("FIND THE KEY. OPEN THE EAST DOOR.", 80, 5, 1)
  center_text("PRESS Z TO ENTER", 104, 10, 1)
  center_text(CFG.by, 124, 5, 1)
end

local function draw_world()
  cls(0)
  map(0, 0, CFG.rw, CFG.rh, 0, 0)
  local st = WORLD.rooms[GAME.room_key]
  if GAME.room.key and not st.key_taken then
    local bob = math.sin(GAME.t / 10) * 2
    spr(SPR.key, 14 * 8 - 4, 8 * 8 - 4 + bob, 0, 1, false, 0, 1, 1)
  end
  if GAME.room.heart and not st.heart_taken then
    local bob = math.sin(GAME.t / 10) * 2
    spr(SPR.heart, 14 * 8 - 4, 8 * 8 - 4 + bob, 0, 1, false, 0, 1, 1)
  end
  for i = 1, #WORLD.enemies do
    local e = WORLD.enemies[i]
    local id = SPR.bat
    if e.kind == "octorok" then id = SPR.octorok
    elseif e.kind == "knight" then id = SPR.knight
    elseif e.kind == "boss" then id = SPR.boss end
    if e.boss then
      spr(id, math.floor(e.x - 2), math.floor(e.y - 2), 0, 2, false, 0, 2, 2)
    else
      local blink = e.flash > 0 and math.floor(GAME.t / 2) % 2 == 0
      if not blink then draw_actor(id, e.x - 2, e.y - 2, e.x > WORLD.player.x) end
    end
  end
  for i = 1, #WORLD.shots do
    local s = WORLD.shots[i]
    circ(math.floor(s.x), math.floor(s.y), 2, s.col)
    circb(math.floor(s.x), math.floor(s.y), 2, 0)
  end
  local p = WORLD.player
  local blink = p.invuln > 0 and math.floor(GAME.t / 4) % 2 == 0
  if not blink then draw_actor(SPR.player, p.x - 2, p.y - 2, p.dir == "left") end
  if p.attack_t > 0 then
    local ax, ay, aw, ah = attack_box()
    rect(ax, ay, aw, ah, 10)
    rectb(ax, ay, aw, ah, 7)
  end
  for i = 1, #WORLD.fx do
    local f = WORLD.fx[i]
    rect(math.floor(f.x), math.floor(f.y), 1, 1, f.col)
  end
  draw_hud()
end

function reset_game()
  math.randomseed(9241)
  GAME.state = CFG.start_title and "title" or "play"
  GAME.t = 0
  GAME.keys = 0
  GAME.keys_used = 0
  GAME.msg = ""
  GAME.msg_t = 0
  GAME.shake = 0
  GAME.trans_cd = 0
  GAME.end_t = 0
  GAME.room = nil
  GAME.room_key = ""
  WORLD.player = {
    x = 114, y = 61, w = 12, h = 14, dir = "down",
    hp = CFG.hp, max_hp = CFG.hp, anim = 0,
    attack_cd = 0, attack_t = 0, attack_done = false, invuln = 0,
  }
  WORLD.rooms = {}
  WORLD.enemies = {}
  WORLD.shots = {}
  WORLD.fx = {}
  load_room(ROOM_LOOKUP["1,2"], "center")
end

function update_title()
  if btnp(INPUT.attack) or btnp(INPUT.use) then
    reset_game()
    GAME.state = "play"
  end
end

function update_play()
  update_player()
  update_enemies()
  update_fx()
  if GAME.msg_t > 0 then GAME.msg_t = GAME.msg_t - 1 end
  if GAME.shake > 0 then GAME.shake = GAME.shake - 1 end
end

local function draw_end(win)
  cls(0)
  for i = 1, 60 do
    rect((i * 47) % 240, (i * 29) % 136, 1, 1, win and 10 or 8)
  end
  center_text(win and "DUNGEON CLEARED" or "THE DUNGEON WINS", 34, win and 10 or 8, 2)
  center_text("KEYS USED: " .. GAME.keys_used, 58, 7, 1)
  center_text("PRESS Z TO RETURN", 98, 10, 1)
end

function TIC()
  GAME.t = GAME.t + 1
  if GAME.state == "title" then
    update_title()
    draw_title()
  elseif GAME.state == "play" then
    update_play()
    draw_world()
  elseif GAME.state == "win" then
    GAME.end_t = GAME.end_t + 1
    if btnp(INPUT.attack) then reset_game() end
    draw_end(true)
  elseif GAME.state == "lose" then
    GAME.end_t = GAME.end_t + 1
    if btnp(INPUT.attack) then reset_game() end
    draw_end(false)
  end
end

load_sprites()
reset_game()
