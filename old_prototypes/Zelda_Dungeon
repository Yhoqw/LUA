local function draw_minimap()
  local x0, y0 = 178, 5
  for gy = 1, 2 do
    for gx = 1, 3 do
      local def = ROOM_LOOKUP[gx .. "," .. gy]
      local st = WORLD.rooms[gx .. "," .. gy]
      local col = 1
      if st and st.visited then col = 5 end
      if def and def.boss then col = st and st.visited and 8 or 2 end
      if GAME.room and GAME.room.gx == gx and GAME.room.gy == gy then col = 10 end
      rect(x0 + (gx - 1) * 11, y0 + (gy - 1) * 8, 9, 6, col)
      rectb(x0 + (gx - 1) * 11, y0 + (gy - 1) * 8, 9, 6, 0)
    end
  end
end

