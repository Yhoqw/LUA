local function make_enemy(kind, x, y)
  local e = { kind = kind, x = x, y = y, w = 12, h = 12, hp = 2, speed = 0.5, shoot_cd = 70, t = math.random(0, 60), dir = math.random(1, 4), flash = 0 }
  if kind == "bat" then
    e.w, e.h, e.hp, e.speed = 12, 8, 2, 0.9
  elseif kind == "octorok" then
    e.w, e.h, e.hp, e.speed = 12, 12, 3, 0
  elseif kind == "knight" then
    e.w, e.h, e.hp, e.speed = 12, 14, 4, 0.55
  elseif kind == "boss" then
    e.w, e.h, e.hp, e.speed = 28, 28, CFG.boss_hp, 0.35
    e.boss = true
    e.shoot_cd = 80
  end
  return e
end

local function ensure_room(def)
  local key = room_key(def)
  local st = WORLD.rooms[key]
  if not st then
    st = { enemies = {}, key_taken = false, heart_taken = false, locked_open = false, visited = false }
    for i = 1, #(def.enemies or {}) do
      local s = def.enemies[i]
      st.enemies[#st.enemies + 1] = make_enemy(s.type, s.x * 8, s.y * 8)
    end
    if def.boss then
      st.enemies[#st.enemies + 1] = make_enemy("boss", 14 * 8, 8 * 8)
    end
    WORLD.rooms[key] = st
  end
  st.visited = true
  return st
end

local function build_room_map(def, st)
  for y = 0, CFG.rh - 1 do
    for x = 0, CFG.rw - 1 do mset(x, y, TILE.wall) end
  end
  for y = 1, CFG.rh - 2 do
    for x = 1, CFG.rw - 2 do mset(x, y, TILE.floor) end
  end
  for i = 1, #(def.obstacles or {}) do
    local o = def.obstacles[i]
    for y = o.y, o.y + o.h - 1 do
      for x = o.x, o.x + o.w - 1 do
        if x > 0 and x < CFG.rw - 1 and y > 0 and y < CFG.rh - 1 then mset(x, y, TILE.wall) end
      end
    end
  end
  local function door_tiles(side, locked)
    local t = locked and TILE.locked or TILE.door
    if side == "n" then mset(14, 0, t); mset(15, 0, t)
    elseif side == "s" then mset(14, 16, t); mset(15, 16, t)
    elseif side == "w" then mset(0, 8, t); mset(0, 9, t)
    elseif side == "e" then mset(29, 8, t); mset(29, 9, t) end
  end
  for side, on in pairs(def.exits) do
    if on then
      local locked = side == "e" and def.locked_e and not st.locked_open
      door_tiles(side, locked)
    end
  end
end

local function place_player(entry)
  local p = WORLD.player
  if entry == "w" then p.x, p.y = 12, 61
  elseif entry == "e" then p.x, p.y = 216, 61
  elseif entry == "n" then p.x, p.y = 114, 12
  elseif entry == "s" then p.x, p.y = 114, 110
  else p.x, p.y = 114, 61 end
end

local function load_room(def, entry)
  local st = ensure_room(def)
  GAME.room = def
  GAME.room_key = room_key(def)
  GAME.state_name = "play"
  WORLD.enemies = st.enemies
  WORLD.shots = WORLD.shots or {}
  WORLD.fx = WORLD.fx or {}
  build_room_map(def, st)
  place_player(entry)
  GAME.trans_cd = CFG.trans_cd
  GAME.msg = ""
  GAME.msg_t = 0
end

local function transition(dir)
  local def = GAME.room
  local nx, ny = def.gx, def.gy
  local entry = "center"
  if dir == "w" then nx, ny, entry = nx - 1, ny, "e"
  elseif dir == "e" then nx, ny, entry = nx + 1, ny, "w"
  elseif dir == "n" then nx, ny, entry = nx, ny - 1, "s"
  elseif dir == "s" then nx, ny, entry = nx, ny + 1, "n" end
  local ndef = ROOM_LOOKUP[nx .. "," .. ny]
  if ndef then load_room(ndef, entry) end
end

local function hurt_player(n)
  local p = WORLD.player
  if GAME.state ~= "play" or p.invuln > 0 then return end
  p.hp = p.hp - n
  p.invuln = CFG.invuln
  GAME.shake = 6
  sfx(SFX.hurt)
  if p.hp <= 0 then
    p.hp = 0
    GAME.state = "lose"
    GAME.end_t = 0
  end
end

local function add_fx(x, y, col, n)
  for i = 1, n do
    WORLD.fx[#WORLD.fx + 1] = {
      x = x, y = y, vx = math.random(-12, 12) / 10,
      vy = math.random(-12, 12) / 10, t = math.random(12, 26), col = col,
    }
  end
end

local function attack_box()
  local p = WORLD.player
  if p.dir == "left" then return p.x - 14, p.y + 2, 14, 12 end
  if p.dir == "right" then return p.x + p.w, p.y + 2, 14, 12 end
  if p.dir == "up" then return p.x + 1, p.y - 14, 12, 14 end
  return p.x + 1, p.y + p.h, 12, 14
end

local function kill_enemy(e)
  local st = WORLD.rooms[GAME.room_key]
  for i = #st.enemies, 1, -1 do
    if st.enemies[i] == e then table.remove(st.enemies, i) end
  end
  add_fx(e.x + e.w / 2, e.y + e.h / 2, 8, 10)
  sfx(SFX.hit)
  if e.boss then
    GAME.state = "win"
    GAME.end_t = 0
    sfx(SFX.win)
  end
end

local function update_player()
  local p = WORLD.player
  local dx, dy = 0, 0
  if btn(INPUT.left) then dx = -CFG.speed; p.dir = "left" end
  if btn(INPUT.right) then dx = CFG.speed; p.dir = "right" end
  if btn(INPUT.up) then dy = -CFG.speed; p.dir = "up" end
  if btn(INPUT.down) then dy = CFG.speed; p.dir = "down" end
  if dx ~= 0 and dy ~= 0 then dx, dy = dx * 0.7071, dy * 0.7071 end
  body_move(p, dx, dy)
  if dx ~= 0 or dy ~= 0 then p.anim = p.anim + 1 else p.anim = 0 end
  if p.invuln > 0 then p.invuln = p.invuln - 1 end
  if p.attack_cd > 0 then p.attack_cd = p.attack_cd - 1 end
  if p.attack_t > 0 then p.attack_t = p.attack_t - 1 end
  if btnp(INPUT.attack) and p.attack_cd <= 0 then
    p.attack_cd = CFG.attack_cd
    p.attack_t = CFG.attack_t
    p.attack_done = false
    sfx(SFX.sword)
  end
  if p.attack_t > 0 and not p.attack_done then
    p.attack_done = true
    local ax, ay, aw, ah = attack_box()
    for i = #WORLD.enemies, 1, -1 do
      local e = WORLD.enemies[i]
      if aabb(ax, ay, aw, ah, e.x, e.y, e.w, e.h) then
        e.hp = e.hp - 2
        e.flash = 6
        add_fx(e.x + e.w / 2, e.y + e.h / 2, 10, 4)
        if e.hp <= 0 then kill_enemy(e) end
      end
    end
  end
  local st = WORLD.rooms[GAME.room_key]
  if st then
    if GAME.room.key and not st.key_taken then
      if dist(p.x + p.w / 2, p.y + p.h / 2, 14 * 8, 8 * 8) < 14 then
        st.key_taken = true
        GAME.keys = GAME.keys + 1
        msg("SMALL KEY")
        sfx(SFX.key)
      end
    end
    if GAME.room.heart and not st.heart_taken then
      if dist(p.x + p.w / 2, p.y + p.h / 2, 14 * 8, 8 * 8) < 14 then
        st.heart_taken = true
        p.max_hp = p.max_hp + 1
        p.hp = p.max_hp
        msg("HEART CONTAINER")
        sfx(SFX.win)
      end
    end
    if GAME.room.locked_e and not st.locked_open and btnp(INPUT.use) then
      local dcx, dcy = 236, 68
      if dist(p.x + p.w / 2, p.y + p.h / 2, dcx, dcy) < 26 then
        if GAME.keys > 0 then
          GAME.keys = GAME.keys - 1
          GAME.keys_used = GAME.keys_used + 1
          st.locked_open = true
          mset(29, 8, TILE.door)
          mset(29, 9, TILE.door)
          msg("THE LOCKED DOOR OPENS")
          sfx(SFX.door)
        else
          msg("A SMALL KEY IS NEEDED")
        end
      end
    end
  end
  if GAME.trans_cd > 0 then
    GAME.trans_cd = GAME.trans_cd - 1
  elseif GAME.state == "play" then
    local def = GAME.room
    if p.x < 1 and def.exits.w then transition("w")
    elseif p.x + p.w > 239 and def.exits.e then transition("e")
    elseif p.y < 1 and def.exits.n then transition("n")
    elseif p.y + p.h > 135 and def.exits.s then transition("s") end
  end
end

local function update_enemies()
  local p = WORLD.player
  local px, py = p.x + p.w / 2, p.y + p.h / 2
  for i = #WORLD.enemies, 1, -1 do
    local e = WORLD.enemies[i]
    if e.flash > 0 then e.flash = e.flash - 1 end
    local ex, ey = e.x + e.w / 2, e.y + e.h / 2
    local d = dist(px, py, ex, ey)
    local dx, dy = px - ex, py - ey
    if e.kind == "bat" then
      if d < 90 then
        body_move(e, sign(dx) * e.speed, sign(dy) * e.speed)
      else
        e.t = e.t - 1
        if e.t <= 0 then e.t = math.random(30, 80); e.dir = math.random(1, 4) end
        if e.dir == 1 then body_move(e, -e.speed, 0)
        elseif e.dir == 2 then body_move(e, e.speed, 0)
        elseif e.dir == 3 then body_move(e, 0, -e.speed)
        elseif e.dir == 4 then body_move(e, 0, e.speed) end
      end
    elseif e.kind == "knight" then
      if d < 130 then body_move(e, sign(dx) * e.speed, sign(dy) * e.speed) end
    elseif e.kind == "octorok" then
      e.shoot_cd = e.shoot_cd - 1
      if e.shoot_cd <= 0 and d < 140 then
        e.shoot_cd = 90
        local len = math.sqrt(dx * dx + dy * dy)
        if len < 1 then len = 1 end
        WORLD.shots[#WORLD.shots + 1] = { x = ex, y = ey, vx = dx / len * 1.5, vy = dy / len * 1.5, t = 140, col = 3 }
      end
    elseif e.boss then
      if d > 34 then body_move(e, sign(dx) * e.speed, sign(dy) * e.speed) end
      e.shoot_cd = e.shoot_cd - 1
      if e.shoot_cd <= 0 then
        e.shoot_cd = 80
        local len = math.sqrt(dx * dx + dy * dy)
        if len < 1 then len = 1 end
        for k = -1, 1 do
          WORLD.shots[#WORLD.shots + 1] = {
            x = ex, y = ey, vx = dx / len * 1.4 + k * 0.7,
            vy = dy / len * 1.4 + k * 0.7, t = 160, col = 2,
          }
        end
      end
    end
    if aabb(p.x, p.y, p.w, p.h, e.x, e.y, e.w, e.h) then
      hurt_player(e.boss and 2 or 1)
    end
  end
  for i = #WORLD.shots, 1, -1 do
    local s = WORLD.shots[i]
    s.x = s.x + s.vx
    s.y = s.y + s.vy
    s.t = s.t - 1
    if s.t <= 0 or solid_px(s.x, s.y) then
      table.remove(WORLD.shots, i)
    elseif aabb(p.x, p.y, p.w, p.h, s.x - 2, s.y - 2, 4, 4) then
      hurt_player(1)
      table.remove(WORLD.shots, i)
    end
  end
end

local function update_fx()
  for i = #WORLD.fx, 1, -1 do
    local f = WORLD.fx[i]
    f.x = f.x + f.vx
    f.y = f.y + f.vy
    f.vy = f.vy + 0.04
    f.t = f.t - 1
    if f.t <= 0 then table.remove(WORLD.fx, i) end
  end
end

