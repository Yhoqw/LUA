CFG = {
  title = "BLOODWORKS", sub = "A BIOPUNK CITY BUILDER", by = "YAZDAN ALI KHAN",
  sw = 240, sh = 136, gw = 11, gh = 8, cell = 16, cell_h = 14, gx = 4, gy = 18,
  tick = 30, start_pop = 8, win_pop = 60, win_hold = 20,
  start_o2 = 20, start_bm = 90, start_en = 20,
  pop_o2 = 0.05, pop_bm = 0.05, pop_en = 0.05,
  grow = 0.55, decay = 0.8,
  start_title = true,
}

INPUT = { up = 0, down = 1, left = 2, right = 3, place = 4, cut = 5, cycle = 6 }

TYPES = {
  empty = { name = "EMPTY", cost = 0, col = 0 },
  vein = { name = "VEIN", cost = 3, col = 8 },
  heart = { name = "HEART", cost = 16, col = 2 },
  lung = { name = "LUNG", cost = 10, col = 12 },
  liver = { name = "LIVER", cost = 10, col = 4 },
  muscle = { name = "MUSCLE", cost = 10, col = 9 },
  nerve = { name = "NERVE", cost = 6, col = 10 },
  gland = { name = "GLAND", cost = 18, col = 14 },
  brain = { name = "BRAIN", cost = 0, col = 13 },
}

BUILD_ORDER = { "vein", "heart", "lung", "liver", "muscle", "nerve", "gland" }

GAME = {}
WORLD = {}

local function clamp(v, a, b)
  if v < a then return a end
  if v > b then return b end
  return v
end

local function text_w(s, scale)
  return #s * 6 * (scale or 1)
end

local function center_text(s, y, col, scale)
  print(s, math.floor((CFG.sw - text_w(s, scale)) / 2), y, col, scale)
end

local function idx(x, y)
  return y * CFG.gw + x
end

local function in_grid(x, y)
  return x >= 0 and y >= 0 and x < CFG.gw and y < CFG.gh
end

local function get_cell(x, y)
  if not in_grid(x, y) then return "empty" end
  return WORLD.grid[idx(x, y)] or "empty"
end

local function set_cell(x, y, t)
  if in_grid(x, y) then WORLD.grid[idx(x, y)] = t end
end

local function is_organ(t)
  return t == "lung" or t == "liver" or t == "muscle" or t == "gland"
end

local function is_blood(t)
  return t == "vein" or t == "heart"
end

local function neighbors(x, y)
  local n = {}
  if in_grid(x - 1, y) then n[#n + 1] = { x - 1, y } end
  if in_grid(x + 1, y) then n[#n + 1] = { x + 1, y } end
  if in_grid(x, y - 1) then n[#n + 1] = { x, y - 1 } end
  if in_grid(x, y + 1) then n[#n + 1] = { x, y + 1 } end
  return n
end

local function msg(s)
  GAME.msg = s
  GAME.msg_t = 100
end

local function build_blood_network()
  local seen = {}
  local q = {}
  for y = 0, CFG.gh - 1 do
    for x = 0, CFG.gw - 1 do
      if get_cell(x, y) == "heart" then
        seen[idx(x, y)] = true
        q[#q + 1] = { x, y }
      end
    end
  end
  local head = 1
  while head <= #q do
    local c = q[head]
    head = head + 1
    for _, n in ipairs(neighbors(c[1], c[2])) do
      local t = get_cell(n[1], n[2])
      if is_blood(t) and not seen[idx(n[1], n[2])] then
        seen[idx(n[1], n[2])] = true
        q[#q + 1] = n
      end
    end
  end
  return seen
end

local function build_nerve_network()
  local seen = {}
  local q = {}
  for y = 0, CFG.gh - 1 do
    for x = 0, CFG.gw - 1 do
      if get_cell(x, y) == "brain" then
        seen[idx(x, y)] = true
        q[#q + 1] = { x, y }
      end
    end
  end
  local head = 1
  while head <= #q do
    local c = q[head]
    head = head + 1
    for _, n in ipairs(neighbors(c[1], c[2])) do
      local t = get_cell(n[1], n[2])
      if t == "nerve" and not seen[idx(n[1], n[2])] then
        seen[idx(n[1], n[2])] = true
        q[#q + 1] = n
      end
    end
  end
  return seen
end

local function cell_touches(net, x, y)
  for _, n in ipairs(neighbors(x, y)) do
    if net[idx(n[1], n[2])] then return true end
  end
  return false
end

local function run_tick()
  local counts = { vein = 0, heart = 0, lung = 0, liver = 0, muscle = 0, nerve = 0, gland = 0, brain = 0 }
  for y = 0, CFG.gh - 1 do
    for x = 0, CFG.gw - 1 do
      local t = get_cell(x, y)
      if counts[t] then counts[t] = counts[t] + 1 end
    end
  end
  local blood = build_blood_network()
  local nerves = build_nerve_network()
  local organs = counts.lung + counts.liver + counts.muscle + counts.gland
  local perfused = 0
  local innervated = 0
  for y = 0, CFG.gh - 1 do
    for x = 0, CFG.gw - 1 do
      local t = get_cell(x, y)
      if is_organ(t) and cell_touches(blood, x, y) then perfused = perfused + 1 end
      if is_organ(t) and cell_touches(nerves, x, y) then innervated = innervated + 1 end
    end
  end
  local supply = counts.heart * 8
  local eff = perfused == 0 and 1 or math.min(1, supply / perfused)
  local active_glands = counts.gland
  if WORLD.energy < active_glands * 0.3 then active_glands = 0 end
  local aura = {}
  if active_glands > 0 then
    for y = 0, CFG.gh - 1 do
      for x = 0, CFG.gw - 1 do
        if get_cell(x, y) == "gland" then
          for yy = y - 2, y + 2 do
            for xx = x - 2, x + 2 do
              if in_grid(xx, yy) then aura[idx(xx, yy)] = true end
            end
          end
        end
      end
    end
  end
  local o2, bm, en = 0, 0, 0
  for y = 0, CFG.gh - 1 do
    for x = 0, CFG.gw - 1 do
      local t = get_cell(x, y)
      if is_organ(t) and cell_touches(blood, x, y) then
        local mult = eff
        if cell_touches(nerves, x, y) then mult = mult * 1.3 end
        if aura[idx(x, y)] then mult = mult * 1.2 end
        if t == "lung" then o2 = o2 + 1.2 * mult
        elseif t == "liver" then bm = bm + 1.0 * mult
        elseif t == "muscle" then en = en + 1.0 * mult end
      end
    end
  end
  en = en - active_glands * 0.3
  WORLD.oxygen = clamp(WORLD.oxygen + o2 - WORLD.pop * CFG.pop_o2, 0, 999)
  WORLD.biomass = clamp(WORLD.biomass + bm - WORLD.pop * CFG.pop_bm - counts.heart * 0.05, 0, 999)
  WORLD.energy = clamp(WORLD.energy + en - WORLD.pop * CFG.pop_en, 0, 999)
  local stable = WORLD.oxygen > 0 and WORLD.biomass > 0 and WORLD.energy > 0
  if stable then
    WORLD.pop = WORLD.pop + CFG.grow
  else
    WORLD.pop = WORLD.pop - CFG.decay
  end
  WORLD.pop = clamp(WORLD.pop, 0, 999)
  if WORLD.pop >= CFG.win_pop and stable then
    GAME.hold = GAME.hold + 1
  else
    GAME.hold = 0
  end
  GAME.blooded = perfused
  GAME.organs = organs
  GAME.eff = eff
  GAME.innervated = innervated
  GAME.tick_count = GAME.tick_count + 1
  if WORLD.pop <= 0 then
    GAME.state = "lose"
    GAME.end_t = 0
  elseif GAME.hold >= CFG.win_hold then
    GAME.state = "win"
    GAME.end_t = 0
  end
end

local function place_cell()
  local x, y = GAME.cx, GAME.cy
  local kind = BUILD_ORDER[GAME.sel]
  local def = TYPES[kind]
  if get_cell(x, y) ~= "empty" then
    msg("CELL OCCUPIED")
    return
  end
  if WORLD.biomass < def.cost then
    msg("NOT ENOUGH BIOMASS")
    return
  end
  WORLD.biomass = WORLD.biomass - def.cost
  set_cell(x, y, kind)
  msg(def.name .. " GROWN")
end

local function cut_cell()
  local x, y = GAME.cx, GAME.cy
  local t = get_cell(x, y)
  if t == "empty" then
    msg("NOTHING HERE")
    return
  end
  if t == "brain" then
    msg("THE BRAIN CANNOT BE CUT")
    return
  end
  WORLD.biomass = WORLD.biomass + math.floor(TYPES[t].cost / 2)
  set_cell(x, y, "empty")
  msg("RECLAIMED")
end

local function cycle_build()
  GAME.sel = (GAME.sel % #BUILD_ORDER) + 1
  msg("SELECTED " .. TYPES[BUILD_ORDER[GAME.sel]].name)
end

local function draw_cell(x, y, t, px, py)
  local cx, cy = px + CFG.cell / 2, py + CFG.cell_h / 2
  if t == "vein" then
    for _, n in ipairs(neighbors(x, y)) do
      local nt = get_cell(n[1], n[2])
      if nt ~= "empty" then
        local nx, ny = CFG.gx + n[1] * CFG.cell + CFG.cell / 2, CFG.gy + n[2] * CFG.cell_h + CFG.cell_h / 2
        line(math.floor(cx), math.floor(cy), math.floor(nx), math.floor(ny), 8)
      end
    end
    circ(math.floor(cx), math.floor(cy), 2, 8)
    circb(math.floor(cx), math.floor(cy), 2, 2)
  elseif t == "heart" then
    local pulse = 1 + math.sin(GAME.t / 8) * 0.6
    circ(math.floor(cx), math.floor(cy), math.floor(5 + pulse), 8)
    circ(math.floor(cx), math.floor(cy), math.floor(3 + pulse), 2)
    circb(math.floor(cx), math.floor(cy), math.floor(5 + pulse), 0)
  elseif t == "lung" then
    circ(math.floor(cx - 4), math.floor(cy), 4, 12)
    circ(math.floor(cx + 4), math.floor(cy), 4, 12)
    circb(math.floor(cx - 4), math.floor(cy), 4, 0)
    circb(math.floor(cx + 4), math.floor(cy), 4, 0)
    line(math.floor(cx), math.floor(cy - 5), math.floor(cx), math.floor(cy + 5), 1)
  elseif t == "liver" then
    rect(math.floor(px + 3), math.floor(py + 3), 10, 8, 4)
    rectb(math.floor(px + 3), math.floor(py + 3), 10, 8, 1)
    line(math.floor(px + 5), math.floor(py + 5), math.floor(px + 10), math.floor(py + 8), 9)
  elseif t == "muscle" then
    rect(math.floor(px + 3), math.floor(py + 4), 10, 6, 9)
    rectb(math.floor(px + 3), math.floor(py + 4), 10, 6, 1)
    line(math.floor(px + 5), math.floor(py + 4), math.floor(px + 5), math.floor(py + 9), 8)
    line(math.floor(px + 8), math.floor(py + 4), math.floor(px + 8), math.floor(py + 9), 8)
  elseif t == "nerve" then
    line(math.floor(px + 3), math.floor(py + 7), math.floor(px + 13), math.floor(py + 7), 10)
    circ(math.floor(px + 3), math.floor(py + 7), 2, 10)
    circ(math.floor(px + 13), math.floor(py + 7), 2, 10)
  elseif t == "gland" then
    local pulse = math.sin(GAME.t / 10) * 1
    circ(math.floor(cx), math.floor(cy), math.floor(4 + pulse), 14)
    circb(math.floor(cx), math.floor(cy), math.floor(4 + pulse), 1)
  elseif t == "brain" then
    circ(math.floor(cx), math.floor(cy), 6, 13)
    circb(math.floor(cx), math.floor(cy), 6, 1)
    line(math.floor(cx - 3), math.floor(cy - 2), math.floor(cx + 3), math.floor(cy - 2), 7)
    line(math.floor(cx - 4), math.floor(cy + 2), math.floor(cx + 2), math.floor(cy + 2), 7)
  end
end

local function draw_grid()
  for y = 0, CFG.gh - 1 do
    for x = 0, CFG.gw - 1 do
      local px, py = CFG.gx + x * CFG.cell, CFG.gy + y * CFG.cell_h
      local t = get_cell(x, y)
      local bg = 1
      if (x + y) % 2 == 0 then bg = 0 end
      rect(px, py, CFG.cell - 1, CFG.cell_h - 1, bg)
      rectb(px, py, CFG.cell - 1, CFG.cell_h - 1, 5)
      if t ~= "empty" then draw_cell(x, y, t, px, py) end
    end
  end
  local px, py = CFG.gx + GAME.cx * CFG.cell, CFG.gy + GAME.cy * CFG.cell_h
  if math.floor(GAME.t / 8) % 2 == 0 then
    rectb(px, py, CFG.cell - 1, CFG.cell_h - 1, 10)
  else
    rectb(px, py, CFG.cell - 1, CFG.cell_h - 1, 7)
  end
end

local function draw_panel()
  rect(184, 2, 54, 132, 0)
  rectb(184, 2, 54, 132, 5)
  print("BLOODWRK", 187, 6, 8)
  print("POP " .. math.floor(WORLD.pop) .. "/" .. CFG.win_pop, 187, 16, 7)
  print("O2 " .. math.floor(WORLD.oxygen), 187, 25, 12)
  print("BM " .. math.floor(WORLD.biomass), 187, 34, 4)
  print("EN " .. math.floor(WORLD.energy), 187, 43, 9)
  print("BLOOD", 187, 53, 8)
  print(GAME.blooded .. "/" .. GAME.organs, 187, 61, 7)
  print("EFF " .. math.floor(GAME.eff * 100) .. "%", 187, 70, 10)
  print("HOLD " .. GAME.hold .. "/" .. CFG.win_hold, 187, 78, 10)
  print("TICK", 187, 87, 5)
  rect(187, 94, 44, 4, 1)
  local tick_w = math.floor(44 * (GAME.tick_t / CFG.tick))
  rect(187, 94, tick_w, 4, 11)
  local kind = BUILD_ORDER[GAME.sel]
  print("BUILD", 187, 102, 5)
  print(TYPES[kind].name, 187, 110, TYPES[kind].col)
  print("COST " .. TYPES[kind].cost, 187, 118, 4)
  print("A CYCLE", 187, 126, 5)
  print("Z/X", 187, 133, 5)
end

local function draw_hud()
  local kind = BUILD_ORDER[GAME.sel]
  print("BLOODWORKS", 4, 4, 8)
  print("POP " .. math.floor(WORLD.pop), 94, 4, 7)
  print("O2 " .. math.floor(WORLD.oxygen), 128, 4, 12)
  print("BM " .. math.floor(WORLD.biomass), 156, 4, 4)
  print("EN " .. math.floor(WORLD.energy), 188, 4, 9)
  print("BUILD " .. TYPES[kind].name, 4, 12, TYPES[kind].col)
  print("A CYCLE  Z GROW  X CUT", 92, 12, 5)
  if GAME.msg_t > 0 then
    rect(0, 128, 184, 8, 0)
    print(GAME.msg, 4, 129, 10)
  end
end

local function draw_title()
  cls(0)
  for i = 1, 70 do
    local x = (i * 37) % 240
    local y = (i * 23) % 120 + 8
    circ(x, y, 1, i % 3 == 0 and 8 or 2)
  end
  for i = 0, 11 do
    line(0, 24 + i * 8, 239, 40 + i * 7, 1)
  end
  center_text(CFG.title, 16, 8, 2)
  center_text(CFG.sub, 38, 14, 1)
  center_text("ARROWS MOVE CURSOR", 62, 7, 1)
  center_text("Z GROW   X CUT   A CYCLE", 72, 7, 1)
  center_text("PUMP BLOOD. FEED ORGANS. GROW THE CITY.", 88, 5, 1)
  center_text("REACH " .. CFG.win_pop .. " POPULATION AND HOLD", 98, 10, 1)
  center_text("PRESS Z TO BEGIN", 116, 10, 1)
  center_text(CFG.by, 128, 5, 1)
end

local function draw_world()
  cls(0)
  draw_grid()
  draw_panel()
  draw_hud()
end

function reset_game()
  math.randomseed(8117)
  GAME.state = CFG.start_title and "title" or "play"
  GAME.t = 0
  GAME.cx = 5
  GAME.cy = 4
  GAME.sel = 1
  GAME.msg = ""
  GAME.msg_t = 0
  GAME.tick_t = 0
  GAME.tick_count = 0
  GAME.hold = 0
  GAME.blooded = 0
  GAME.organs = 0
  GAME.eff = 1
  GAME.innervated = 0
  GAME.end_t = 0
  WORLD.grid = {}
  WORLD.pop = CFG.start_pop
  WORLD.oxygen = CFG.start_o2
  WORLD.biomass = CFG.start_bm
  WORLD.energy = CFG.start_en
  set_cell(3, 4, "heart")
  set_cell(4, 4, "vein")
  set_cell(4, 3, "vein")
  set_cell(4, 5, "vein")
  set_cell(5, 4, "brain")
  set_cell(3, 3, "lung")
  set_cell(3, 5, "liver")
  set_cell(5, 3, "muscle")
  set_cell(5, 5, "nerve")
  set_cell(6, 4, "gland")
end

local function update_title()
  if btnp(INPUT.place) or btnp(INPUT.cycle) then
    reset_game()
    GAME.state = "play"
  end
end

local function update_play()
  if btnp(INPUT.up) then GAME.cy = clamp(GAME.cy - 1, 0, CFG.gh - 1) end
  if btnp(INPUT.down) then GAME.cy = clamp(GAME.cy + 1, 0, CFG.gh - 1) end
  if btnp(INPUT.left) then GAME.cx = clamp(GAME.cx - 1, 0, CFG.gw - 1) end
  if btnp(INPUT.right) then GAME.cx = clamp(GAME.cx + 1, 0, CFG.gw - 1) end
  if btnp(INPUT.place) then place_cell() end
  if btnp(INPUT.cut) then cut_cell() end
  if btnp(INPUT.cycle) then cycle_build() end
  GAME.tick_t = GAME.tick_t + 1
  if GAME.tick_t >= CFG.tick then
    GAME.tick_t = 0
    run_tick()
  end
  if GAME.msg_t > 0 then GAME.msg_t = GAME.msg_t - 1 end
end

local function draw_end(win)
  cls(0)
  for i = 1, 70 do
    local x = (i * 41) % 240
    local y = (i * 27) % 136
    circ(x, y, 1, win and 11 or 8)
  end
  center_text(win and "THE CITY BREATHES" or "THE CITY DIED", 34, win and 10 or 8, 2)
  center_text("POP " .. math.floor(WORLD.pop) .. "   TICKS " .. GAME.tick_count, 58, 7, 1)
  center_text("O2 " .. math.floor(WORLD.oxygen) .. "  BM " .. math.floor(WORLD.biomass) .. "  EN " .. math.floor(WORLD.energy), 70, 12, 1)
  center_text("PRESS Z TO GROW AGAIN", 100, 10, 1)
end

function TIC()
  GAME.t = GAME.t + 1
  if GAME.state == "title" then
    update_title()
    draw_title()
  elseif GAME.state == "play" then
    update_play()
    draw_world()
  elseif GAME.state == "win" then
    GAME.end_t = GAME.end_t + 1
    if btnp(INPUT.place) then reset_game() end
    draw_end(true)
  elseif GAME.state == "lose" then
    GAME.end_t = GAME.end_t + 1
    if btnp(INPUT.place) then reset_game() end
    draw_end(false)
  end
end

reset_game()
