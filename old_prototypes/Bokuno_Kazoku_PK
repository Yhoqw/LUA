local function draw_object(o)
  local cx, cy = o.x + o.w / 2, o.y + o.h / 2
  if o.kind == "stove" then
    rect(o.x, o.y, o.w, o.h, 8)
    rectb(o.x, o.y, o.w, o.h, 0)
    circ(math.floor(cx), math.floor(cy), 4, 2)
    circ(math.floor(cx), math.floor(cy), 2, 9)
  elseif o.kind == "table" then
    rect(o.x, o.y, o.w, o.h, 4)
    rectb(o.x, o.y, o.w, o.h, 0)
    line(o.x + 4, o.y + 8, o.x + o.w - 4, o.y + 8, 9)
  elseif o.kind == "desk" then
    rect(o.x, o.y, o.w, o.h, 12)
    rectb(o.x, o.y, o.w, o.h, 0)
    rect(o.x + 4, o.y + 3, 10, 6, 0)
    rect(o.x + 5, o.y + 4, 8, 4, 11)
  elseif o.kind == "bed" then
    rect(o.x, o.y, o.w, o.h, 13)
    rectb(o.x, o.y, o.w, o.h, 0)
    rect(o.x + 3, o.y + 3, o.w - 6, o.h - 6, 7)
  elseif o.kind == "shop" then
    rect(o.x + 4, o.y + 6, 10, 22, 11)
    rectb(o.x + 4, o.y + 6, 10, 22, 0)
    rect(o.x + 6, o.y + 2, 6, 4, 4)
  end
  if o.kind ~= "shop" then
    print(o.name, o.x - 2, o.y - 7, 5)
  end
end

local function draw_person(f, is_player)
  local x, y = math.floor(f.x), math.floor(f.y)
  circ(x + 5, y + 3, 4, 9)
  circb(x + 5, y + 3, 4, 0)
  rect(x + 2, y + 7, 7, 8, f.col)
  rectb(x + 2, y + 7, 7, 8, 0)
  line(x + 4, y + 15, x + 4, y + 18, 1)
  line(x + 7, y + 15, x + 7, y + 18, 1)
  print(f.name, x - 8, y - 8, is_player and 10 or 7)
end

local function draw_family()
  for i = 2, #WORLD.family do draw_person(WORLD.family[i], false) end
  draw_person(WORLD.family[1], true)
end

local function draw_hud()
  print("DAY " .. math.min(GAME.day, CFG.days) .. "/" .. CFG.days, 4, 3, 7)
  rect(44, 5, 54, 4, 1)
  rect(44, 5, math.floor(54 * GAME.time / 100), 4, 10)
  local hour = 8 + math.floor(GAME.time * 16 / 100)
  print(string.format("%02d:00", hour), 102, 3, 5)
  print("RS " .. WORLD.money, 132, 3, 4)
  print("FOOD " .. WORLD.food, 184, 3, 9)
  print("ING " .. WORLD.ingredients, 214, 3, 11)
  print("MOOD " .. math.floor(avg_mood()) .. "/" .. CFG.win_mood, 4, 11, 12)
  local o = nearest_object()
  if GAME.msg_t > 0 then
    print(GAME.msg, 4, 121, 10)
  elseif o then
    print("Z " .. o.action .. " AT " .. o.name, 4, 121, 10)
  else
    print("ARROWS MOVE   Z INTERACT", 4, 121, 5)
  end
  if GAME.show_status then
    for i = 1, #WORLD.family do
      local f = WORLD.family[i]
      print(f.name .. " H" .. math.floor(f.hunger) .. " M" .. math.floor(f.mood), 4, 30 + (i - 1) * 7, 7)
    end
  end
end

