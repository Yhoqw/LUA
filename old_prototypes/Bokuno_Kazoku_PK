local function draw_world()
  cls(0)
  draw_house()
  for i = 1, #OBJECTS do draw_object(OBJECTS[i]) end
  draw_family()
  draw_hud()
end

function reset_game()
  math.randomseed(5821)
  GAME.state = CFG.start_title and "title" or "play"
  GAME.t = 0
  GAME.day = 1
  GAME.time = 0
  GAME.msg = ""
  GAME.msg_t = 0
  GAME.show_status = false
  GAME.reason = ""
  GAME.end_t = 0
  WORLD.money = CFG.start_money
  WORLD.food = CFG.start_food
  WORLD.ingredients = CFG.start_ing
  WORLD.family = {}
  for i = 1, #FAMILY do
    local f = FAMILY[i]
    WORLD.family[i] = {
      name = f.name, x = f.x, y = f.y, w = 10, h = 18,
      col = f.col, hunger = f.hunger, mood = f.mood,
      player = f.player, tx = f.x, ty = f.y, wt = math.random(30, 100),
    }
  end
end

local function update_title()
  if btnp(INPUT.act) or btnp(INPUT.status) then
    reset_game()
    GAME.state = "play"
  end
end

local function update_play()
  local p = WORLD.family[1]
  local dx, dy = 0, 0
  if btn(INPUT.left) then dx = -1.1 end
  if btn(INPUT.right) then dx = 1.1 end
  if btn(INPUT.up) then dy = -1.1 end
  if btn(INPUT.down) then dy = 1.1 end
  if dx ~= 0 and dy ~= 0 then dx, dy = dx * 0.7071, dy * 0.7071 end
  move_body(p, dx, dy)
  if btnp(INPUT.act) then do_action() end
  if btnp(INPUT.status) then GAME.show_status = not GAME.show_status end
  for i = 2, #WORLD.family do
    local f = WORLD.family[i]
    f.wt = f.wt - 1
    if f.wt <= 0 or dist(f.x, f.y, f.tx, f.ty) < 4 then
      f.wt = math.random(40, 110)
      f.tx = math.random(38, 212)
      f.ty = math.random(32, 108)
    end
    local ddx, ddy = f.tx - f.x, f.ty - f.y
    if math.abs(ddx) > 1 then f.x = f.x + (ddx > 0 and 0.22 or -0.22) end
    if math.abs(ddy) > 1 then f.y = f.y + (ddy > 0 and 0.22 or -0.22) end
    f.hunger = clamp(f.hunger + CFG.hunger_speed, 0, 100)
    if f.hunger > 60 then f.mood = clamp(f.mood - CFG.mood_decay, 0, 100) end
  end
  p.hunger = clamp(p.hunger + CFG.hunger_speed, 0, 100)
  if p.hunger > 60 then p.mood = clamp(p.mood - CFG.mood_decay, 0, 100) end
  GAME.time = GAME.time + CFG.day_speed
  if GAME.time >= 100 then
    GAME.time = GAME.time - 100
    day_end()
  end
  if avg_mood() <= 0 or WORLD.money < -500 then
    GAME.state = "lose"
    GAME.reason = "THE HOUSE FELL QUIET"
    GAME.end_t = 0
  end
  if GAME.msg_t > 0 then GAME.msg_t = GAME.msg_t - 1 end
end

local function draw_end(win)
  cls(0)
  for i = 1, 70 do
    local x = (i * 41) % 240
    local y = (i * 27) % 136
    rect(x, y, 1, 1, win and 11 or 8)
  end
  center_text(win and "THE HOUSE IS WARM" or "THE HOUSE IS QUIET", 30, win and 10 or 8, 2)
  center_text(GAME.reason, 52, 7, 1)
  center_text("MOOD " .. math.floor(avg_mood()) .. "   MONEY " .. WORLD.money, 68, 12, 1)
  center_text("PRESS Z TO BEGIN AGAIN", 98, 10, 1)
end

function TIC()
  GAME.t = GAME.t + 1
  if GAME.state == "title" then
    update_title()
    draw_title()
  elseif GAME.state == "play" then
    update_play()
    draw_world()
  elseif GAME.state == "win" then
    GAME.end_t = GAME.end_t + 1
    if btnp(INPUT.act) then reset_game() end
    draw_end(true)
  elseif GAME.state == "lose" then
    GAME.end_t = GAME.end_t + 1
    if btnp(INPUT.act) then reset_game() end
    draw_end(false)
  end
end

reset_game()
