  { kind = "desk", name = "DESK", x = 188, y = 40, w = 18, h = 16, action = "WORK", col = 12 },
  { kind = "bed", name = "BED", x = 184, y = 92, w = 28, h = 16, action = "REST", col = 13 },
  { kind = "shop", name = "KIRYANA", x = 4, y = 58, w = 18, h = 34, action = "BUY", col = 11 },
}

WALLS = {
  { x = 28, y = 22, w = 196, h = 4 },
  { x = 28, y = 114, w = 196, h = 4 },
  { x = 28, y = 22, w = 4, h = 42 },
  { x = 28, y = 80, w = 4, h = 38 },
  { x = 220, y = 22, w = 4, h = 96 },
}

GAME = {}
WORLD = {}

local function clamp(v, a, b)
  if v < a then return a end
  if v > b then return b end
  return v
end

local function aabb(ax, ay, aw, ah, bx, by, bw, bh)
  return ax < bx + bw and ax + aw > bx and ay < by + bh and ay + ah > by
end

local function dist(ax, ay, bx, by)
  local dx, dy = ax - bx, ay - by
  return math.sqrt(dx * dx + dy * dy)
end

local function text_w(s, scale)
  return #s * 6 * (scale or 1)
end

local function center_text(s, y, col, scale)
  print(s, math.floor((CFG.sw - text_w(s, scale)) / 2), y, col, scale)
end

local function log(s)
  GAME.msg = s
  GAME.msg_t = 120
end

local function avg_mood()
  local s = 0
  for i = 1, #WORLD.family do s = s + WORLD.family[i].mood end
  return s / #WORLD.family
end

local function solid(x, y, w, h)
  for i = 1, #WALLS do
    local o = WALLS[i]
    if aabb(x, y, w, h, o.x, o.y, o.w, o.h) then return true end
  end
  for i = 1, #OBJECTS do
    local o = OBJECTS[i]
    if aabb(x, y, w, h, o.x, o.y, o.w, o.h) then return true end
  end
  return false
end

local function move_body(b, dx, dy)
  b.x = b.x + dx
  if solid(b.x, b.y, b.w, b.h) then b.x = b.x - dx end
  b.y = b.y + dy
  if solid(b.x, b.y, b.w, b.h) then b.y = b.y - dy end
  b.x = clamp(b.x, 0, CFG.sw - b.w)
  b.y = clamp(b.y, 0, CFG.sh - b.h)
end

local function nearest_object()
  local p = WORLD.family[1]
  local best, bestd = nil, 24
  for i = 1, #OBJECTS do
    local o = OBJECTS[i]
    local d = dist(p.x + p.w / 2, p.y + p.h / 2, o.x + o.w / 2, o.y + o.h / 2)
    if d < bestd then best, bestd = o, d end
  end
  return best
end

local function advance_time(n)
  GAME.time = GAME.time + n
  while GAME.time >= 100 do
    GAME.time = GAME.time - 100
    day_end()
    if GAME.state ~= "play" then break end
  end
end

local function feed_family()
  if WORLD.food <= 0 then
    log("NO COOKED FOOD")
    return
  end
  WORLD.food = WORLD.food - 1
  for i = 1, #WORLD.family do
    local f = WORLD.family[i]
    f.hunger = clamp(f.hunger - 30, 0, 100)
    f.mood = clamp(f.mood + 10, 0, 100)
  end
  advance_time(3)
  log("THE FAMILY EATS TOGETHER")
end

local function cook_meal()
  if WORLD.ingredients < 2 then
    log("NEED 2 INGREDIENTS")
    return
  end
  WORLD.ingredients = WORLD.ingredients - 2
  WORLD.food = WORLD.food + 2
  WORLD.family[1].mood = clamp(WORLD.family[1].mood + 3, 0, 100)
  advance_time(6)
  log("ROTI AND DAAL READY")
end

local function buy_food()
  if WORLD.money < CFG.buy_cost then
    log("NOT ENOUGH MONEY")
    return
  end
  WORLD.money = WORLD.money - CFG.buy_cost
  WORLD.ingredients = WORLD.ingredients + CFG.buy_ing
  advance_time(4)
  log("GROCERIES FROM THE KIRYANA")
end

local function work()
  WORLD.money = WORLD.money + CFG.work_pay
  WORLD.family[1].mood = clamp(WORLD.family[1].mood - 5, 0, 100)
  advance_time(12)
  log("A LONG SHIFT AT THE DESK")
end

local function rest()
  WORLD.family[1].mood = clamp(WORLD.family[1].mood + 20, 0, 100)
  for i = 2, #WORLD.family do
    WORLD.family[i].mood = clamp(WORLD.family[i].mood + 5, 0, 100)
  end
  advance_time(10)
  log("A QUIET REST")
end

local function day_end()
  GAME.day = GAME.day + 1
  WORLD.money = WORLD.money - CFG.bill
  if WORLD.food >= #WORLD.family then
    WORLD.food = WORLD.food - #WORLD.family
    for i = 1, #WORLD.family do
      WORLD.family[i].hunger = clamp(WORLD.family[i].hunger - 55, 0, 100)
      WORLD.family[i].mood = clamp(WORLD.family[i].mood + 5, 0, 100)
    end
    log("DAY " .. (GAME.day - 1) .. " ENDS. THE TABLE IS SET.")
  else
    for i = 1, #WORLD.family do
      WORLD.family[i].hunger = clamp(WORLD.family[i].hunger + 25, 0, 100)
      WORLD.family[i].mood = clamp(WORLD.family[i].mood - 8, 0, 100)
    end
    log("DAY " .. (GAME.day - 1) .. " ENDS. NOT ENOUGH FOOD.")
  end
  if WORLD.money < 0 then
    for i = 1, #WORLD.family do
      WORLD.family[i].mood = clamp(WORLD.family[i].mood - 6, 0, 100)
    end
  end
  if math.random(1, 10) <= 3 then
    WORLD.family[1].mood = clamp(WORLD.family[1].mood + 4, 0, 100)
    log("A NEIGHBOR DROPS BY FOR CHAI")
  end
  if GAME.day > CFG.days then
    if avg_mood() >= CFG.win_mood and WORLD.money >= -500 then
      GAME.state = "win"
      GAME.reason = "THE HOUSE IS STILL WARM"
    else
      GAME.state = "lose"
      GAME.reason = "THE HOUSE FELL QUIET"
    end
    GAME.end_t = 0
  else
    GAME.time = 0
  end
end

local function do_action()
  local o = nearest_object()
  if not o then
    log("NOTHING WITHIN REACH")
    return
  end
  if o.kind == "stove" then cook_meal()
  elseif o.kind == "table" then feed_family()
  elseif o.kind == "desk" then work()
  elseif o.kind == "bed" then rest()
  elseif o.kind == "shop" then buy_food() end
end

