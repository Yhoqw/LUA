  rect(32, 26, 188, 88, 15)
  for i = 1, #WALLS do
    local w = WALLS[i]
    rect(w.x, w.y, w.w, w.h, 4)
  end
  rect(28, 64, 4, 16, 0)
  rect(0, 118, 240, 18, 0)
