CFG = {
  title = "FOREIGN POLICY", sub = "A DEFCON-STYLE CRISIS GAME", by = "YAZDAN ALI KHAN",
  sw = 240, sh = 136, ap = 2, turn_limit = 20, win_turn = 12,
  win_influence = 70, peace_relation = 90, start_title = true,
}

INPUT = { up = 0, down = 1, left = 2, right = 3, execute = 4, end_turn = 5 }

ACTIONS = {
  { name = "DIPLOMACY", cost = 1, desc = "REL +8  TENSION -2" },
  { name = "ARMS", cost = 1, desc = "ARMY +2  STAB -2" },
  { name = "SABOTAGE", cost = 1, desc = "ARMY -3  REL -15" },
  { name = "NUKE", cost = 1, desc = "MAD  TENSION 100" },
}

NATIONS = {
  { name = "AZURE", x = 70, y = 72, col = 12, player = true, armies = 10, nukes = 2, rel = 100, stability = 100 },
  { name = "CRIMSON", x = 154, y = 38, col = 8, armies = 8, nukes = 2, rel = 44, stability = 80 },
  { name = "VERDANT", x = 182, y = 92, col = 11, armies = 6, nukes = 0, rel = 56, stability = 75 },
  { name = "AMBER", x = 104, y = 108, col = 10, armies = 5, nukes = 0, rel = 60, stability = 70 },
  { name = "VIOLET", x = 38, y = 30, col = 13, armies = 7, nukes = 1, rel = 50, stability = 85 },
}

EDGES = {
  { 1, 2 }, { 1, 3 }, { 1, 4 }, { 1, 5 }, { 2, 3 }, { 3, 4 }, { 4, 5 }, { 2, 5 },
}

GAME = {}
WORLD = {}

local function clamp(v, a, b)
  if v < a then return a end
  if v > b then return b end
  return v
end

local function text_w(s, scale)
  return #s * 6 * (scale or 1)
end

local function center_text(s, y, col, scale)
  print(s, math.floor((CFG.sw - text_w(s, scale)) / 2), y, col, scale)
end

local function log(s)
  GAME.log[#GAME.log + 1] = s
  while #GAME.log > 4 do table.remove(GAME.log, 1) end
  GAME.msg = s
  GAME.msg_t = 100
end

local function player()
  return WORLD.nations[1]
end

local function target()
  return WORLD.nations[GAME.target]
end

local function alliances()
  local n = 0
  for i = 2, #WORLD.nations do
    if WORLD.nations[i].rel >= 85 then n = n + 1 end
  end
  return n
end

local function compute_influence()
  local sum = 0
  for i = 2, #WORLD.nations do sum = sum + WORLD.nations[i].rel end
  local avg = sum / (#WORLD.nations - 1)
  return math.floor(avg + alliances() * 8 + player().armies * 0.5)
end

local function defcon()
  return clamp(5 - math.floor(GAME.tension / 20), 1, 5)
end

local function check_end()
  GAME.influence = compute_influence()
  if GAME.tension >= 100 then
    GAME.state = "lose"
    GAME.reason = "NUCLEAR WAR"
    GAME.end_t = 0
    return true
  end
  if player().stability <= 0 then
    GAME.state = "lose"
    GAME.reason = "YOUR GOVERNMENT COLLAPSED"
    GAME.end_t = 0
    return true
  end
  if GAME.influence >= CFG.win_influence and GAME.turn >= CFG.win_turn then
    GAME.state = "win"
    GAME.reason = "YOU SHAPED THE WORLD"
    GAME.end_t = 0
    return true
  end
  if alliances() == #WORLD.nations - 1 then
    GAME.state = "win"
    GAME.reason = "A WORLD OF ALLIES"
    GAME.end_t = 0
    return true
  end
  if GAME.turn > CFG.turn_limit then
    GAME.state = "lose"
    GAME.reason = "THE WORLD MOVED ON"
    GAME.end_t = 0
    return true
  end
  return false
end

local function execute_action()
  if GAME.ap <= 0 then
    log("NO ACTIONS LEFT")
    return
  end
  local t = target()
  local p = player()
  local a = GAME.action
  if a == 1 then
    t.rel = clamp(t.rel + 8, 0, 100)
    GAME.tension = clamp(GAME.tension - 2, 0, 100)
    log("DIPLOMACY WITH " .. t.name)
  elseif a == 2 then
    p.armies = p.armies + 2
    p.stability = clamp(p.stability - 2, 0, 100)
    GAME.tension = clamp(GAME.tension + 2, 0, 100)
    log("ARMS BUILDUP")
  elseif a == 3 then
    t.armies = math.max(0, t.armies - 3)
    t.rel = clamp(t.rel - 15, 0, 100)
    GAME.tension = clamp(GAME.tension + 8, 0, 100)
    log("SABOTAGE IN " .. t.name)
  elseif a == 4 then
    if p.nukes <= 0 then
      log("NO NUKES REMAIN")
      return
    end
    p.nukes = p.nukes - 1
    t.armies = 0
    t.rel = 0
    p.stability = clamp(p.stability - 20, 0, 100)
    GAME.tension = 100
    log("NUCLEAR LAUNCH")
  end
  GAME.ap = GAME.ap - 1
  GAME.influence = compute_influence()
  check_end()
end

local function end_turn()
  GAME.turn = GAME.turn + 1
  GAME.ap = CFG.ap
  player().stability = clamp(player().stability + 3, 0, 100)
  local low = 0
  for i = 2, #WORLD.nations do
    local n = WORLD.nations[i]
    n.rel = clamp(n.rel - math.random(0, 2), 0, 100)
    if n.rel < 40 then
      low = low + 1
      n.armies = n.armies + 1
    end
  end
  GAME.tension = clamp(GAME.tension + 1 + low, 0, 100)
  if math.random(1, 10) <= 5 then
    local n = WORLD.nations[math.random(2, #WORLD.nations)]
    n.rel = clamp(n.rel - 8, 0, 100)
    GAME.tension = clamp(GAME.tension + 6, 0, 100)
    log("CRISIS IN " .. n.name)
  end
  for i = 2, #WORLD.nations do
    local n = WORLD.nations[i]
    if n.rel < 25 and GAME.tension > 65 and math.random(1, 10) <= 4 then
      player().armies = math.max(0, player().armies - 2)
      player().stability = clamp(player().stability - 8, 0, 100)
      GAME.tension = clamp(GAME.tension + 4, 0, 100)
      log(n.name .. " STRIKES YOUR FORCES")
    end
  end
  if player().armies <= 0 then
    player().stability = clamp(player().stability - 5, 0, 100)
    player().armies = 0
  end
  GAME.influence = compute_influence()
  if not check_end() then
    log("TURN " .. GAME.turn .. " BEGINS")
  end
end

local function draw_map()
  rect(0, 18, 240, 82, 1)
  for i = 1, 18 do
    line(0, 20 + i * 4, 239, 14 + i * 3, 8)
  end
  for i = 1, #EDGES do
    local a, b = NATIONS[EDGES[i][1]], NATIONS[EDGES[i][2]]
    line(a.x, a.y, b.x, b.y, 5)
  end
  for i = 1, #WORLD.nations do
    local n = WORLD.nations[i]
    local base = NATIONS[i]
    local r = 7 + math.floor(n.armies / 5)
    circ(base.x, base.y, r, n.col)
    circb(base.x, base.y, r, 0)
    if i == GAME.target then
      local pulse = math.floor(GAME.t / 10) % 2
      circb(base.x, base.y, r + 3 + pulse, 10)
    end
    print(base.name, base.x - math.floor(#base.name * 3), base.y - r - 8, 7)
    print("R" .. n.rel, base.x - 10, base.y + r + 2, n.rel < 30 and 8 or 7)
    print("A" .. n.armies .. " N" .. n.nukes, base.x - 12, base.y + r + 8, 5)
  end
  for i = 1, #GAME.log do
    print(GAME.log[i], 4, 88 + (i - 1) * 4, 5)
  end
end

local function draw_hud()
  rect(0, 0, 240, 18, 0)
  line(0, 18, 239, 18, 5)
  print("TURN " .. GAME.turn .. "/" .. CFG.turn_limit, 4, 4, 7)
  print("AP " .. GAME.ap, 76, 4, 10)
  print("TENSION " .. math.floor(GAME.tension), 106, 4, GAME.tension > 70 and 8 or 9)
  print("DEFCON " .. defcon(), 178, 4, defcon() <= 2 and 8 or 11)
  rect(4, 12, 90, 4, 1)
  rect(4, 12, math.floor(90 * GAME.tension / 100), 4, GAME.tension > 70 and 8 or 9)
  print("INF " .. GAME.influence .. "/" .. CFG.win_influence, 106, 12, 12)
  print("STAB " .. player().stability, 184, 12, 7)
  rect(0, 100, 240, 36, 0)
  line(0, 100, 239, 100, 5)
  local t = target()
  print("TARGET " .. t.name .. "  REL " .. t.rel .. "  ARMY " .. t.armies .. "  NUKE " .. t.nukes, 4, 104, 7)
  for i = 1, #ACTIONS do
    local a = ACTIONS[i]
    local col = i == GAME.action and 10 or 5
    print((i == GAME.action and "> " or "  ") .. a.name, 4, 112 + (i - 1) * 6, col)
    print(a.desc, 82, 112 + (i - 1) * 6, col)
  end
end

local function draw_title()
  cls(0)
  for i = 1, 80 do
    local x = (i * 37) % 240
    local y = (i * 23) % 120 + 8
    rect(x, y, 1, 1, i % 4 == 0 and 8 or 5)
  end
  for i = 0, 5 do
    line(0, 30 + i * 12, 239, 20 + i * 10, 1)
  end
  center_text(CFG.title, 14, 8, 2)
  center_text(CFG.sub, 36, 7, 1)
  center_text("L/R TARGET   U/D ACTION", 58, 7, 1)
  center_text("Z EXECUTE   X END TURN", 68, 7, 1)
  center_text("KEEP TENSION LOW. BUILD INFLUENCE. SURVIVE 20 TURNS.", 84, 5, 1)
  center_text("PRESS Z TO BEGIN", 108, 10, 1)
  center_text(CFG.by, 126, 5, 1)
end

local function draw_world()
  cls(0)
  draw_map()
  draw_hud()
end

function reset_game()
  math.randomseed(3751)
  GAME.state = CFG.start_title and "title" or "play"
  GAME.t = 0
  GAME.turn = 1
  GAME.ap = CFG.ap
  GAME.target = 2
  GAME.action = 1
  GAME.tension = 28
  GAME.influence = 0
  GAME.log = {}
  GAME.msg = ""
  GAME.msg_t = 0
  GAME.reason = ""
  GAME.end_t = 0
  WORLD.nations = {}
  for i = 1, #NATIONS do
    local n = NATIONS[i]
    WORLD.nations[i] = {
      name = n.name, armies = n.armies, nukes = n.nukes, rel = n.rel,
      stability = n.stability, col = n.col,
    }
  end
  GAME.influence = compute_influence()
  log("THE WORLD IS WATCHING")
end

local function update_title()
  if btnp(INPUT.execute) or btnp(INPUT.end_turn) then
    reset_game()
    GAME.state = "play"
  end
end

local function update_play()
  if btnp(INPUT.left) then GAME.target = GAME.target - 1 end
  if btnp(INPUT.right) then GAME.target = GAME.target + 1 end
  if GAME.target < 2 then GAME.target = #WORLD.nations end
  if GAME.target > #WORLD.nations then GAME.target = 2 end
  if btnp(INPUT.up) then GAME.action = GAME.action - 1 end
  if btnp(INPUT.down) then GAME.action = GAME.action + 1 end
  GAME.action = ((GAME.action - 1) % #ACTIONS) + 1
  if btnp(INPUT.execute) then execute_action() end
  if btnp(INPUT.end_turn) then end_turn() end
  if GAME.msg_t > 0 then GAME.msg_t = GAME.msg_t - 1 end
  GAME.influence = compute_influence()
end

local function draw_end(win)
  cls(0)
  for i = 1, 80 do
    local x = (i * 41) % 240
    local y = (i * 27) % 136
    rect(x, y, 1, 1, win and 11 or 8)
  end
  center_text(win and "THE WORLD IS YOURS" or "THE WORLD BURNS", 30, win and 10 or 8, 2)
  center_text(GAME.reason, 52, 7, 1)
  center_text("TURN " .. GAME.turn .. "   INFLUENCE " .. GAME.influence, 66, 12, 1)
  center_text("PRESS Z TO TRY AGAIN", 96, 10, 1)
end

function TIC()
  GAME.t = GAME.t + 1
  if GAME.state == "title" then
    update_title()
    draw_title()
  elseif GAME.state == "play" then
    update_play()
    draw_world()
  elseif GAME.state == "win" then
    GAME.end_t = GAME.end_t + 1
    if btnp(INPUT.execute) then reset_game() end
    draw_end(true)
  elseif GAME.state == "lose" then
    GAME.end_t = GAME.end_t + 1
    if btnp(INPUT.execute) then reset_game() end
    draw_end(false)
  end
end

reset_game()
