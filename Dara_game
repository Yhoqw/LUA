function nearest_car(p)
  local best, bd = nil, 22
  for _, c in ipairs(WORLD.cars) do
    if not c.dead and not c.police then
      local d = dist(p.x, p.y, c.x, c.y)
      if d < bd then
        bd = d
        best = c
      end
    end
  end
  return best, bd
end

function enter_car(c)
  local p = GAME.player
  if not c or c.dead or c.police then return false end
  if c.traffic then
    c.traffic = false
    local ped = new_ped(c.x + 12, c.y + 12, SPR.ped2)
    ped.panic = 180
    crime(1)
    show_msg("CARJACKED")
  end
  p.car = c
  p.x, p.y = c.x, c.y
  GAME.use_cd = 22
  snd(SFX.hit)
  return true
end

function exit_car()
  local p = GAME.player
  local c = p.car
  if not c then return end
  local spots = { { 0, 15 }, { 0, -15 }, { 15, 0 }, { -15, 0 } }
  for _, s in ipairs(spots) do
    local x, y = c.x + s[1], c.y + s[2]
    if not solid_at(x, y, 4) then
      p.x, p.y = x, y
      break
    end
  end
  p.car = nil
  p.facing = c.angle
  GAME.use_cd = 20
end

function try_fire()
  if GAME.fire_cd > 0 then return end
  local p = GAME.player
  local ang, x, y
  if p.car then
    ang = p.car.angle
    x = p.car.x + math.cos(ang) * 10
    y = p.car.y + math.sin(ang) * 10
  else
    ang = p.facing
    x = p.x + math.cos(ang) * 7
    y = p.y + math.sin(ang) * 7
  end
  new_bullet("p", x, y, ang, 4.4, 1, 4)
  GAME.fire_cd = 9
  spawn_particle(x, y, 0.4, 0.4, 5, 4, 1)
  snd(SFX.gun)
  local witnessed = false
  for _, e in ipairs(WORLD.peds) do
    if dist(x, y, e.x, e.y) < 80 then witnessed = true end
    if dist(x, y, e.x, e.y) < 150 then e.panic = 140 end
  end
  for _, e in ipairs(WORLD.cops) do
    if dist(x, y, e.x, e.y) < 170 then witnessed = true end
  end
  if witnessed then alert(1) end
end

function damage_player(n)
  local p = GAME.player
  if p.inv > 0 or p.dead then return end
  p.health = clamp(p.health - n, 0, CFG.health)
  p.inv = 16
  GAME.shake = 4
  snd(SFX.hurt)
  if p.health <= 0 then
    p.dead = true
    GAME.state = "wasted"
    GAME.wasted_t = 120
    explosion(p.x, p.y)
    GAME.heat = 0
    GAME.heat_t = 0
  end
end

function kill_ped(ped, by_car)
  if ped.dead then return end
  ped.dead = true
  burst(ped.x, ped.y, 5, 2, 1.2)
  snd(SFX.hit)
  if ped.target and GAME.job and GAME.job.ped == ped then
    complete_job()
  else
    if by_car then crime(2) else crime(1) end
    if math.random() < 0.35 then
      new_pickup(ped.x + 3, ped.y, "cash", math.random(30, 90))
    end
  end
end

function damage_car(c, n)
  if c.dead then return end
  c.health = c.health - n
  if c.health <= 0 then
    c.dead = true
    explosion(c.x, c.y)
    local p = GAME.player
    if p.car == c then
      p.car = nil
      p.x, p.y = c.x, c.y
      damage_player(25)
    end
    if c.police then crime(1) end
    if GAME.job and GAME.job.car == c then
      GAME.job.car = nil
      GAME.job.phase = 1
    end
  end
end

function update_msg()
  if GAME.msg_t > 0 then
    GAME.msg_t = GAME.msg_t - 1
    if GAME.msg_t == 0 then GAME.msg = nil end
  end
end

function update_effects()
  for i = #WORLD.fx, 1, -1 do
    local e = WORLD.fx[i]
    e.x = e.x + e.vx
    e.y = e.y + e.vy
    e.vx = e.vx * 0.92
    e.vy = e.vy * 0.92
    e.life = e.life - 1
    if e.life <= 0 then table.remove(WORLD.fx, i) end
  end
end

function update_camera()
  local p = GAME.player
  local tx = p.x - CFG.sw / 2
  local ty = p.y - CFG.sh / 2
  GAME.camx = GAME.camx + (tx - GAME.camx) * 0.16
  GAME.camy = GAME.camy + (ty - GAME.camy) * 0.16
  GAME.camx = clamp(GAME.camx, 0, CFG.ww - CFG.sw - 8)
  GAME.camy = clamp(GAME.camy, 0, CFG.wh - CFG.sh - 8)
end

function update_player_foot()
  local p = GAME.player
  local dx, dy = 0, 0
  if btn(INPUT.left) then dx = dx - 1 end
  if btn(INPUT.right) then dx = dx + 1 end
  if btn(INPUT.up) then dy = dy - 1 end
  if btn(INPUT.down) then dy = dy + 1 end
  local sp = CFG.walk
  if btn(INPUT.sprint) then sp = CFG.sprint end
  if dx ~= 0 or dy ~= 0 then
    local m = math.sqrt(dx * dx + dy * dy)
    move_actor(p, dx / m * sp, dy / m * sp, 3.5)
    p.facing = atan2(dy, dx)
    p.moving = true
    p.walk = p.walk + sp
  else
    p.moving = false
  end
  if btn(INPUT.fire) then try_fire() end
  if GAME.use_cd > 0 then GAME.use_cd = GAME.use_cd - 1 end
  if btnp(INPUT.use) and GAME.use_cd == 0 then
    local zone = garage_zone(p)
    if zone and p.health < CFG.health and GAME.money >= 100 then
      add_money(-100)
      p.health = CFG.health
      show_msg("PATCHED UP -$100")
      snd(SFX.cash)
      GAME.use_cd = 20
    else
      local c = nearest_car(p)
      if c then enter_car(c) end
    end
  end
end

function update_player_car()
  local p = GAME.player
  local c = p.car
  if not c or c.dead then p.car = nil return end
  local thr, st = 0, 0
  if btn(INPUT.up) then thr = 1 end
  if btn(INPUT.down) then thr = -1 end
  if btn(INPUT.left) then st = -1 end
  if btn(INPUT.right) then st = 1 end
  local sp = c.speed
  if thr > 0 then
    sp = sp + CFG.accel
  elseif thr < 0 then
    sp = sp - CFG.accel
  else
    sp = sp * CFG.drag
  end
  sp = clamp(sp, -CFG.vrev, CFG.vmax)
  local rate = CFG.turn * clamp(math.abs(sp), 0, 1.4)
  if st ~= 0 and math.abs(sp) > 0.08 then
    c.angle = c.angle + st * rate * sign(sp)
  end
  c.speed = sp
  local nx = c.x + math.cos(c.angle) * sp
  local ny = c.y + math.sin(c.angle) * sp
  local okx = not solid_at(nx, c.y, 7)
  local oky = not solid_at(c.x, ny, 7)
  if not solid_at(nx, ny, 7) then
    c.x, c.y = nx, ny
  else
    if okx then c.x = nx end
    if oky then c.y = ny end
    if math.abs(sp) > 1.2 then
      damage_player(6)
      c.health = c.health - 1
      GAME.shake = 5
      snd(SFX.hit)
      burst(c.x + math.cos(c.angle) * 8, c.y + math.sin(c.angle) * 8, 4, 4, 1)
      if c.health <= 0 then damage_car(c, 99) end
    end
    c.speed = sp * -0.22
  end
  p.x, p.y = c.x, c.y
  p.facing = c.angle
  if btn(INPUT.fire) then try_fire() end
  if GAME.use_cd > 0 then GAME.use_cd = GAME.use_cd - 1 end
  if btnp(INPUT.use) and GAME.use_cd == 0 then
    if garage_zone(p) then
      if GAME.money >= 200 then
        add_money(-200)
        GAME.heat = 0
        GAME.heat_t = 0
        c.health = c.maxhp
        show_msg("RESPRAY -$200 COPS LOST")
        snd(SFX.cash)
      else
        show_msg("NEED $200")
      end
      GAME.use_cd = 20
    else
      exit_car()
    end
  end
end

function garage_zone(p)
  local g = { x = 190, y = 182, w = 36, h = 28 }
  if p.x > g.x and p.x < g.x + g.w and p.y > g.y and p.y < g.y + g.h then
    return g
  end
  return nil
end

function update_player()
  local p = GAME.player
  if p.inv > 0 then p.inv = p.inv - 1 end
  if GAME.fire_cd > 0 then GAME.fire_cd = GAME.fire_cd - 1 end
  if p.car then update_player_car() else update_player_foot() end
end

function update_peds()
  local p = GAME.player
  for i = #WORLD.peds, 1, -1 do
    local e = WORLD.peds[i]
    if e.dead then
      table.remove(WORLD.peds, i)
    else
      e.timer = e.timer - 1
      if e.timer <= 0 then
        e.timer = math.random(60, 180)
        e.dir = math.random(0, 3)
      end
      local ax = 0
      local ay = 0
      if e.dir == 0 then ay = -1 elseif e.dir == 1 then ay = 1 elseif e.dir == 2 then ax = -1 else ax = 1 end
      local sp = 0.32
      if e.panic > 0 then
        e.panic = e.panic - 1
        local ang = atan2(e.y - p.y, e.x - p.x)
        ax, ay = math.cos(ang), math.sin(ang)
        sp = 0.95
      end
      local nx = e.x + ax * sp
      local ny = e.y + ay * sp
      if solid_at(nx, ny, 3) or (math.abs(ax) > 0 and solid_at(e.x + ax * 6, e.y, 3)) then
        e.dir = math.random(0, 3)
        if e.panic == 0 then e.timer = math.random(40, 100) end
      else
        e.x, e.y = nx, ny
      end
      e.angle = atan2(ay, ax)
      if p.car and not p.car.dead then
        local c = p.car
        if math.abs(c.speed) > 0.9 and dist(c.x, c.y, e.x, e.y) < 9 then
          kill_ped(e, true)
        end
      end
    end
  end
end

function update_traffic()
  local p = GAME.player
  local traffic = 0
  for _, c in ipairs(WORLD.cars) do
    if c.traffic and not c.dead then
      traffic = traffic + 1
      if dist(c.x, c.y, p.x, p.y) > 560 then
        local i = clamp(math.floor(p.x / CFG.cw) + math.random(-2, 2), 0, 5)
        local j = clamp(math.floor(p.y / CFG.ch) + math.random(-2, 2), 0, 4)
        c.ni, c.nj = i, j
        c.ti, c.tj = i, j
        c.prog = 0
        c.dir = math.random(0, 3)
        local dx, dy = 0, 0
        if c.dir == 0 then dx = 1 elseif c.dir == 1 then dy = 1 elseif c.dir == 2 then dx = -1 else dy = -1 end
        c.ti = clamp(i + dx, 0, 5)
        c.tj = clamp(j + dy, 0, 4)
        c.x = node_x(i) - dy * 6
        c.y = node_y(j) + dx * 6
      end
      local ax = node_x(c.ni)
      local ay = node_y(c.nj)
      local bx = node_x(c.ti)
      local by = node_y(c.tj)
      local dx, dy = sign(bx - ax), sign(by - ay)
      local seg = CFG.cw
      if dy ~= 0 then seg = CFG.ch end
      local step = c.speed / seg
      local ahead = false
      local fx = c.x + dx * 16
      local fy = c.y + dy * 16
      if dist(fx, fy, p.x, p.y) < 10 then ahead = true end
      for _, o in ipairs(WORLD.cars) do
        if o ~= c and not o.dead and dist(fx, fy, o.x, o.y) < 10 then ahead = true break end
      end
      for _, o in ipairs(WORLD.peds) do
        if dist(fx, fy, o.x, o.y) < 8 then ahead = true break end
      end
      if not ahead then
        c.prog = c.prog + step
        local t = clamp(c.prog, 0, 1)
        local px = ax + (bx - ax) * t
        local py = ay + (by - ay) * t
        c.lat = c.lat + (6 - c.lat) * 0.12
        c.x = px - dy * c.lat
        c.y = py + dx * c.lat
        c.angle = atan2(dy, dx)
        if c.prog >= 1 then
          c.prog = c.prog - 1
          c.ni, c.nj = c.ti, c.tj
          local opts = {}
          if c.ni + dx >= 0 and c.ni + dx <= 5 and c.nj + dy >= 0 and c.nj + dy <= 4 then
            table.insert(opts, { dx, dy })
          end
          if c.ni - dy >= 0 and c.ni - dy <= 5 and c.nj + dx >= 0 and c.nj + dx <= 4 then
            table.insert(opts, { -dy, dx })
          end
          if c.ni + dy >= 0 and c.ni + dy <= 5 and c.nj - dx >= 0 and c.nj - dx <= 4 then
            table.insert(opts, { dy, -dx })
          end
          local pick = opts[math.random(1, #opts)]
          c.ti = c.ni + pick[1]
          c.tj = c.nj + pick[2]
          c.lat = 0
        end
      end
      for _, o in ipairs(WORLD.cars) do
        if o ~= c and not o.dead and o ~= p.car and dist(c.x, c.y, o.x, o.y) < 9 then
          c.x = c.x + (c.x - o.x) * 0.12
          c.y = c.y + (c.y - o.y) * 0.12
        end
      end
      if p.car == nil and not p.dead then
        if dist(c.x, c.y, p.x, p.y) < 7 then
          damage_player(6)
          local a = atan2(p.y - c.y, p.x - c.x)
          p.x = p.x + math.cos(a) * 6
          p.y = p.y + math.sin(a) * 6
        end
      end
      if p.car then
        local d = dist(c.x, c.y, p.x, p.y)
        if d < 11 then
          c.health = c.health - 1
          p.car.speed = p.car.speed * 0.7
          burst(c.x, c.y, 3, 4, 0.8)
          if c.health <= 0 then damage_car(c, 99) end
        end
      end
    end
  end
  if traffic < 10 and GAME.t % 100 == 0 then spawn_traffic(true) end
end

function offscreen(x, y)
  return x < GAME.camx - 12 or x > GAME.camx + CFG.sw + 12 or y < GAME.camy - 12 or y > GAME.camy + CFG.sh + 12
end

function spawn_cop()
  local p = GAME.player
  for i = 1, 16 do
    local a = math.random() * math.pi * 2
    local r = 150 + math.random() * 120
    local x = p.x + math.cos(a) * r
    local y = p.y + math.sin(a) * r
    if not solid_at(x, y, 4) and offscreen(x, y) then
      return new_cop(x, y)
    end
  end
  return nil
end

function update_cops()
  local p = GAME.player
  for i = #WORLD.cops, 1, -1 do
    local c = WORLD.cops[i]
    local d = dist(c.x, c.y, p.x, p.y)
    if c.dead or d > 760 or (GAME.heat == 0 and d > 220) then
      table.remove(WORLD.cops, i)
    else
      local a = atan2(p.y - c.y, p.x - c.x)
      c.angle = a
      if d > 16 then
        local nx = c.x + math.cos(a) * 0.92
        local ny = c.y + math.sin(a) * 0.92
        if not solid_at(nx, c.y, 4) then c.x = nx end
        if not solid_at(c.x, ny, 4) then c.y = ny end
      end
      c.cd = c.cd - 1
      if c.cd <= 0 and d < 130 then
        c.cd = 45 + math.random(0, 40)
        local err = (math.random() - 0.5) * 0.16
        new_bullet("c", c.x + math.cos(a) * 7, c.y + math.sin(a) * 7, a + err, 3.4, 9, 10)
        snd(SFX.gun)
      end
      if d < 9 then damage_player(8) end
    end
  end
end

function spawn_police_car()
  local p = GAME.player
  local n = WORLD.nodes[math.random(1, #WORLD.nodes)]
  local d = dist(n.x, n.y, p.x, p.y)
  if d > 160 and d < 520 and offscreen(n.x, n.y) then
    local c = new_car(n.x, n.y, 0, 4)
    c.police = true
    c.health = 6
    c.maxhp = 6
    c.parked = false
    c.speed = 1.4
    return c
  end
  return nil
end

function update_police_cars()
  local p = GAME.player
  for i = #WORLD.cars, 1, -1 do
    local c = WORLD.cars[i]
    if c.police then
      if c.dead or GAME.heat == 0 then
        if not c.dead then c.dead = true end
      else
        local d = dist(c.x, c.y, p.x, p.y)
        local want = atan2(p.y - c.y, p.x - c.x)
        local diff = (want - c.angle + math.pi) % (math.pi * 2) - math.pi
        c.angle = c.angle + clamp(diff, -0.05, 0.05)
        c.speed = c.speed + (1.9 - c.speed) * 0.03
        local nx = c.x + math.cos(c.angle) * c.speed
        local ny = c.y + math.sin(c.angle) * c.speed
        local moved = false
        if not solid_at(nx, c.y, 7) then c.x = nx moved = true end
        if not solid_at(c.x, ny, 7) then c.y = ny moved = true end
        if not moved then
          c.angle = c.angle + 0.4
          c.speed = c.speed * 0.6
        end
        if d < 150 and GAME.t % 90 == 0 then
          local a = atan2(p.y - c.y, p.x - c.x) + (math.random() - 0.5) * 0.12
          new_bullet("c", c.x + math.cos(a) * 8, c.y + math.sin(a) * 8, a, 3.6, 8, 10)
          snd(SFX.gun)
        end
        if d < 14 then damage_player(10) end
      end
    end
  end
end

function update_heat()
  if GAME.heat > 0 then
    GAME.heat_t = GAME.heat_t + 1
    if GAME.heat_t > CFG.heat_cool then
      GAME.heat_t = 0
      GAME.heat = GAME.heat - 1
      if GAME.heat == 0 then show_msg("HEAT CLEARED") end
    end
  end
  local want_cops = GAME.heat
  if #WORLD.cops > want_cops then
    table.remove(WORLD.cops)
  end
  GAME.cop_t = GAME.cop_t - 1
  if #WORLD.cops < want_cops and GAME.cop_t <= 0 then
    GAME.cop_t = 70
    spawn_cop()
  end
  local want_cars = math.floor(GAME.heat / 2)
  local have = 0
  for _, c in ipairs(WORLD.cars) do
    if c.police and not c.dead then have = have + 1 end
  end
  if have < want_cars and GAME.t % 120 == 0 then spawn_police_car() end
end

function update_bullets()
  local p = GAME.player
  for i = #WORLD.bullets, 1, -1 do
    local b = WORLD.bullets[i]
    b.x = b.x + math.cos(b.angle) * b.speed
    b.y = b.y + math.sin(b.angle) * b.speed
    b.life = b.life - 1
    local kill = b.life <= 0
    if solid_at(b.x, b.y, 0) then
      burst(b.x, b.y, 2, 13, 0.6)
      kill = true
    end
    if not kill and b.owner == "p" then
      for _, e in ipairs(WORLD.peds) do
        if not e.dead and dist(b.x, b.y, e.x, e.y) < 6 then
          kill_ped(e, false)
          kill = true
          break
        end
      end
    end
    if not kill and b.owner == "p" then
      for _, e in ipairs(WORLD.cops) do
        if not e.dead and dist(b.x, b.y, e.x, e.y) < 6 then
          e.hp = e.hp - 1
          burst(e.x, e.y, 3, 2, 0.8)
          if e.hp <= 0 then
            e.dead = true
            crime(3)
            if math.random() < 0.5 then new_pickup(e.x, e.y, "cash", 60) end
          end
          kill = true
          break
        end
      end
    end
    if not kill then
      for _, c in ipairs(WORLD.cars) do
        if not c.dead and c ~= p.car and dist(b.x, b.y, c.x, c.y) < 8 then
          if c.police and b.owner == "p" then crime(1) end
          damage_car(c, 1)
          burst(b.x, b.y, 2, 4, 1)
          kill = true
          break
        end
      end
    end
    if not kill and b.owner == "c" then
      if dist(b.x, b.y, p.x, p.y) < 6 and not p.car then
        damage_player(b.dmg)
        kill = true
      elseif p.car and not p.car.dead and dist(b.x, b.y, p.car.x, p.car.y) < 8 then
        damage_player(math.floor(b.dmg / 2))
        damage_car(p.car, 1)
        kill = true
      end
    end
    if kill then table.remove(WORLD.bullets, i) end
  end
end

function update_pickups()
  local p = GAME.player
  for i = #WORLD.pickups, 1, -1 do
    local it = WORLD.pickups[i]
    it.timer = it.timer - 1
    it.bob = it.bob + 1
    if it.timer <= 0 and dist(p.x, p.y, it.x, it.y) < 12 then
      if it.kind == "cash" then
        add_money(it.value)
        show_msg("GRAB +$" .. it.value)
        snd(SFX.cash)
      elseif it.kind == "med" then
        p.health = clamp(p.health + it.value, 0, CFG.health)
        show_msg("MEDKIT +" .. it.value)
        snd(SFX.cash)
      end
      burst(it.x, it.y, 8, 4, 1.2)
      it.timer = 900
      local tries = 0
      it.x = 100 + math.random(0, 700)
      it.y = 100 + math.random(0, 440)
      while solid_at(it.x, it.y, 3) and tries < 40 do
        it.x = 100 + math.random(0, 700)
        it.y = 100 + math.random(0, 440)
        tries = tries + 1
      end
    end
  end
end

function node_dist(n, x, y)
  return math.abs(n.x - x) + math.abs(n.y - y)
end

function random_drop()
  local p = GAME.player
  local best = WORLD.nodes[1]
  local bd = -1
  for _, n in ipairs(WORLD.nodes) do
    local d = dist(n.x, n.y, p.x, p.y)
    if d > 280 and d < 700 and d > bd then
      bd = d
      best = n
    end
  end
  return { x = best.x, y = best.y }
end

function pick_mission_car()
  local p = GAME.player
  local best = nil
  local bd = 1e9
  for _, c in ipairs(WORLD.cars) do
    if c.parked and not c.dead and c ~= p.car then
      local d = dist(c.x, c.y, p.x, p.y)
      if d < bd then bd = d best = c end
    end
  end
  for _, c in ipairs(WORLD.cars) do c.marked = false end
  if best then best.marked = true end
  return best
end

function spawn_hit_target()
  local p = GAME.player
  for i = 1, 30 do
    local n = WORLD.nodes[math.random(1, #WORLD.nodes)]
    local x = n.x + math.random(-20, 20)
    local y = n.y + math.random(-20, 20)
    local d = dist(x, y, p.x, p.y)
    if d > 220 and d < 520 and not solid_at(x, y, 4) then
      local e = new_ped(x, y, SPR.ped2)
      e.target = true
      e.hp = 2
      e.base = SPR.ped2
      return e
    end
  end
  return new_ped(GAME.ww / 2, 300, SPR.ped2)
end

function new_job()
  GAME.jobn = GAME.jobn + 1
  for _, c in ipairs(WORLD.cars) do c.marked = false end
  if GAME.jobn % 3 == 0 then
    local e = spawn_hit_target()
    GAME.job = { type = "hit", ped = e, phase = 1, payout = 450 + GAME.jobn * 50 }
    show_msg("JOB: HIT THE MARKED TARGET")
  else
    local c = pick_mission_car()
    if c then
      GAME.job = { type = "steal", car = c, phase = 1, payout = 300 + GAME.jobn * 40 }
      show_msg("JOB: STEAL THE MARKED RIDE")
    else
      local e = spawn_hit_target()
      GAME.job = { type = "hit", ped = e, phase = 1, payout = 450 + GAME.jobn * 50 }
      show_msg("JOB: HIT THE MARKED TARGET")
    end
  end
  snd(SFX.job)
end

function complete_job()
  local j = GAME.job
  if not j then return end
  add_money(j.payout)
  if j.car then j.car.marked = false end
  GAME.heat = clamp(GAME.heat + 1, 0, CFG.heat_max)
  GAME.heat_t = 0
  GAME.shake = 4
  show_msg("PAYDAY +$" .. j.payout)
  snd(SFX.cash)
  burst(GAME.player.x, GAME.player.y, 12, 4, 1.6)
  if GAME.money >= CFG.money_win and not GAME.won then
    GAME.won = true
    GAME.win_t = 300
    show_msg("CITY KINGPIN")
    snd(SFX.job)
  end
  new_job()
end

function update_job()
  local j = GAME.job
  if not j then return end
  local p = GAME.player
  if j.type == "steal" then
    if not j.car or j.car.dead then
      j.car = pick_mission_car()
      j.phase = 1
      if not j.car then
        j.type = "hit"
        j.ped = spawn_hit_target()
        j.payout = 450 + GAME.jobn * 50
        show_msg("JOB: HIT THE MARKED TARGET")
        return
      end
    end
    if j.car then
      if j.phase == 1 then
        GAME.mission = "STEAL THE MARKED RIDE"
        GAME.target = { x = j.car.x, y = j.car.y }
        if p.car == j.car then
          j.phase = 2
          j.drop = random_drop()
          show_msg("DELIVER IT TO THE DROP")
          snd(SFX.job)
        end
      else
        GAME.mission = "DELIVER THE RIDE"
        j.drop = j.drop or random_drop()
        GAME.target = j.drop
        if p.car == j.car and dist(p.x, p.y, j.drop.x, j.drop.y) < 30 and math.abs(j.car.speed) < 1.5 then
          complete_job()
        end
      end
    end
  else
    if j.ped and not j.ped.dead then
      GAME.mission = "TAKE OUT THE TARGET"
      GAME.target = { x = j.ped.x, y = j.ped.y }
    else
      GAME.target = { x = p.x, y = p.y }
    end
  end
end

function update_prompt()
  local p = GAME.player
  GAME.prompt = nil
  if garage_zone(p) then
    if p.car then
      GAME.prompt = "A: RESPRAY $200"
    elseif p.health < CFG.health then
      GAME.prompt = "A: HEAL $100"
    end
  elseif not p.car then
    local c, d = nearest_car(p)
    if c then
      if c.marked then
        GAME.prompt = "A: STEAL MARKED RIDE"
      else
        GAME.prompt = "A: STEAL RIDE"
      end
    end
  end
end

function update_shake()
  if GAME.shake > 0 then
    GAME.shake = GAME.shake * 0.85
    if GAME.shake < 0.5 then GAME.shake = 0 end
  end
end

function update_play()
  update_player()
  update_peds()
  update_traffic()
  update_cops()
  update_police_cars()
  update_bullets()
  update_pickups()
  update_job()
  update_heat()
  update_effects()
  update_camera()
  update_prompt()
  update_msg()
  update_shake()
  for i = #WORLD.cars, 1, -1 do
    local c = WORLD.cars[i]
    if c.dead then
      c.dead_t = (c.dead_t or 0) + 1
      if c.dead_t > 150 then table.remove(WORLD.cars, i) end
    end
  end
  local parked = 0
  for _, c in ipairs(WORLD.cars) do
    if c.parked and not c.dead then parked = parked + 1 end
  end
  if parked < 7 then respawn_parked() end
end

function respawn()
  local p = GAME.player
  p.dead = false
  p.health = CFG.health
  p.car = nil
  p.inv = 60
  p.x, p.y = 208, 236
  p.facing = 0
  add_money(-150)
  GAME.heat = 0
  GAME.heat_t = 0
  WORLD.cops = {}
  WORLD.bullets = {}
  for _, c in ipairs(WORLD.cars) do
    if c.police then c.dead = true end
  end
  if GAME.job then
    if GAME.job.type == "steal" then
      GAME.job.phase = 1
      GAME.job.drop = nil
      if not GAME.job.car or GAME.job.car.dead then
        GAME.job.car = pick_mission_car()
      end
    end
  end
  GAME.camx = clamp(p.x - CFG.sw / 2, 0, CFG.ww - CFG.sw - 8)
  GAME.camy = clamp(p.y - CFG.sh / 2, 0, CFG.wh - CFG.sh - 8)
  GAME.state = "play"
  show_msg("PATCHED UP -$150")
end

