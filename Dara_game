  local spots = WORLD.park_spots
  if not spots then return end
  for i = 1, 8 do
    local s = spots[math.random(1, #spots)]
    local free = true
    for _, c in ipairs(WORLD.cars) do
      if not c.dead and dist(c.x, c.y, s.x, s.y) < 22 then free = false break end
    end
    if free then
      local c = new_car(s.x, s.y, s.a, math.random(1, 3))
      c.parked = true
      return
    end
  end
end

function spawn_traffic(near)
  local i, j
  if near then
    local pi = clamp(math.floor(GAME.player.x / CFG.cw), 0, 5)
    local pj = clamp(math.floor(GAME.player.y / CFG.ch), 0, 4)
    i = clamp(pi + math.random(-2, 2), 0, 5)
    j = clamp(pj + math.random(-2, 2), 0, 4)
  else
    i, j = math.random(0, 5), math.random(0, 4)
  end
  local dir = math.random(0, 3)
  local c = new_car(node_x(i), node_y(j), 0, math.random(1, 3))
  c.traffic = true
  c.ni, c.nj = i, j
  c.ti, c.tj = i, j
  c.dir = dir
  c.speed = math.random(40, 60) / 100
  local dx, dy = 0, 0
  if dir == 0 then dx = 1 elseif dir == 1 then dy = 1 elseif dir == 2 then dx = -1 else dy = -1 end
  c.ti = clamp(i + dx, 0, 5)
  c.tj = clamp(j + dy, 0, 4)
  c.angle = atan2(dy, dx)
  c.x = node_x(i) - dy * 6
  c.y = node_y(j) + dx * 6
  return c
end

