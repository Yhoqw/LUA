    spr(base + dir8(e.angle) * 2, math.floor(x) - 8, math.floor(y) - 8, 0, 1, false, 0, 2, 2)
  end
end

function draw_car(c, camx, camy)
  if c.dead then return end
  local x, y = c.x - camx, c.y - camy
  if x > -20 and x < 260 and y > -20 and y < 156 then
    elli(x, y + 5, 8, 3, 0)
    if c.marked then
      local pulse = math.sin(GAME.t * 0.2) * 2
      line(x - 6, y - 14, x, y - 18 - pulse, 4)
      line(x, y - 18 - pulse, x + 6, y - 14, 4)
      line(x + 6, y - 14, x, y - 10, 4)
      line(x, y - 10, x - 6, y - 14, 4)
    end
    spr(c.base + dir8(c.angle) * 2, math.floor(x) - 8, math.floor(y) - 8, 0, 1, false, 0, 2, 2)
  end
end

function draw_entities(camx, camy)
  for _, e in ipairs(WORLD.peds) do
    draw_char(e, e.base, camx, camy, math.sin((GAME.t + e.step) * 0.2) * 0.6)
  end
  for _, e in ipairs(WORLD.cops) do
    draw_char(e, e.base, camx, camy, 0)
  end
  local p = GAME.player
  for _, c in ipairs(WORLD.cars) do
    if c ~= p.car then draw_car(c, camx, camy) end
  end
  if p.car then
    draw_car(p.car, camx, camy)
  elseif not p.dead then
    local bob = 0
    if p.moving then bob = math.sin(p.walk * 0.55) * 0.8 end
    draw_char(p, SPR.player, camx, camy, bob)
    if p.inv > 0 and math.floor(GAME.t / 2) % 2 == 0 then
      circb(p.x - camx, p.y - camy, 7, 12)
    end
  end
end

function draw_bullets(camx, camy)
