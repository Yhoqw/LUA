function draw_buildings(camx, camy)
  for _, b in ipairs(WORLD.buildings) do
    local x, y = b.x - camx, b.y - camy
    if x < 240 and x + b.w > 0 and y < 136 and y + b.h > 0 then
      rect(x + 3, y + 3, b.w, b.h, 0)
      rect(x, y, b.w, b.h, b.base)
      rect(x + 2, y + 2, b.w - 4, b.h - 4, b.roof)
      rectb(x, y, b.w, b.h, b.edge)
      rectb(x + 2, y + 2, b.w - 4, b.h - 4, b.edge)
      if b.w > 40 and b.h > 30 then
        rectb(x + 6, y + 6, b.w - 12, b.h - 12, b.edge)
        local tx = x + 10 + (b.seed * 13) % math.max(1, b.w - 28)
        local ty = y + 10 + (b.seed * 29) % math.max(1, b.h - 28)
        circ(tx, ty, 3, b.edge)
        circb(tx, ty, 3, b.base)
      end
      local n = math.floor(b.w / 11)
      for i = 1, n do
        local wx = x + 4 + (i - 1) * (b.w - 8) / n
        local lit = (i + b.seed) % 3 == 0
        rect(wx, y + b.h - 3, 3, 2, lit and 4 or 15)
      end
      for i = 1, b.ac do
        local ax = x + 6 + (i * 29 + b.seed * 7) % math.max(1, b.w - 18)
        local ay = y + 6 + (i * 17 + b.seed * 5) % math.max(1, b.h - 18)
        rect(ax, ay, 6, 4, 13)
        rectb(ax, ay, 6, 4, 15)
      end
      rect(x + math.floor(b.w / 2) - 2, y + b.h - 2, 4, 2, 4)
    end
  end
end

