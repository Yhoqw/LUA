function draw_target_world(camx, camy)
  local t = GAME.target
  if not t then return end
  local x, y = t.x - camx, t.y - camy
  if x < 0 or x > 240 or y < 0 or y > 136 then return end
  local pulse = 2 + math.sin(GAME.t * 0.15) * 2
  if GAME.job and GAME.job.phase == 2 then
    circb(x, y, 18 + pulse, 4)
    circb(x, y, 10, 4)
  else
    line(x, y - 14 - pulse, x + 5, y - 9 - pulse, 4)
    line(x + 5, y - 9 - pulse, x, y - 4 - pulse, 4)
    line(x, y - 4 - pulse, x - 5, y - 9 - pulse, 4)
    line(x - 5, y - 9 - pulse, x, y - 14 - pulse, 4)
  end
end

function draw_arrow(camx, camy)
  local t = GAME.target
  if not t then return end
  local sx, sy = t.x - camx, t.y - camy
  if sx > 10 and sx < 230 and sy > 16 and sy < 118 then return end
  local ang = atan2(sy - 68, sx - 120)
  local cx = clamp(sx, 12, 228)
  local cy = clamp(sy, 18, 116)
  local c = 4
  if math.floor(GAME.t / 10) % 2 == 0 then c = 13 end
  local x1 = cx + math.cos(ang) * 6
  local y1 = cy + math.sin(ang) * 6
  local x2 = cx + math.cos(ang + 2.4) * 6
  local y2 = cy + math.sin(ang + 2.4) * 6
  local x3 = cx + math.cos(ang - 2.4) * 6
  local y3 = cy + math.sin(ang - 2.4) * 6
  tri(x1, y1, x2, y2, x3, y3, c)
end

function star(x, y, c)
  line(x - 3, y, x + 3, y, c)
  line(x, y - 3, x, y + 3, c)
  line(x - 2, y - 2, x + 2, y + 2, c)
  line(x - 2, y + 2, x + 2, y - 2, c)
end

function draw_minimap()
  local mx, my, mw, mh = 184, 14, 52, 34
  local sx, sy = mw / CFG.ww, mh / CFG.wh
  rect(mx - 1, my - 1, mw + 2, mh + 2, 15)
  rect(mx, my, mw, mh, 0)
  for i = 0, 5 do
    local x = mx + node_x(i) * sx
    rect(x, my, 2, mh, 15)
  end
  for j = 0, 4 do
    local y = my + node_y(j) * sy
    rect(mx, y, mw, 2, 15)
  end
  for _, b in ipairs(WORLD.buildings) do
    rect(mx + b.x * sx, my + b.y * sy, math.max(1, b.w * sx), math.max(1, b.h * sy), 8)
  end
  local p = GAME.player
  local gx, gy = 208, 196
  if math.floor(GAME.t / 15) % 3 ~= 0 then rect(mx + gx * sx, my + gy * sy, 2, 2, 6) end
  if GAME.target then
    local tx = mx + GAME.target.x * sx
    local ty = my + GAME.target.y * sy
    if math.floor(GAME.t / 12) % 2 == 0 then rect(tx - 1, ty - 1, 3, 3, 4) end
  end
  for _, c in ipairs(WORLD.cops) do
    rect(mx + c.x * sx, my + c.y * sy, 2, 2, 2)
  end
  for _, c in ipairs(WORLD.cars) do
    if c.police and not c.dead then rect(mx + c.x * sx, my + c.y * sy, 2, 2, 2) end
  end
  rect(mx + p.x * sx - 1, my + p.y * sy - 1, 3, 3, 12)
end

