function is_park(ci, cj)
  return (ci == 1 and cj == 1) or (ci == 4 and cj == 3) or (ci == 2 and cj == 4) or (ci == 5 and cj == 2)
end

function add_building(x, y, w, h, pal)
  table.insert(WORLD.buildings, {
    x = x, y = y, w = w, h = h,
    base = pal.base, roof = pal.roof, edge = pal.edge,
    seed = math.random(1, 999), ac = math.random(1, 3),
  })
end

function build_block(ci, cj)
  local cx, cy = ci * CFG.cw, cj * CFG.ch
  if is_park(ci, cj) then
    for i = 1, 12 do
      local x = cx + 40 + math.random(0, 108)
      local y = cy + 40 + math.random(0, 70)
      if dist(x, y, 208, 196) > 46 then
        table.insert(WORLD.trees, { x = x, y = y, s = math.random(4, 6) })
      end
    end
    return
  end
  if (ci * 7 + cj * 11) % 6 == 0 then return end
  local pal = BPAL[(ci * 5 + cj * 3) % #BPAL + 1]
  local x0, y0 = cx + 32, cy + 32
  if (ci + cj) % 3 == 0 then
    add_building(x0, y0, 48, 80, pal)
    add_building(x0 + 64, y0, 48, 80, pal)
  elseif (ci + cj) % 3 == 1 then
    add_building(x0, y0, 112, 34, pal)
    add_building(x0, y0 + 46, 112, 34, pal)
  else
    add_building(x0 + 4, y0 + 4, 104, 72, pal)
  end
end

function build_city()
  WORLD.buildings = {}
  WORLD.trees = {}
  WORLD.lamps = {}
  for ty = 0, 79 do
    for tx = 0, 119 do
      local ci, cj = math.floor(tx / 20), math.floor(ty / 16)
      local cx, cy = tx % 20, ty % 16
      local t
      if cx < 3 or cy < 3 then
        if cx < 3 and cy < 3 then
          t = TILE.asphalt
        elseif cy < 3 then
          if cy == 1 then t = TILE.road_h else t = TILE.asphalt end
        else
          if cx == 1 then t = TILE.road_v else t = TILE.asphalt end
        end
      else
        local bx, by = cx - 3, cy - 3
        if bx == 0 or by == 0 or bx == 16 or by == 12 then
          t = TILE.walk
        elseif is_park(ci, cj) then
          if by == 6 or bx == 8 then
            t = TILE.path
          elseif (tx + ty) % 7 == 0 then
            t = TILE.grass2
          else
            t = TILE.grass
          end
        else
          t = TILE.lot
        end
      end
      mset(tx, ty, t)
    end
  end
  for ci = 0, 5 do
    for cj = 0, 4 do
      build_block(ci, cj)
      table.insert(WORLD.lamps, { x = node_x(ci) + 16, y = node_y(cj) + 16 })
    end
  end
end

function solid_at(x, y, r)
  if x - r < 0 or y - r < 0 or x + r > CFG.ww or y + r > CFG.wh then return true end
  for _, b in ipairs(WORLD.buildings) do
    if x + r > b.x and x - r < b.x + b.w and y + r > b.y and y - r < b.y + b.h then
      return true
    end
  end
  return false
end

function move_actor(a, dx, dy, r)
  if dx ~= 0 and not solid_at(a.x + dx, a.y, r) then a.x = a.x + dx end
  if dy ~= 0 and not solid_at(a.x, a.y + dy, r) then a.y = a.y + dy end
end

