function init_title()
  TITLE.sky = {}
  local x = -4
  while x < 244 do
    local w = math.random(14, 32)
    local h = math.random(20, 70)
    table.insert(TITLE.sky, { x = x, w = w, h = h, seed = math.random(1, 99) })
    x = x + w + math.random(1, 6)
  end
end

function start_game()
  GAME.state = "play"
  if not GAME.job then new_job() end
end

function TIC()
  GAME.t = GAME.t + 1
  if GAME.state == "title" then
    draw_title()
    if btnp(INPUT.fire) or btnp(INPUT.use) then
      start_game()
    end
    return
  end
  if GAME.state == "wasted" then
    GAME.wasted_t = GAME.wasted_t - 1
    update_effects()
    update_shake()
    draw_game()
    draw_wasted()
    if GAME.wasted_t <= 0 then respawn() end
    return
  end
  update_play()
  draw_game()
end

