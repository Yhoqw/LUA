  function move_body(b)
    b.hit_wall = false
    b.x = b.x + b.vx
    if b.x < 0 then b.x = 0; b.vx = 0; b.hit_wall = true end
    local max_x = WORLD.level_w * 8 - b.w
    if b.x > max_x then b.x = max_x; b.vx = 0; b.hit_wall = true end
    local row0 = math.floor((b.y + 1) / 8)
    local row1 = math.floor((b.y + b.h - 1) / 8)
    if b.vx > 0 then
      local tx = math.floor((b.x + b.w - 1) / 8)
      for ty = row0, row1 do
        if solid_at(tx, ty) then
          b.x = tx * 8 - b.w
          b.vx = 0
          b.hit_wall = true
          break
        end
      end
    elseif b.vx < 0 then
      local tx = math.floor(b.x / 8)
      for ty = row0, row1 do
        if solid_at(tx, ty) then
          b.x = (tx + 1) * 8
          b.vx = 0
          b.hit_wall = true
          break
        end
      end
    end
    local old_bottom = b.y + b.h
    b.y = b.y + b.vy
    b.grounded = false
    if b.vy >= 0 then
      local ty = math.floor((b.y + b.h - 1) / 8)
      local x0 = math.floor((b.x + 1) / 8)
      local x1 = math.floor((b.x + b.w - 1) / 8)
      for tx = x0, x1 do
        if solid_at(tx, ty) then
          b.y = ty * 8 - b.h
          b.vy = 0
          b.grounded = true
          break
        elseif platform_at(tx, ty) and not b.on_ladder and
              old_bottom <= ty * 8 + CFG.platform_tolerance then
          b.y = ty * 8 - b.h
          b.vy = 0
          b.grounded = true
          break
        end
      end
    else
      local ty = math.floor(b.y / 8)
      local x0 = math.floor((b.x + 1) / 8)
      local x1 = math.floor((b.x + b.w - 1) / 8)
      for tx = x0, x1 do
        if solid_at(tx, ty) then
          b.y = (ty + 1) * 8
          b.vy = 0
          break
        end
      end
    end
    if b.y < 0 then
      b.y = 0
      if b.vy < 0 then b.vy = 0 end
    end
    local feet = math.floor((b.y + b.h) / 8)
    local gx0 = math.floor((b.x + 1) / 8)
    local gx1 = math.floor((b.x + b.w - 1) / 8)
    b.grounded = false
    if b.vy >= 0 then
      for tx = gx0, gx1 do
        if solid_at(tx, feet) then
          b.grounded = true
          break
        elseif platform_at(tx, feet) and not b.on_ladder and
              b.y + b.h <= feet * 8 + CFG.platform_tolerance then
          b.grounded = true
          break
        end
      end
    end
    if b.grounded then
      b.y = feet * 8 - b.h
      b.vy = 0
    end
  end

  function spawn_particle(x, y, vx, vy, life, color, size, gravity)
    if #WORLD.fx >= CFG.max_fx then table.remove(WORLD.fx, 1) end
    WORLD.fx[#WORLD.fx + 1] = {
      x = x, y = y, vx = vx, vy = vy, life = life,
      color = color, size = size or 1, gravity = gravity or 0,
    }
  end

  function spawn_spark(x, y)
    for i = 1, 4 do
      local a = (i / 4) * math.pi * 2 + GAME.t * 0.3
      spawn_particle(x, y, math.cos(a) * 0.8, math.sin(a) * 0.8, 8, 10, 1, 0.02)
    end
  end

  function spawn_explosion(x, y, count, big)
    local n = count or 12
    for i = 1, n do
      local a = (i / n) * math.pi * 2
      local sp = 0.6 + (i % 3) * 0.4
      spawn_particle(x, y, math.cos(a) * sp, math.sin(a) * sp,
                    20 + (i % 5) * 4, i % 2 == 0 and 9 or 8, 2, 0.04)
    end
    spawn_particle(x, y, 0, 0, 12, 7, big and 6 or 3, 0)
    GAME.shake = math.max(GAME.shake, big and 8 or 4)
  end

  function update_fx()
    for i = #WORLD.fx, 1, -1 do
      local f = WORLD.fx[i]
      f.x = f.x + f.vx
      f.y = f.y + f.vy
      f.vy = f.vy + f.gravity
      f.life = f.life - 1
      if f.life <= 0 then table.remove(WORLD.fx, i) end
    end
  end

  function update_messages()
    if GAME.msg_t > 0 then
      GAME.msg_t = GAME.msg_t - 1
      if GAME.msg_t <= 0 then GAME.msg = "" end
    end
  end

  function spawn_bullet(owner, x, y, vx, vy, damage, spr, gravity, life)
    WORLD.bullets[#WORLD.bullets + 1] = {
      owner = owner, x = x, y = y, vx = vx, vy = vy,
      damage = damage, spr = spr, gravity = gravity or 0,
      life = life or 120, flip = vx < 0 and 1 or 0,
    }
  end

  function update_bullets()
    for i = #WORLD.bullets, 1, -1 do
      local b = WORLD.bullets[i]
      b.x = b.x + b.vx
      b.y = b.y + b.vy
      b.vy = b.vy + b.gravity
      b.life = b.life - 1
      local hit = false
      if b.life <= 0 or b.x < -8 or b.x > WORLD.level_w * 8 + 8 or
        b.y < -16 or b.y > CFG.level_h * 8 + 16 then
        hit = true
      end
      if not hit and tile_at_px(b.x, b.y) == TILE.solid then
        hit = true
        spawn_spark(b.x, b.y)
      end
      if not hit and b.owner == "player" then
        for j = #WORLD.enemies, 1, -1 do
          local e = WORLD.enemies[j]
          if not e.dead and point_box(b.x, b.y, 2, e.x, e.y, e.w, e.h) then
            damage_enemy(e, b.damage)
            spawn_spark(b.x, b.y)
            hit = true
            break
          end
        end
      elseif not hit and b.owner == "enemy" then
        local p = WORLD.player
        if p and point_box(b.x, b.y, 2, p.x, p.y, p.w, p.h) then
          damage_player(b.damage)
          spawn_spark(b.x, b.y)
          hit = true
        end
      end
      if hit then table.remove(WORLD.bullets, i) end
    end
  end

  function damage_enemy(e, n)
    if e.dead then return end
    e.hp = e.hp - n
    if e.hp <= 0 then kill_enemy(e) end
  end

  function kill_enemy(e)
    e.dead = true
    GAME.score = GAME.score + e.score
    if e.kind == "tank" then
      spawn_explosion(e.x + e.w / 2, e.y + e.h / 2, 40, true)
      GAME.boss_active = false
      WORLD.boss = nil
      GAME.state = "victory"
      GAME.victory_t = 0
      GAME.shake = 14
      show_msg("HEAVY TANK DESTROYED", 240)
      play_sfx("explode")
    else
      spawn_explosion(e.x + e.w / 2, e.y + e.h / 2, 10, false)
      play_sfx("explode")
    end
  end

  function kill_player(force)
    local p = WORLD.player
    if not p or p.dead then return end
    if not force and p.invuln > 0 then return end
    if GAME.state ~= "play" then return end
    p.dead = true
    p.invuln = 999
    GAME.state = "dead"
    GAME.dead_t = CFG.death_delay
    GAME.shake = 10
    spawn_explosion(p.x + p.w / 2, p.y + p.h / 2, 14, false)
    show_msg("PILOT DOWN", 120)
    play_sfx("hit")
  end

  function eject_from_mech(destroyed)
    local p = WORLD.player
    local m = p.mech
    if not m then return end
    local ox, oy = p.x, p.y
    if destroyed then
      spawn_explosion(ox + 8, oy + 8, 24, true)
      show_msg("MECH DESTROYED - EJECT", 140)
      play_sfx("explode")
    else
      m.x = ox
      m.y = oy
      m.vx = 0
      m.vy = 0
      m.active = false
      WORLD.mechs[#WORLD.mechs + 1] = m
      show_msg("MECH DISENGAGED", 90)
      play_sfx("eject")
    end
    p.mech = nil
    p.form = "pilot"
    p.w = 6
    p.h = 8
    p.x = ox + 5
    p.y = oy + (destroyed and 4 or 8)
    p.vx = destroyed and p.facing * 1.4 or 0
    p.vy = destroyed and -3.0 or -1.2
    p.invuln = destroyed and CFG.eject_invuln or CFG.manual_eject_invuln
    p.on_ladder = false
    p.grounded = false
    p.thrusting = false
    p.fire_cd = 0
    p.jump_buffer = 0
    p.coyote = 0
    GAME.use_cd = CFG.use_cooldown
    if destroyed then GAME.shake = 10 end
  end

  function damage_player(n)
    local p = WORLD.player
    if not p or GAME.state ~= "play" or p.dead then return end
    if p.invuln > 0 then return end
    if p.form == "mech" then
      local m = p.mech
      m.hp = m.hp - n
      p.invuln = CFG.hit_invuln
      GAME.shake = math.max(GAME.shake, 3)
      spawn_spark(p.x + p.w / 2, p.y + p.h / 2)
      play_sfx("hit")
      if m.hp <= 0 then eject_from_mech(true) end
    else
      p.hp = p.hp - n
      if p.hp <= 0 then
        kill_player(false)
      else
        p.invuln = CFG.hit_invuln
        GAME.shake = math.max(GAME.shake, 3)
        spawn_spark(p.x + p.w / 2, p.y + p.h / 2)
        play_sfx("hit")
      end
    end
  end

  function nearest_mech()
    local p = WORLD.player
    if not p then return nil, 9999 end
    local best, best_d = nil, 9999
    for _, m in ipairs(WORLD.mechs) do
      if m.hp > 0 then
        local dx = (m.x + m.w / 2) - (p.x + p.w / 2)
        local dy = (m.y + m.h / 2) - (p.y + p.h / 2)
        local d = math.sqrt(dx * dx + dy * dy)
        if d < 26 and d < best_d then
          best = m
          best_d = d
        end
      end
    end
    return best, best_d
  end

  function mount_mech(m)
    local p = WORLD.player
    for i = #WORLD.mechs, 1, -1 do
      if WORLD.mechs[i] == m then table.remove(WORLD.mechs, i) end
    end
    local def = MECHS[m.variant]
    m.active = true
    p.mech = m
    p.form = "mech"
    p.w = 16
    p.h = 16
    p.x = m.x
    p.y = m.y
    p.vx = 0
    p.vy = 0
    p.facing = m.facing or 1
    p.grounded = false
    p.on_ladder = false
    p.thrusting = false
    p.invuln = CFG.manual_eject_invuln
    p.fire_cd = 0
    p.jump_buffer = 0
    p.coyote = 0
    GAME.use_cd = CFG.use_cooldown
    show_msg(def.name .. " ONLINE", 90)
    play_sfx("pickup")
  end

  function try_use()
    local p = WORLD.player
    if GAME.use_cd > 0 then return end
    if p.form == "mech" then
      eject_from_mech(false)
    elseif not p.on_ladder then
      local m = nearest_mech()
      if m then
        mount_mech(m)
      else
        show_msg("NO MECH IN RANGE", 60)
      end
    end
  end

  function fire_player_weapon()
    local p = WORLD.player
    if p.fire_cd > 0 then return end
    local w
    if p.form == "pilot" then
      w = WEAPONS.pistol
    else
      w = WEAPONS[string.lower(MECHS[p.mech.variant].weapon)]
    end
    if not w then return end
    local aim = 0
    if not p.on_ladder then
      if btn(INPUT.up) then aim = -1 end
      if btn(INPUT.down) then aim = 1 end
    end
    local bx, by = p.facing, aim
    local bl = math.sqrt(bx * bx + by * by)
    bx, by = bx / bl, by / bl
    local mx = p.x + p.w / 2 + p.facing * 6
    local my = p.y + p.h / 2 + aim * 4
    for i = 1, w.pellets do
      local a = 0
      if w.pellets > 1 then a = (i - 2) * w.spread end
      local ca, sa = math.cos(a), math.sin(a)
      local vx = (bx * ca - by * sa) * w.speed
      local vy = (bx * sa + by * ca) * w.speed
      spawn_bullet("player", mx, my, vx, vy, w.damage, w.spr, w.gravity, w.life)
    end
    p.fire_cd = w.rate
    spawn_particle(mx, my, -p.facing * 0.3, 0, 4, 10, 2, 0)

    play_sfx(w.sfx) -- Pew Pew
  end

  function update_pilot(p, move) -- Handles Pilot Vertical Movement
    p.jump_buffer = math.max(0, p.jump_buffer - 1)
    p.coyote = p.grounded and CFG.coyote_time or math.max(0, p.coyote - 1)
    if btnp(INPUT.jump) then p.jump_buffer = CFG.jump_buffer end
    local cx = p.x + p.w / 2
    local lx = math.floor(cx / 8)
    local ly0 = math.floor((p.y + p.h - 1) / 8)
    local ly1 = math.floor((p.y + p.h / 2) / 8)
    local ladder_here = ladder_at(lx, ly0) or ladder_at(lx, ly1)
    if ladder_here and (btn(INPUT.up) or btn(INPUT.down) or p.on_ladder) then
      p.on_ladder = true                      -- Ladder Controls
      if btn(INPUT.down) then
        p.vy = CFG.pilot_climb
      elseif btn(INPUT.up) then
        p.vy = -CFG.pilot_climb
      else
        p.vy = 0
      end
      if p.jump_buffer > 0 then 
        p.jump_buffer = 0
        p.coyote = 0
        p.on_ladder = false
        p.vy = CFG.pilot_jump * 0.8
        p.vx = p.facing * 1.0

        play_sfx("jump")        -- Hop Hop
      end
    else
      p.on_ladder = false
      if p.jump_buffer > 0 and p.coyote > 0 then -- Grounded Controls
        p.jump_buffer = 0
        p.coyote = 0
        p.vy = CFG.pilot_jump
        p.grounded = false
        play_sfx("jump")
      end
      if p.grounded and p.vy >= 0 then
        p.vy = 0
      else
        p.vy = p.vy + CFG.pilot_gravity
        if p.vy > CFG.pilot_max_fall then p.vy = CFG.pilot_max_fall end
      end
    end
    if p.on_ladder then
      p.vx = move * CFG.pilot_speed * 0.55
    elseif move ~= 0 then
      p.vx = approach(p.vx, move * CFG.pilot_speed, CFG.pilot_accel)
    else
      p.vx = approach(p.vx, 0, CFG.pilot_friction)
    end
    move_body(p)
  end

  function update_mech(p, move)
    local def = MECHS[p.mech.variant]
    p.jump_buffer = math.max(0, p.jump_buffer - 1)
    p.coyote = p.grounded and CFG.coyote_time or math.max(0, p.coyote - 1)
    if btnp(INPUT.jump) then p.jump_buffer = CFG.jump_buffer end
    if move ~= 0 then
      p.vx = approach(p.vx, move * def.speed, def.accel)
    else
      p.vx = approach(p.vx, 0, def.friction)
    end
    if p.jump_buffer > 0 and p.coyote > 0 then
      p.jump_buffer = 0
      p.coyote = 0
      p.vy = def.jump
      p.grounded = false
      play_sfx("jump")
    end
    local thrusting = false
    if btn(INPUT.jump) and not p.grounded and p.mech.fuel > 0 then
      thrusting = true
      p.vy = math.max(p.vy - CFG.mech_thrust, -CFG.mech_max_rise)
      p.mech.fuel = math.max(0, p.mech.fuel - CFG.fuel_burn)      -- Fuel depletion
      if GAME.t % 6 == 0 then
        -- This is used for the particles underneath thrusters
        -- spawn_particle(x,y, other_params)
        spawn_particle(p.x + 8, p.y + 18, (math.random() - 0.5) * 0.4, 1.1, 12, 9, 2, 0.02)
      end

      if GAME.t % 18 == 0 then play_sfx("thrust") end
    end
    p.thrusting = thrusting
    if p.grounded and p.vy >= 0 then
      p.vy = 0
    else
      p.vy = p.vy + def.gravity
      if p.vy > CFG.mech_max_fall then p.vy = CFG.mech_max_fall end
    end
    move_body(p)
    p.on_ladder = false
    p.mech.x = p.x
    p.mech.y = p.y
    if p.grounded then
      p.mech.fuel = math.min(def.fuel, p.mech.fuel + CFG.fuel_regen)
    end
  end

  function update_player()    -- Handles General Player Controls
    local p = WORLD.player
    if not p then return end
    p.invuln = math.max(0, p.invuln - 1)
    p.fire_cd = math.max(0, p.fire_cd - 1)
    local move = (btn(INPUT.right) and 1 or 0) - (btn(INPUT.left) and 1 or 0)
    if move ~= 0 then p.facing = move end
    if p.form == "pilot" then
      update_pilot(p, move)
    else
      update_mech(p, move)
    end
    if btnp(INPUT.use) then try_use() end
    if btn(INPUT.fire) then fire_player_weapon() end
    if p.y > CFG.level_h * 8 + 24 then
      kill_player(true)
      return
    end
    p.x = clamp(p.x, 0, WORLD.level_w * 8 - p.w)
  end

  function update_mechs()
    for i = #WORLD.mechs, 1, -1 do
      local m = WORLD.mechs[i]
      m.vy = m.vy + 0.18
      if m.vy > CFG.pilot_max_fall then m.vy = CFG.pilot_max_fall end
      move_body(m)
      if m.y > CFG.level_h * 8 + 32 then table.remove(WORLD.mechs, i) end
    end
  end

  function update_grunt(e)
    if e.shoot_cd > 0 then e.shoot_cd = e.shoot_cd - 1 end
    e.vx = e.dir * e.speed
    if e.grounded then
      local fx = e.dir > 0 and e.x + e.w + 2 or e.x - 2
      local tx = math.floor(fx / 8)
      local ty = math.floor((e.y + e.h + 2) / 8)
      if not (solid_at(tx, ty) or platform_at(tx, ty)) then e.dir = -e.dir end
    end
    local front_x = e.dir > 0 and e.x + e.w + 1 or e.x - 1
    if solid_at(math.floor(front_x / 8), math.floor((e.y + e.h / 2) / 8)) then
      e.dir = -e.dir
    end
    e.vy = e.vy + CFG.enemy_gravity
    if e.vy > CFG.pilot_max_fall then e.vy = CFG.pilot_max_fall end
    move_body(e)
    if e.hit_wall then e.dir = -e.dir end
    e.facing = e.dir
    local p = WORLD.player
    local dx = (p.x + p.w / 2) - (e.x + e.w / 2)
    local dy = (p.y + p.h / 2) - (e.y + e.h / 2)
    if e.shoot_cd <= 0 and math.abs(dx) < e.range and math.abs(dy) < 20 and
      line_clear(e.x + e.w / 2, e.y + e.h / 2, p.x + p.w / 2, p.y + p.h / 2) then
      local dir = dx >= 0 and 1 or -1
      spawn_bullet("enemy", e.x + e.w / 2 + dir * 5, e.y + e.h / 2,
                  dir * 1.5, 0, 1, SPR.bullet_enemy, 0, 120)
      e.shoot_cd = 90
      play_sfx("enemy_shot")
    end
  end

  function update_drone(e)
    e.phase = e.phase + 0.05
    local p = WORLD.player
    local dx = (p.x + p.w / 2) - (e.x + e.w / 2)
    if math.abs(dx) < 120 then
      e.x = e.x + sign(dx) * e.speed
    else
      e.x = e.x + sign(e.anchor_x - e.x) * e.speed * 0.4
    end
    e.y = e.anchor_y + math.sin(e.phase) * 12
    e.x = clamp(e.x, 0, WORLD.level_w * 8 - e.w)
    e.facing = dx >= 0 and 1 or -1
    e.shoot_cd = e.shoot_cd - 1
    if e.shoot_cd <= 0 and math.abs(dx) < e.range then
      local dy = (p.y + p.h / 2) - (e.y + e.h / 2)
      local d = math.max(1, math.sqrt(dx * dx + dy * dy))
      spawn_bullet("enemy", e.x + e.w / 2, e.y + e.h,
                  dx / d * 1.3, math.max(0.6, dy / d * 1.3),
                  1, SPR.bullet_enemy, 0, 140)
      e.shoot_cd = 80
      play_sfx("enemy_shot")
    end
  end

  function update_turret(e)
    local p = WORLD.player
    local cx, cy = e.x + e.w / 2, e.y + e.h / 2
    local dx = (p.x + p.w / 2) - cx
    local dy = (p.y + p.h / 2) - cy
    local d = math.sqrt(dx * dx + dy * dy)
    e.shoot_cd = e.shoot_cd - 1
    e.los = d < e.range and line_clear(cx, cy, p.x + p.w / 2, p.y + p.h / 2)
    if e.los and e.shoot_cd <= 0 then
      local dl = math.max(1, d)
      spawn_bullet("enemy", cx + dx / dl * 12, cy + dy / dl * 12,
                  dx / dl * 1.6, dy / dl * 1.6, 1, SPR.bullet_enemy, 0, 160)
      e.shoot_cd = 70
      spawn_particle(cx + dx / dl * 12, cy + dy / dl * 12, 0, 0, 5, 10, 2, 0)
      play_sfx("enemy_shot")
    end
  end

  function update_boss(e)
    if not e.active then return end
    local p = WORLD.player
    local cx = e.x + e.w / 2
    local pcx = p.x + p.w / 2
    if pcx < cx - 20 then
      e.x = e.x - e.speed
    elseif pcx > cx + 20 then
      e.x = e.x + e.speed
    end
    e.x = clamp(e.x, CFG.boss_arena_x, WORLD.level_w * 8 - e.w)
    e.y = 120 - e.h
    e.facing = pcx < cx and -1 or 1
    e.shoot_cd = e.shoot_cd - 1
    if e.shoot_cd <= 0 then
      local dx = pcx - cx
      spawn_bullet("enemy", cx, e.y + 4, clamp(dx / 70, -1.6, 1.6), -2.0,
                  2, SPR.bullet_rocket, 0.06, 220)
      e.shoot_cd = 100
      GAME.shake = math.max(GAME.shake, 2)
      play_sfx("boss_shot")
    end
    if aabb(p, e) and p.invuln <= 0 then
      damage_player(2)
      p.vx = sign(p.x - e.x) * 2.0
      p.vy = -1.5
    end
  end

  function update_enemies()
    for i = #WORLD.enemies, 1, -1 do
      local e = WORLD.enemies[i]
      if e.dead then
        table.remove(WORLD.enemies, i)
      else
        if e.kind == "grunt" then
          update_grunt(e)
        elseif e.kind == "drone" then
          update_drone(e)
        elseif e.kind == "turret" then
          update_turret(e)
        elseif e.kind == "tank" then
          update_boss(e)
        end
        if e.y > CFG.level_h * 8 + 32 then e.dead = true end
      end
    end
  end

  function check_boss_trigger()
    if not GAME.boss_active and WORLD.boss and not WORLD.boss.dead and
      WORLD.player.x > CFG.boss_trigger then
      GAME.boss_active = true
      WORLD.boss.active = true
      GAME.shake = 8
      show_msg("WARNING: HEAVY TANK", 180)
      play_sfx("boss_shot")
    end
  end

  function update_camera()
    local p = WORLD.player
    local target = p.x + p.w / 2 - CFG.screen_w / 2 + p.facing * CFG.cam_look
    target = clamp(target, 0, WORLD.level_w * 8 - CFG.screen_w)
    GAME.cam = GAME.cam + (target - GAME.cam) * CFG.cam_lerp
    if math.abs(target - GAME.cam) < 0.2 then GAME.cam = target end
    GAME.shake = math.max(0, GAME.shake - 0.55)
  end

  function update_play()
    GAME.use_cd = math.max(0, GAME.use_cd - 1)
    update_player()
    if GAME.state == "play" then
      update_mechs()
      check_boss_trigger()
      update_enemies()
    end
    if GAME.state == "play" then update_bullets() end
    update_fx()
    update_messages()
    update_camera()
  end

  function update_dead()
    update_fx()
    update_messages()
    update_camera()
    GAME.dead_t = GAME.dead_t - 1
    if GAME.dead_t <= 0 then GAME.state = "gameover" end
  end

  function update_gameover()
    if btnp(INPUT.fire) or btnp(INPUT.jump) then reset_game() end
  end

  function update_victory()
    update_fx()
    update_messages()
    update_camera()
    GAME.victory_t = GAME.victory_t + 1
    if GAME.victory_t > 90 and (btnp(INPUT.fire) or btnp(INPUT.jump)) then
      reset_game()
    end
  end

  function update_title()
    if btnp(INPUT.fire) or btnp(INPUT.jump) then reset_game() end
  end

  function add_chassis(col, row, variant)
    local def = MECHS[variant]
    local w, h = 16, 16
    local x = col * 8 + 4 - w / 2
    local y = (row + 1) * 8 - h
    WORLD.mechs[#WORLD.mechs + 1] = {
      x = x, y = y, w = w, h = h, vx = 0, vy = 0,
      hp = def.hp, max_hp = def.hp, variant = variant,
      facing = -1, active = false, grounded = false,
      fuel = def.fuel,
    }
  end

  function spawn_enemy(kind, col, row)
    local t = ENEMY_TYPES[kind]
    local x = col * 8 + 4 - t.w / 2
    local y = (row + 1) * 8 - t.h
    local e = {
      kind = kind, x = x, y = y, w = t.w, h = t.h,
      hp = t.hp, max_hp = t.hp, score = t.score,
      speed = t.speed, range = t.range,
      vx = 0, vy = 0, dir = -1, facing = -1,
      grounded = false, dead = false, active = true,
      shoot_cd = t.shoot_cd, phase = col * 0.3,
      anchor_x = x, anchor_y = y, los = false,
    }
    if kind == "tank" then
      e.active = false
      e.shoot_cd = 90
      WORLD.boss = e
    end
    WORLD.enemies[#WORLD.enemies + 1] = e
  end

  function build_level()
    WORLD.level_w = CFG.level_w
    WORLD.level_h = CFG.level_h
    WORLD.mechs = {}
    WORLD.enemies = {}
    WORLD.bullets = {}
    WORLD.fx = {}
    WORLD.boss = nil
    for y = 0, CFG.level_h - 1 do
      for x = 0, CFG.level_w - 1 do mset(x, y, TILE.empty) end
    end
    local spawn_x, spawn_y = 24, 112
    for si, screen in ipairs(LEVEL1.screens) do
      local ox = (si - 1) * CFG.screen_tiles
      for ry = 1, CFG.level_h do
        local row = screen[ry]
        for rx = 1, CFG.screen_tiles do
          local ch = row:sub(rx, rx)
          local gx = ox + rx - 1
          local gy = ry - 1
          local tile = TILE.empty
          if ch == "#" then
            tile = TILE.solid
          elseif ch == "=" then
            tile = TILE.platform
          elseif ch == "H" then
            tile = TILE.ladder
          end
          mset(gx, gy, tile)
          if ch == "P" then
            spawn_x = gx * 8 + 1
            spawn_y = gy * 8
          elseif ch == "M" then
            add_chassis(gx, gy, "vanguard")
          elseif ch == "m" then
            add_chassis(gx, gy, "bulwark")
          elseif ch == "G" then
            spawn_enemy("grunt", gx, gy)
          elseif ch == "D" then
            spawn_enemy("drone", gx, gy)
          elseif ch == "T" then
            spawn_enemy("turret", gx, gy)
          elseif ch == "B" then
            spawn_enemy("tank", gx, gy)
          end
        end
      end
    end
    WORLD.player = {
      form = "pilot", x = spawn_x, y = spawn_y, w = 6, h = 8,
      vx = 0, vy = 0, facing = 1, grounded = false, on_ladder = false,
      invuln = 0, fire_cd = 0, hp = CFG.pilot_hp, mech = nil,
      thrusting = false, dead = false, jump_buffer = 0, coyote = 0,
    }
    GAME.score = 0
    GAME.cam = clamp(spawn_x - 100, 0, WORLD.level_w * 8 - CFG.screen_w)
    GAME.shake = 0
    GAME.msg = ""
    GAME.msg_t = 0
    GAME.use_cd = 0
    GAME.dead_t = 0
    GAME.victory_t = 0
    GAME.boss_active = false
    GAME.state = "play"
  end

  function reset_game()
    GAME.t = 0
    build_level()
  end

  -- DRAW FUNCTIONS

  function draw_parallax(cam, sx, sy)       
    
    -- Draw Rectangle Function
    -- rect(x,y,w,h,color)
    rect(0, 0, CFG.screen_w, CFG.screen_h, COLORS.purple)

    for _, s in ipairs(STARS) do
      local x = (s.x - cam * 0.12 * s.z) % 620
      if x < 0 then x = x + 620 end
      if x < CFG.screen_w then
        rect(math.floor(x + sx * 0.4), math.floor(s.y + sy * 0.4), 1, 1, s.c)
      end
    end
    local base = -((cam * 0.25) % 160)
    for i = 0, 3 do
      local x = base + i * 160
      if x > -20 and x < CFG.screen_w then
        -- Columns drawn in the background
        rect(math.floor(x + sx * 0.5), 0, 3, CFG.screen_h, COLORS.green)
        for y = 16, 116, 24 do
          rect(math.floor(x - 6 + sx * 0.5), y + math.floor(sy * 0.3), 15, 2, COLORS.green)
        end
      end
    end
    local pipe = (cam * 0.4) % 80
    for i = 0, 3 do
      local x = math.floor(-pipe + i * 80)
      -- Background Transmission lines
      line(x, 28, x + 80, 28, 13)
      line(x, 92, x + 80, 92, 13)
      rect(x + 20, 26, 8, 5, COLORS.green)
      rect(x + 56, 90, 8, 5, COLORS.green)
    end
  end

  function draw_map(cam, sx, sy)
    local start_col = math.max(0, math.floor(cam / 8) - 1)
    local end_col = math.min(WORLD.level_w - 1, math.floor((cam + CFG.screen_w) / 8) + 1)
    local w = end_col - start_col + 1
    if w <= 0 then return end
    local px = start_col * 8 - cam + sx
    map(start_col, 0, w, WORLD.level_h, math.floor(px), math.floor(sy), 0)
  end

  function draw_signs(cam, sx, sy)    -- Draws the text boxes in the gamespace
    for _, s in ipairs(LEVEL1.signs) do
      local x = s.x - cam + sx
      if x > -100 and x < CFG.screen_w then
        local w = #s.text * 6 + 4

        -- Text Boxes (size, color and Text)
        rect(math.floor(x - 2), math.floor(s.y - 1 + sy), w, 8, COLORS.black)
        print(s.text, math.floor(x), math.floor(s.y + sy), s.color)
      end
    end
  end

  function draw_mechs(cam, sx, sy)    -- Draws the Bullwark and the Vangaurd
    local p = WORLD.player
    local near = nearest_mech()
    for _, m in ipairs(WORLD.mechs) do
      if m.hp > 0 then
        local x = m.x - cam + sx
        local y = m.y + sy
        if x > -32 and x < CFG.screen_w + 16 then
          spr(SPR.mech_empty, math.floor(x), math.floor(y), 0, 1,
              m.facing < 0 and 1 or 0, 0, 2, 2)

          -- Draws the rectangle under the mech color
          -- Bulwark: palette red if true
          -- Vanguard: palette blue if false
          local c = m.variant == "bulwark" and COLORS.red or COLORS.blue       
          rect(math.floor(x + 6), math.floor(y + 12), 4, 2, c)

          if math.floor(GAME.t / 20) % 2 == 0 then  -- Box on unmanned Mech
            rect(math.floor(x + 7), math.floor(y + 6), 2, 1, COLORS.sea_blue)
          end
          if p.form == "pilot" and near == m then -- Mech Boarding Textbox
            local txt = "A BOARD"
            local tx = math.floor(x + 8 - #txt * 6 / 2)
            rect(tx - 2, math.floor(y - 10), #txt * 6 + 4, 8, COLORS.dark_blue)
            print(txt, tx, math.floor(y - 9), COLORS.blue)
          end
        end
      end
    end
  end

  function draw_enemies(cam, sx, sy)
    for _, e in ipairs(WORLD.enemies) do
      if not e.dead then
        local x = e.x - cam + sx
        local y = e.y + sy
        if x > -48 and x < CFG.screen_w + 48 then
          if e.kind == "grunt" then
            local frame = math.floor(GAME.t / 9) % 2 == 0 and SPR.grunt1 or SPR.grunt2
            spr(frame, math.floor(x), math.floor(y), 0, 1, e.dir < 0 and 1 or 0)
          elseif e.kind == "drone" then
            spr(SPR.drone, math.floor(x), math.floor(y), 0, 1, e.facing < 0 and 1 or 0)
            if math.floor(GAME.t / 10) % 2 == 0 then
              rect(math.floor(x + 3), math.floor(y + 3), 2, 1, COLORS.dark_blue)
            end
          elseif e.kind == "turret" then
            local cx = e.x + e.w / 2 - cam + sx
            local cy = e.y + e.h / 2 + sy
            local tx, ty
            if e.los then
              tx = WORLD.player.x + WORLD.player.w / 2 - cam + sx
              ty = WORLD.player.y + WORLD.player.h / 2 + sy
            else
              tx = cx - 18
              ty = cy - 6
            end
            line(math.floor(cx), math.floor(cy), math.floor(tx), math.floor(ty), 6)
            line(math.floor(cx), math.floor(cy) + 1, math.floor(tx), math.floor(ty) + 1, 5)
            spr(SPR.turret, math.floor(x), math.floor(y), 0, 1, 0, 0, 2, 2)
            circ(math.floor(cx), math.floor(cy), 2, 8)
          elseif e.kind == "tank" then
            local cx = e.x + e.w / 2 - cam + sx
            local cy = e.y + e.h / 2 + sy
            if e.active then
              local px = WORLD.player.x + WORLD.player.w / 2 - cam + sx
              local py = WORLD.player.y + WORLD.player.h / 2 + sy
              local dx, dy = px - cx, py - cy
              local d = math.max(1, math.sqrt(dx * dx + dy * dy))
              line(math.floor(cx), math.floor(cy),
                  math.floor(cx + dx / d * 22), math.floor(cy + dy / d * 22), 6)
            else
              line(math.floor(cx), math.floor(cy), math.floor(cx - 14), math.floor(cy), 6)
            end
            spr(SPR.boss, math.floor(x), math.floor(y), 0, 1,
                e.facing < 0 and 1 or 0, 0, 4, 2)
            if e.active and math.floor(GAME.t / 12) % 2 == 0 then
              rect(math.floor(x + 14), math.floor(y + 5), 4, 2, COLORS.dark_blue)
            end
          end
          if e.kind ~= "tank" and e.hp < e.max_hp then  -- Drawing the Tank
            rect(math.floor(x), math.floor(y - 4), e.w, 2, COLORS.black)
            rect(math.floor(x), math.floor(y - 4),
                math.floor(e.w * math.max(0, e.hp) / e.max_hp), 2, 
                COLORS.dark_blue)
          end
        end
      end
    end
  end

  function draw_player(cam, sx, sy)
    local p = WORLD.player
    if not p or p.dead then return end
    if p.invuln > 0 and math.floor(GAME.t / 3) % 2 == 0 then return end
    local x = p.x - cam + sx
    local y = p.y + sy
    if p.form == "pilot" then
      local frame = SPR.pilot_idle
      if not p.grounded and not p.on_ladder then
        frame = p.vy < 0 and SPR.pilot_jump or SPR.pilot_fall
      elseif math.abs(p.vx) > 0.2 or
            (p.on_ladder and math.abs(p.vy) > 0.2) then
        frame = math.floor(GAME.t / CFG.pilot_anim_rate) % 2 == 0 and
                SPR.pilot_run1 or SPR.pilot_run2
      end
      spr(frame, math.floor(x - 1), math.floor(y), 0, 1, p.facing < 0 and 1 or 0)
    else
      if not p.mech then return end
      local frame = SPR.mech_idle
      if not p.grounded then
        frame = p.thrusting and SPR.mech_thrust or SPR.mech_idle
      elseif math.abs(p.vx) > 0.2 then
        frame = math.floor(GAME.t / 6) % 2 == 0 and SPR.mech_walk1 or SPR.mech_walk2
      end
      spr(frame, math.floor(x), math.floor(y), 0, 1,
          p.facing < 0 and 1 or 0, 0, 2, 2)
      if p.thrusting then   -- Draws Booster Flames
        local fx = math.floor(x + 8)
        rect(fx - 2, math.floor(y + 15), 4, 3, COLORS.navy_blue)
        rect(fx - 1, math.floor(y + 18), 2, 3, COLORS.sea_blue)
      end
    end
  end

  function draw_bullets(cam, sx, sy)
    for _, b in ipairs(WORLD.bullets) do
      local x = b.x - cam + sx
      local y = b.y + sy
      if x > -8 and x < CFG.screen_w + 8 and y > -8 and y < CFG.screen_h + 8 then
        spr(b.spr, math.floor(x - 4), math.floor(y - 4), 0, 1, b.flip)
        if b.spr == SPR.bullet_rocket then
          rect(math.floor(x - 6 - sign(b.vx) * 2), math.floor(y), 2, 1, COLORS.navy_blue)
        end
      end
    end
  end

  function draw_fx(cam, sx, sy)
    for _, f in ipairs(WORLD.fx) do
      local x = f.x - cam + sx
      local y = f.y + sy
      if f.size >= 4 then 
        circ(math.floor(x), math.floor(y), math.floor(f.size), f.color)
      else
        rect(math.floor(x), math.floor(y), f.size, f.size, f.color)
      end
    end
  end

  function draw_hud()
    local p = WORLD.player
    rect(0, 0, CFG.screen_w, 15, COLORS.black)
    line(0, 15, CFG.screen_w - 1, 15, COLORS.green)
    if p.form == "pilot" then 
      -- Drawn the Player Stats
      print("PILOT", 3, 3, COLORS.white)
      print("HP " .. tostring(p.hp), 48, 3, COLORS.white)
      print("PISTOL", 112, 3, COLORS.white)
    else
      local def = MECHS[p.mech.variant]
      local ratio = math.max(0, p.mech.hp) / def.hp
      local col = 12
      if ratio <= 0.25 then
        col = 8
      elseif ratio <= 0.5 then
        col = 9
      end
      print(def.name, 3, 3, COLORS.white)
      rect(58, 4, 50, 6, COLORS.green)
      rect(58, 4, math.floor(50 * ratio), 6, col)
      local fr = math.max(0, p.mech.fuel) / def.fuel
      rect(58, 11, 50, 2, COLORS.green)
      rect(58, 11, math.floor(50 * fr), 2, COLORS.white)
      print(def.weapon, 112, 3, COLORS.white)
    end
    local st = "SCORE " .. GAME.score
    print(st, 238 - #st * 6, 3, COLORS.white)
    if GAME.boss_active and WORLD.boss and WORLD.boss.hp > 0 then
      local b = WORLD.boss
      local w = 120
      print("BOSS", 3, 18, COLORS.yellow)
      rect(59, 17, w + 2, 7, COLORS.black)
      rect(60, 18, w, 5, COLORS.green)
      rect(60, 18, math.floor(w * math.max(0, b.hp) / b.max_hp), 5, COLORS.dark_blue)
    end
    if GAME.msg_t > 0 then
      local w = #GAME.msg * 6 + 10
      local x = math.floor((CFG.screen_w - w) / 2)
      rect(x, 116, w, 14, COLORS.black)
      rectb(x, 116, w, 14, COLORS.dark_green)
      print(GAME.msg, x + 5, 120, COLORS.white)
    end
  end

  function draw_overlay_box(title, subtitle)
    rect(30, 40, 180, 56, COLORS.black)
    rectb(30, 40, 180, 56, COLORS.dark_blue)
    rectb(31, 41, 178, 54, COLORS.green)
    print_center(title, 50, COLORS.white, 1)
    print_center(subtitle, 72, COLORS.white, 1)
  end

  function draw_title()
    draw_parallax(GAME.t * 0.4, 0, 0)
    rect(0, 122, CFG.screen_w, 14, COLORS.green)
    for x = 0, CFG.screen_w, 16 do
      rect(x, 122, 1, 14, COLORS.purple)
    end
    line(0, 122, CFG.screen_w - 1, 122, 6)
    spr(SPR.pilot_idle, 88, 64, 0, 2)
    spr(SPR.mech_idle, 104, 52, 0, 2, 0, 0, 2, 2)
    print_center("MECH VANGUARD", 16, COLORS.white, 2)
    print_center("HANGAR INFILTRATION", 34, COLORS.white, 1)
    print_center("A TIC-80 MECHA ACTION GAME", 44, COLORS.white, 1)
    print_center("Z FIRE   X JUMP   A BOARD/EJECT", 94, COLORS.white, 1)
    local blink = math.floor(GAME.t / 20) % 2 == 0 and 10 or 6
    print_center("PRESS Z TO START", 108, blink, 1)
  end

  function draw_game()
    local shake_x, shake_y = 0, 0
    if GAME.shake > 0 then
      shake_x = math.sin(GAME.t * 1.7) * GAME.shake * 0.6
      shake_y = math.cos(GAME.t * 2.3) * GAME.shake * 0.4
    end
    draw_parallax(GAME.cam, shake_x * 0.5, shake_y * 0.5)
    draw_map(GAME.cam, shake_x, shake_y)
    draw_signs(GAME.cam, shake_x, shake_y)
    draw_mechs(GAME.cam, shake_x, shake_y)
    draw_enemies(GAME.cam, shake_x, shake_y)
    draw_player(GAME.cam, shake_x, shake_y)
    draw_bullets(GAME.cam, shake_x, shake_y)
    draw_fx(GAME.cam, shake_x, shake_y)
    draw_hud()
  end

  function draw_dead_overlay()
    print_center("PILOT DOWN", 56, 8, 2)
  end

  function draw_gameover_overlay()
    draw_overlay_box("GAME OVER", "SCORE " .. GAME.score)
    print_center("PRESS Z", 86, 10, 1)
  end

  function draw_victory_overlay()
    if GAME.victory_t > 90 then
      draw_overlay_box("MISSION COMPLETE", "SCORE " .. GAME.score)
      print_center("PRESS Z", 86, 10, 1)
    else
      print_center("TARGET DESTROYED", 62, 10, 2)
    end
  end

  -- Run Cartridge

  function init()
    math.randomseed(1234)
    init_stars()
    if CFG.use_code_art then load_sprites() end
    if CFG.generate_tiles then load_tiles() end
    GAME.t = 0
    GAME.cam = 0
    GAME.shake = 0
    GAME.msg = ""
    GAME.msg_t = 0
    GAME.score = 0
    music(MUSIC.gameplay)     -- Play music track in Title Sreen
    
    if CFG.start_title then
      GAME.state = "title"
    else
      reset_game()
    end

  end

  function TIC()
    GAME.t = GAME.t + 1  -- Timer increment
    if GAME.state == "title" then
      update_title()
      if GAME.state == "title" then draw_title() else draw_game() end
    elseif GAME.state == "play" then
      update_play()
      draw_game()
    elseif GAME.state == "dead" then
      update_dead()
      draw_game()
      draw_dead_overlay()
    elseif GAME.state == "gameover" then
      update_gameover()
      if GAME.state == "gameover" then
        draw_game()
        draw_gameover_overlay()
      else
        draw_game()
      end
    elseif GAME.state == "victory" then
      update_victory()
      if GAME.state == "victory" then
        draw_game()
        draw_victory_overlay()
      else
        draw_game()
      end
    end
  end

  init()
