  -- Local Functions

  local function clamp(v, a, b)
    if v < a then return a end
    if v > b then return b end
    return v
  end

  local function sign(v)
    if v < 0 then return -1 end
    if v > 0 then return 1 end
    return 0
  end

  local function approach(v, target, step)
    if v < target then return math.min(v + step, target) end
    return math.max(v - step, target)
  end

  local function text_w(s, scale)
    return #s * 6 * (scale or 1)
  end

  local function point_box(px, py, r, x, y, w, h)
    return px + r > x and px - r < x + w and py + r > y and py - r < y + h
  end

  local function aabb(a, b)
    return a.x < b.x + b.w and a.x + a.w > b.x and
          a.y < b.y + b.h and a.y + a.h > b.y
  end

  local function mget_safe(tx, ty)
    if tx < 0 or tx >= WORLD.level_w or ty < 0 or ty >= WORLD.level_h then
      return TILE.empty
    end
    return mget(tx, ty)
  end

  local function solid_at(tx, ty)
    return mget_safe(tx, ty) == TILE.solid
  end

  local function platform_at(tx, ty)
    return mget_safe(tx, ty) == TILE.platform
  end

  local function ladder_at(tx, ty)
    return mget_safe(tx, ty) == TILE.ladder
  end

  local function tile_at_px(px, py)
    return mget_safe(math.floor(px / 8), math.floor(py / 8))
  end

  local function line_clear(x1, y1, x2, y2)
    local dx, dy = x2 - x1, y2 - y1
    local d = math.sqrt(dx * dx + dy * dy)
    if d < 1 then return true end
    local steps = math.floor(d / 4) + 1
    for i = 1, steps - 1 do
      local t = i / steps
      if tile_at_px(x1 + dx * t, y1 + dy * t) == TILE.solid then
        return false
      end
    end
    return true
  end

